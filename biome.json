{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.github/workflows",
      "!**/node_modules",
      "!!**/dist",
      "!!**/.wrangler",
      "!!**/.turbo",
      "!!**/.cache",
      "!**/*.lock",
      "!apps/client/src/i18n/locales/*/messages.ts",
      "!apps/client/public/sql-workers/**/*.js",
      "!.agents/skills/**/assets/**",
      "!pkgs/emqx-server/src/railway/railway-graphql/schema.graphql",
      "!pkgs/emqx-server/src/railway/railway-graphql/graphql-env.d.ts",
      "!qa",
      "!!pkgs/postgres/.postgres"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!tools/**",
      "!**/.wrangler/**",
      "!**/babel.config.js",
      "!**/lingui.config.*",
      "!**/*.html",
      "!apps/client/public/sql-workers/**/*.js",
      "!.agents/skills/**/assets/**",
      "!pkgs/babel-plugins/**"
    ],
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 70,
            "skipBlankLines": true,
            "skipIifes": false
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "nursery": {
        "noExcessiveNestedCallbacks": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveClassesPerFile": {
          "level": "error",
          "options": {
            "maxClasses": 1
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {}
          }
        },
        "useConst": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true,
            "strictCase": false
          }
        },
        "useImportType": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noVar": "error"
      }
    },
    "domains": {
      "react": "none",
      "test": "none",
      "types": "none",
      "project": "none"
    }
  },
  "plugins": [
    "./tools/biome-plugins/no-aria-hidden.grit",
    "./tools/biome-plugins/no-aria-hidden-block.grit",
    "./tools/biome-plugins/no-a11y-elements-hidden.grit",
    "./tools/biome-plugins/no-a11y-elements-hidden-block.grit",
    "./tools/biome-plugins/no-a11y-important-for.grit",
    "./tools/biome-plugins/no-a11y-important-for-block.grit",
    {
      "path": "./tools/biome-plugins/text-use-label.grit",
      "includes": [
        "**/*.{ts,tsx}",
        "!**/tests/**",
        "!**/*.test.{ts,tsx}",
        "!**/src/sim/**"
