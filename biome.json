{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.github/workflows",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.wrangler",
      "!!**/.turbo",
      "!!**/.cache",
      "!**/*.lock",
      "!libs/client-app/src/i18n/locales/*/messages.ts",
      "!.superset/config.json",
      "!.super.engineering/config.json",
      "!apps/product/public/sql-workers/**/*.js",
      "!.agents/skills/**/assets",
      "!qa",
      "!!pkgs/postgres/.postgres"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!**/.wrangler/**",
      "!**/babel.config.js",
      "!**/lingui.config.*",
      "!**/*.html",
      "!apps/client/public/sql-workers/**/*.js",
      "!apps/product/public/sql-workers/**/*.js",
      "!.agents/skills/**/assets",
      "!pkgs/babel-plugins/**"
    ],
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 70,
            "skipBlankLines": true,
            "skipIifes": false
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        "noExcessiveNestedCallbacks": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveClassesPerFile": {
          "level": "error",
          "options": {
            "maxClasses": 1
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {}
          }
        },
        "useConst": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true,
            "strictCase": false
          }
        },
        "useImportType": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noVar": "error",
        "noImportCycles": "error"
      }
    },
    "domains": {
      "react": "none",
      "test": "none",
      "types": "none"
    }
  },
  "plugins": [
    "./libs/tools/biome-plugins/no-aria-hidden.grit",
    "./libs/tools/biome-plugins/no-aria-hidden-block.grit",
    "./libs/tools/biome-plugins/no-a11y-elements-hidden.grit",
    "./libs/tools/biome-plugins/no-a11y-elements-hidden-block.grit",
    "./libs/tools/biome-plugins/no-a11y-important-for.grit",
    "./libs/tools/biome-plugins/no-a11y-important-for-block.grit",
    {
      "path": "./libs/tools/biome-plugins/text-use-label.grit",
      "includes": [
        "**/*.{ts,tsx}",
        "!**/tests/**",
        "!**/*.test.{ts,tsx}",
        "!**/src/harness/**",
