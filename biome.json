{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.github/workflows",
      "!**/node_modules",
      "!!**/dist",
      "!!**/.expo",
      "!!**/.wrangler",
      "!!**/.turbo",
      "!!**/.cache",
      "!**/*.lock",
      "!apps/client/src/i18n/locales/*/messages.ts",
      "!apps/client/public/sql-workers/**/*.js",
      "!apps/client/expo-env.d.ts",
      "!libs/infra/src/cli/lib/railway-graphql/schema.graphql",
      "!libs/infra/src/cli/lib/railway-graphql/graphql-env.d.ts",
      "!qa",
      "!!pkgs/postgres/.postgres",
      "!!pkgs/postgres/.pglite"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!tools/**",
      "!**/.wrangler/**",
      "!**/.expo/**",
      "!**/metro.config.js",
      "!**/babel.config.js",
      "!**/lingui.config.*",
      "!**/*.html",
      "!apps/client/public/sql-workers/**/*.js",
      "!pkgs/babel-plugins/**"
    ],
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 70,
            "skipBlankLines": true,
            "skipIifes": false
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "nursery": {
        "noExcessiveNestedCallbacks": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noExcessiveClassesPerFile": {
          "level": "error",
          "options": {
            "maxClasses": 1
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-react-native": {
                "message": "Import icons from @pkgs/ui (e.g. SearchIcon), not lucide-react-native directly."
              }
            }
          }
        },
        "useConst": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true,
            "strictCase": false
          }
        },
        "useImportType": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noVar": "error"
      }
    },
    "domains": {
      "react": "none",
      "test": "none",
      "types": "none",
      "project": "none"
    }
  },
  "plugins": [
    "./tools/biome-plugins/no-aria-hidden.grit",
    "./tools/biome-plugins/no-aria-hidden-block.grit",
    "./tools/biome-plugins/no-a11y-elements-hidden.grit",
    "./tools/biome-plugins/no-a11y-elements-hidden-block.grit",
    "./tools/biome-plugins/no-a11y-important-for.grit",
    "./tools/biome-plugins/no-a11y-important-for-block.grit",
    {
      "path": "./tools/biome-plugins/text-use-label.grit",
      "includes": [
        "**/*.{ts,tsx}",
        "!pkgs/ui/src/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/__tests__/**",
        "!**/__fixtures__/**",
        "!**/testing/**"
      ]
    },
    {
      "path": "./tools/biome-plugins/text-must-be-trans.grit",
      "includes": [
        "apps/client/src/**/*.{ts,tsx}",
        "libs/spaces/**/*.{ts,tsx}",
        "libs/chess/**/*.{ts,tsx}",
        "libs/profile/**/*.{ts,tsx}",
        "libs/auth/**/*.{ts,tsx}",
        "libs/friends/**/*.{ts,tsx}",
        "libs/search/**/*.{ts,tsx}",
        "libs/user-search/**/*.{ts,tsx}",
        "libs/client-config/**/*.{ts,tsx}",
        "libs/notifications/**/*.{ts,tsx}",
        "pkgs/tts/**/*.{ts,tsx}",
        "pkgs/llm/**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/__tests__/**",
        "!**/__fixtures__/**",
        "!**/testing/**"
      ]
    },
    {
      "path": "./tools/biome-plugins/text-must-be-trans-children.grit",
      "includes": [
        "apps/client/src/**/*.{ts,tsx}",
        "libs/spaces/**/*.{ts,tsx}",
        "libs/chess/**/*.{ts,tsx}",
        "libs/profile/**/*.{ts,tsx}",
        "libs/auth/**/*.{ts,tsx}",
        "libs/friends/**/*.{ts,tsx}",
        "libs/search/**/*.{ts,tsx}",
        "libs/user-search/**/*.{ts,tsx}",
        "libs/client-config/**/*.{ts,tsx}",
        "libs/notifications/**/*.{ts,tsx}",
        "pkgs/tts/**/*.{ts,tsx}",
        "pkgs/llm/**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/__tests__/**",
        "!**/__fixtures__/**",
        "!**/testing/**"
      ]
    },
    {
      "path": "./tools/biome-plugins/no-nested-await.grit",
      "includes": ["apps/client/src/**/*.{ts,tsx}"]
    },
    {
      "path": "./tools/biome-plugins/no-export-star.grit",
      "includes": ["libs/notifications/**/*.{ts,tsx}"]
    },
    {
      "path": "./tools/biome-plugins/lingui-no-trans-inside-trans.grit",
      "includes": [
        "apps/client/**/*.{ts,tsx}",
        "libs/**/*.{ts,tsx}",
        "pkgs/**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/__tests__/**",
        "!**/__fixtures__/**",
        "!**/testing/**"
      ]
    },
    {
      "path": "./tools/biome-plugins/lingui-no-single-variables-to-translate.grit",
      "includes": [
        "apps/client/**/*.{ts,tsx}",
        "libs/**/*.{ts,tsx}",
        "pkgs/**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/__tests__/**",
        "!**/__fixtures__/**",
        "!**/testing/**"
      ]
    }
  ],
  "overrides": [
    {
      "includes": [
        "**/*.{test,spec}.{ts,tsx}",
        "**/__tests__/**",
        "**/__fixtures__/**",
        "**/testing/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "nursery": {
            "noExcessiveNestedCallbacks": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/client/src/providers/app-providers.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["libs/infra/src/cli/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveClassesPerFile": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "libs/stripe/scripts/**/*.ts",
        "libs/stripe/src/sync/**/*.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["pkgs/async/src/use-async.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["pkgs/chess-board/src/use-chess-game.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**",
        "**/e2e/**",
        "**/*.bench.ts",
        "**/*.bench.tsx",
        "pkgs/logger/src/**",
        "pkgs/sql-cli/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "pkgs/room-widgets/src/pages/use-room-sim.ts",
        "pkgs/chess-board/src/chess-board.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/pkgs/ui/src/components/icons/**",
        "**/src/components/icons/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lucide-react-native": {
                    "message": "Import icons from @pkgs/ui (e.g. SearchIcon), not lucide-react-native directly."
                  },
                  "expo-status-bar": {
                    "message": "Use AppStatusBar from @pkgs/ui."
                  },
                  "expo-splash-screen": {
                    "message": "Use preventSplashAutoHide or hideSplash from @pkgs/ui."
                  },
                  "expo-symbols": {
                    "message": "Import icons from @pkgs/ui (e.g. HouseIcon), not expo-symbols."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["test/ui/src/scenarios/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@pkgs/ui-testing": {
                    "message": "Scenarios must use AppDriver / openSim (see test/ui/src/setup/TESTING.md). Do not import @pkgs/ui-testing."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
