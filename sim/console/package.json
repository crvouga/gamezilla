{
  "name": "@sim/console",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx",
      "./src/sim/*/index.ts"
    ],
    "./playground/*": [
      "./src/playground/*.ts",
      "./src/playground/*.tsx",
      "./src/playground/*/index.ts"
    ],
    "./console-nav/*": [
      "./src/console-nav/*.ts",
      "./src/console-nav/*.tsx",
      "./src/console-nav/*/index.ts"
    ]
  },
  "main": "index.js",
  "scripts": {
    "prebuild": "bun run bundle:skia-canvaskit-wasm && bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client build:web-workers && cd ../.. && bun run i18n:compile",
    "build": "expo customize tsconfig.json && expo export -p web",
    "bundle:sim-sql-wasm": "bun run scripts/bundle-sim-sql-wasm.ts",
    "bundle:skia-canvaskit-wasm": "bun run scripts/bundle-skia-canvaskit-wasm.ts",
    "deploy": "bun run scripts/deploy.ts",
    "predev": "bun run bundle:skia-canvaskit-wasm && bun run bundle:sim-sql-wasm && cd ../.. && bun run i18n:compile",
    "dev": "bun run scripts/dev.ts",
    "install:deps": "CI=1 npx expo install --check || true",
    "ios": "expo start --ios",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "setup": "bun run scripts/setup-env.ts && bun run bundle:skia-canvaskit-wasm && bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client build:web-workers",
    "prestart": "bun run bundle:skia-canvaskit-wasm && bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client build:web-workers",
    "start": "expo start",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/console-nav src/reports-public-base.test.ts src/playground/playground-snapshot-prune.test.ts metro-hermes-dynamic-import-rewrite.test.cjs",
    "preweb": "bun run bundle:skia-canvaskit-wasm && bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client build:web-workers",
    "web": "expo start --web"
  },
  "dependencies": {
    "@apps/client": "workspace:*",
    "@apps/room-server": "workspace:*",
    "@apps/server": "workspace:*",
    "@expo/metro-runtime": "catalog:",
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/dst-handles": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/browser": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/dst": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/entity-store": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/minio-server": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/polyfill": "workspace:*",
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secure-storage": "workspace:*",
    "@pkgs/sim-console": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@react-navigation/native": "catalog:",
    "@shopify/react-native-skia": "catalog:",
    "better-sqlite3": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:",
    "whatwg-fetch": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-explicit-resource-management": "catalog:",
    "@babel/runtime": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@pkgs/os": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-macros": "catalog:",
    "typescript": "catalog:"
  }
}
