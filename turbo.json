{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "50%",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["SIM_FIDELITY", "POSTGRES_SCHEMA"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "VITE_*",
    "PREVIEW_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "DATABASE_URL",
    "AUTH_*",
    "LOCAL_SECRETS",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "RAILWAY_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "OPENAI_*",
    "PS_*",
    "SECRETS_*",
    "INFISICAL_*",
    "ACTIONS_ID_TOKEN_*",
    "WEB_CLIENT_*",
    "EMQX_*",
    "OBSERVABILITY_*",
    "TURBO_*",
    "SIM_FIDELITY",
    "SIM_REPORT",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.tc.json",
        "../../tsconfig.base.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "@pkgs/auth#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/clock#tc",
        "@pkgs/db-migrate#tc",
        "@pkgs/db-schema#tc",
        "@pkgs/db-schema-postgres#tc",
        "@pkgs/db-schema-sqlite#tc",
        "@pkgs/http-client#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/matchmaking#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/http-client#tc",
        "@pkgs/keyword#tc",
        "@pkgs/logger#tc"
      ]
    },
    "@pkgs/room#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/keyword#tc",
        "@pkgs/kv#tc",
        "@pkgs/message#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/sql-client-sqlite#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/clock#tc",
        "@pkgs/logger#tc",
        "@pkgs/object-store#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc"
      ]
    },
    "test": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**",
        "package.json",
        "*.cjs",
        "bun-*.ts",
        "tsconfig*.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:auth": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/auth-*.ts",
        "tests/auth-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:spaces": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/space-*.ts",
        "tests/space-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:friends": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/friends-*.ts",
        "tests/friends-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:profile": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/profile-*.ts",
        "tests/profile-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:chess": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/chess-*.ts",
        "tests/chess-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:walk": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/product-walk.test.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:topology": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/topology-*.ts",
        "tests/topology-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:max": {
      "cache": false,
      "dependsOn": ["tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tests/**", "package.json", "*.cjs"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_API_URL", "VITE_E2E", "VITE_ALLOW_PRODUCTION_API_URL"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.mts",
        "index.html",
        "public/**",
        "!public/sql-workers/**",
        "!public/generated/**",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "test:integration": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "*.cjs",
        "**/integration/**"
      ],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "test:contract": {
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.contract.test.ts",
        "package.json",
        "*.cjs",
        "tsconfig*.json",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "test:e2e": {
      "inputs": [
        "src/**",
        "e2e/**",
        "scripts/**",
        "package.json",
        "*.cjs",
        "tsconfig*.json",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "billing:check": {
      "inputs": ["src/**", "scripts/**", "package.json", "tsconfig*.json"],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "lint": {
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx,cjs}",
        "tests/**/*.{ts,tsx,js,jsx,cjs}",
        "scripts/**/*.{ts,tsx,js,cjs}",
        "package.json",
        "biome.json",
        "../../biome.json",
        "../../tools/biome-plugins/**",
        "tools/biome-plugins/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#lint:biome": {
      "inputs": [
        "biome.json",
        "tools/biome-plugins/**",
        "apps/**/*.{ts,tsx,js,jsx,cjs,mjs}",
        "libs/**/*.{ts,tsx,js,jsx,cjs,mjs}",
        "pkgs/**/*.{ts,tsx,js,jsx,cjs,mjs}",
        "tools/**/*.{ts,tsx,js,jsx,cjs,mjs}",
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "tools/package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#lint:vocab": {
      "inputs": [
        "tools/scripts/check-no-removed-auth-vocab.ts",
        "libs/auth/**/*.{ts,tsx}",
        "pkgs/auth/**/*.{ts,tsx}"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#lint:eslint": {
      "inputs": [
        "eslint.config.mjs",
        "tools/port/solid-scope.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "apps/client/src/chrome/**/*.{ts,tsx}",
        "apps/client/src/exemplars/**/*.{ts,tsx}",
        "apps/client/src/routes/**/*.{ts,tsx}",
        "apps/client/src/screens/**/*.{ts,tsx}",
        "apps/client/src/shell/**/*.{ts,tsx}",
        "apps/client/src/main.tsx",
        "apps/client/tests/**/*.{ts,tsx}",
        "apps/product/src/sim/**/*.{ts,tsx}",
        "apps/product/src/test/**/*.{ts,tsx}",
        "apps/product/tests/**/*.{ts,tsx}",
        "libs/chess/src/public/chess-main-menu-view.tsx",
        "libs/friends/src/public/**/*.{ts,tsx}",
        "libs/friends/src/root/**/*.{ts,tsx}",
        "libs/friends/src/use-cases/**/*.{ts,tsx}",
        "libs/spaces/src/public/**/*.{ts,tsx}",
        "libs/spaces/src/root/**/*.{ts,tsx}",
        "libs/spaces/src/use-cases/**/*.{ts,tsx}",
        "libs/auth/src/public/**/*.{ts,tsx}",
        "libs/auth/src/root/**/*.{ts,tsx}",
        "libs/auth/src/use-cases/**/*.{ts,tsx}",
        "libs/profile/src/public/**/*.{ts,tsx}",
        "libs/profile/src/root/**/*.{ts,tsx}",
        "libs/profile/src/use-cases/**/*.{ts,tsx}",
        "libs/notifications/src/public/**/*.{ts,tsx}",
        "libs/notifications/src/root/**/*.{ts,tsx}",
        "libs/search/src/public/**/*.{ts,tsx}",
        "libs/search/src/root/**/*.{ts,tsx}",
        "libs/user-search/src/public/**/*.{ts,tsx}",
        "libs/client-config/src/public/**/*.{ts,tsx}",
        "libs/client-config/src/root/**/*.{ts,tsx}",
        "libs/chess/src/public/**/*.{ts,tsx}",
        "libs/chess/src/root/**/*.{ts,tsx}",
        "pkgs/async/src/solid.ts",
        "pkgs/async/tests/solid.test.tsx",
        "pkgs/chess-board/src/**/*.{ts,tsx}",
        "pkgs/chess-board/tests/**/*.{ts,tsx}",
        "pkgs/clock/src/solid.tsx",
        "pkgs/clock/tests/solid.test.tsx",
        "pkgs/http-client/src/solid.tsx",
        "pkgs/http-client/tests/solid.test.tsx",
        "pkgs/kv/src/solid.tsx",
        "pkgs/kv/tests/solid-kv-state.test.tsx",
        "pkgs/llm/src/solid/**/*.{ts,tsx}",
        "pkgs/logger/src/solid.tsx",
        "pkgs/object-store/src/solid.tsx",
        "pkgs/observability/src/client/solid.tsx",
        "pkgs/room/src/client/solid/**/*.{ts,tsx}",
        "pkgs/room/src/solid.ts",
        "pkgs/room/tests/solid.test.tsx",
        "pkgs/secure-storage/src/solid.tsx",
        "pkgs/secure-storage/tests/solid.test.tsx",
        "pkgs/solid-context/src/**/*.{ts,tsx}",
        "pkgs/solid-context/tests/**/*.{ts,tsx}",
        "pkgs/sounds/src/solid.tsx",
        "pkgs/sounds/tests/solid.test.tsx",
        "pkgs/sql-client/src/solid.tsx",
        "pkgs/sync-engine/src/solid/**/*.{ts,tsx}",
        "pkgs/sync-engine/tests/solid-bindings.test.tsx",
        "pkgs/tts/src/client/solid.tsx",
        "pkgs/ui-testing-solid-dom/src/**/*.{ts,tsx}",
        "pkgs/ui-testing-solid-dom/tests/**/*.{ts,tsx}",
        "pkgs/ui/src/**/*.{ts,tsx}",
        "pkgs/ui/tests/**/*.{ts,tsx}",
        "pkgs/uuid/src/solid.tsx",
        "pkgs/vitest-solid/src/**/*.{ts,tsx}"
      ],
      "outputs": [".eslintcache"],
      "outputLogs": "new-only"
    },
    "@apps/client#check:bundle-budget": {
      "dependsOn": ["@apps/client#build"],
      "inputs": [
        "dist/.vite/manifest.json",
        "dist/assets/**/*.js",
        "dist/assets/**/*.css",
        "dist/index.html",
        "dist/sw.js",
        "perf-budget.json",
        "../../tools/scripts/bundle-budget.ts",
        "../../tools/scripts/bundle-budget-lazy.ts",
        "../../tools/scripts/bundle-budget-manifest.ts",
        "../../tools/scripts/perf-budget.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/client#check:lighthouse": {
      "dependsOn": ["@apps/client#build"],
      "cache": false,
      "env": ["CHROME_PATH", "PUPPETEER_EXECUTABLE_PATH", "GITHUB_ACTIONS"],
      "inputs": [
        "dist/**",
        "perf-budget.json",
        "../../tools/scripts/lighthouse-ci.ts",
        "../../tools/scripts/lighthouse-report.ts",
        "../../tools/scripts/lighthouse-api-stub.ts",
        "../../tools/scripts/listen-preferred-or-ephemeral.ts",
        "../../tools/scripts/perf-budget.ts"
      ],
      "outputs": [".lighthouseci/**"],
      "outputLogs": "new-only"
    },
    "@apps/client#check:critical-path": {
      "inputs": [
        "src/**/*.{ts,tsx}",
        "index.html",
        "public/**",
        "src/assets/**",
        "perf-budget.json",
        "../../tsconfig.base.json",
        "../../tools/scripts/client-critical-path-imports.ts",
        "../../tools/scripts/check-index-html-scripts.ts",
        "../../tools/scripts/check-client-image-budgets.ts",
        "../../tools/scripts/perf-budget.ts",
        "../../libs/**/*.{ts,tsx}",
        "../../pkgs/**/*.{ts,tsx}"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check": {
      "dependsOn": [
        "//#lint:biome",
        "//#lint:vocab",
        "@apps/client#check:critical-path",
        "tc",
        "test"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:full": {
      "dependsOn": [
        "//#check",
        "//#lint:eslint",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "@libs/secrets#check",
        "@apps/server#build",
        "@apps/room-server#build",
        "@pkgs/auth#test:e2e",
        "@pkgs/sql-client-sqlite-web#test:e2e",
        "@pkgs/sql-client-postgres#test:contract",
        "@pkgs/kv-postgres#test:contract",
        "@pkgs/object-store-s3#test:contract",
        "@pkgs/pubsub-emqx#test:contract",
        "@libs/billing#billing:check",
        "@tools#check:static"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@tools#install:cli": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@tools#check:static": {
      "env": [
        "GH_EVENT",
        "GITHUB_EVENT_NAME",
        "PR_BASE",
        "PR_HEAD",
        "GITLEAKS_VERSION"
      ],
      "inputs": [
        "tools/scripts/check-static.ts",
        "tools/scripts/cli-deps/**",
        ".gitleaks.toml",
        ".github/workflows/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/server#check:api": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@libs/secrets#provision": {
      "cache": false,
      "dependsOn": ["@tools#install:cli"]
    },
    "@libs/db#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/object-store#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/pubsub#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/db#migrate": {
      "cache": false,
      "dependsOn": [
        "@libs/db#provision",
        "@libs/object-store#provision",
        "@libs/pubsub#provision"
      ]
    },
    "@libs/secrets#check": {
      "env": ["CHECK_SECRETS_FINGERPRINT"],
      "inputs": [
        "libs/secrets/src/bin/check-secrets.ts",
        "libs/secrets/src/shared/secrets/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/room-server#deploy": {
      "cache": false,
      "dependsOn": ["@libs/db#migrate"]
    },
    "@apps/server#deploy": {
      "cache": false,
      "dependsOn": ["@apps/room-server#deploy"]
    },
    "@apps/product#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@libs/billing#billing:sync": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@apps/server#smoke": {
      "cache": false,
      "dependsOn": ["@apps/product#deploy", "@libs/billing#billing:sync"]
    },
    "//#deploy": {
      "cache": false,
      "dependsOn": [
        "//#lint:biome",
        "//#lint:vocab",
        "@apps/client#check:critical-path",
        "//#lint:eslint",
        "tc",
        "test",
        "@apps/server#build",
        "@apps/room-server#build",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "@pkgs/auth#test:e2e",
        "@pkgs/sql-client-sqlite-web#test:e2e",
        "@pkgs/sql-client-postgres#test:contract",
        "@pkgs/kv-postgres#test:contract",
        "@pkgs/object-store-s3#test:contract",
        "@pkgs/pubsub-emqx#test:contract",
        "@libs/billing#billing:check",
        "@tools#check:static",
        "@apps/server#check:api",
        "@apps/client#check:bundle-budget",
        "@libs/secrets#check",
        "@apps/server#smoke"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "tools/package.json",
        ".syncpackrc.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        ".dependency-cruiser.cjs",
        "tools/port/solid-scope.json",
        "tools/port/core-scope.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "inputs": ["bun.lock", "tools/scripts/ci-audit.ts", "package.json"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.ts",
        "lingui.solid.config.ts",
        "apps/*/src/**/*.{ts,tsx}",
        "libs/*/src/**/*.{ts,tsx}",
        "pkgs/*/src/**/*.{ts,tsx}",
        "apps/client/src/i18n/locales/**",
        "apps/client/babel.config.js",
        "apps/product/babel.test.config.cjs",
        "tools/scripts/ci-i18n.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    }
  }
}
