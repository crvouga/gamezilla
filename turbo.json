{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "50%",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "VITE_*",
    "PREVIEW_PORT",
    "API_NODE_*",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "LOCALHOST_STACK",
    "DATABASE_URL",
    "AUTH_*",
    "LOCAL_SECRETS",
    "PADDLE_*",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "RAILWAY_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "PS_*",
    "SECRETS_*",
    "INFISICAL_*",
    "ACTIONS_ID_TOKEN_*",
    "GOOGLE_IDP_ORIGIN",
    "APPLE_*",
    "WEB_CLIENT_*",
    "EMQX_*",
    "WEB_CLIENT_ORIGIN",
    "GRAFANA_*",
    "OBSERVABILITY_*",
    "OBS_*",
    "TURBO_*",
    "IDP_*",
    "TMPDIR"
  ],
  "tasks": {
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/pkgs/ts-reset/src/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@pkgs/auth#tc": {
      "dependsOn": [
        "@pkgs/clock#tc",
        "@pkgs/db-migrate#tc",
        "@pkgs/http-client#tc",
        "@pkgs/sql-client#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/auth-inhouse#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/auth#tc",
        "@pkgs/clock#tc",
        "@pkgs/db-migrate#tc",
        "@pkgs/db-schema#tc",
        "@pkgs/db-schema-postgres#tc",
        "@pkgs/db-schema-sqlite#tc",
        "@pkgs/http-client#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/matchmaking#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/http-client#tc",
        "@pkgs/keyword#tc",
        "@pkgs/logger#tc"
      ]
    },
    "@pkgs/room#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/keyword#tc",
        "@pkgs/kv#tc",
        "@pkgs/message#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/sql-client-sqlite#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/clock#tc",
        "@pkgs/logger#tc",
        "@pkgs/object-store#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc"
      ]
    },
    "lint": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/libs/tools/biome-plugins/**",
        "$TURBO_ROOT$/oxlint.config.mts",
        "$TURBO_ROOT$/components.json",
        "$TURBO_ROOT$/pkgs/tailwind/src/lint.css",
        "$TURBO_ROOT$/pkgs/tailwind/src/tailwind.css",
        "$TURBO_ROOT$/pkgs/ui/codemod/theme.css",
        "$TURBO_ROOT$/pkgs/ui/src/components/hosts.css",
        "$TURBO_ROOT$/libs/tools/port/*.json",
        "$TURBO_ROOT$/libs/tools/scripts/lint-package.ts",
        "$TURBO_ROOT$/libs/tools/scripts/package-boundaries.ts",
        "$TURBO_ROOT$/libs/tools/scripts/tc-scope.ts",
        "$TURBO_ROOT$/libs/tools/scripts/test-scripts.ts",
        "$TURBO_ROOT$/libs/tools/scripts/unused-dependencies.ts",
        "$TURBO_ROOT$/libs/tools/scripts/lingui-scope.ts",
        "$TURBO_ROOT$/libs/tools/naming/**",
        "$TURBO_ROOT$/libs/tools/goal/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["tc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": ["SIM_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["SIM_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["tc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "SIM_MODE",
        "SIM_WITH_DOM",
        "SIM_REPORT",
        "SIM_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/sim-report/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_API_URL", "VITE_E2E", "VITE_ALLOW_PRODUCTION_API_URL"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.mts",
        "index.html",
        "public/**",
        "!public/sql-workers/**",
        "!public/generated/**",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js"
      ],
      "outputLogs": "errors-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "//#lint:root": {
      "dependsOn": ["@libs/tools#tc"],
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!libs/**", "!pkgs/**"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "libs/tools/package.json",
        ".syncpackrc.cjs"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:audit": {
      "inputs": ["bun.lock", "libs/tools/scripts/ci-audit.ts", "package.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.ts",
        "lingui.solid.config.ts",
        "libs/auth/src/**/*.{ts,tsx}",
        "libs/billing/src/**/*.{ts,tsx}",
        "libs/chess/src/**/*.{ts,tsx}",
        "libs/client-app/src/**/*.{ts,tsx}",
        "libs/client-config/src/**/*.{ts,tsx}",
        "libs/friends/src/**/*.{ts,tsx}",
        "libs/notifications/src/**/*.{ts,tsx}",
        "libs/permissions/src/**/*.{ts,tsx}",
        "libs/profile/src/**/*.{ts,tsx}",
        "libs/search/src/**/*.{ts,tsx}",
        "libs/spaces/src/**/*.{ts,tsx}",
        "libs/user-search/src/**/*.{ts,tsx}",
        "pkgs/chess-board/src/**/*.{ts,tsx}",
        "pkgs/ui/src/**/*.{ts,tsx}",
        "pkgs/ui-devtools/src/**/*.{ts,tsx}",
        "libs/client-app/src/i18n/locales/**",
        "apps/client/babel.config.js",
        "pkgs/bun-test-solid/src/babel.config.cjs",
        "libs/tools/scripts/ci-i18n.ts",
        "libs/tools/scripts/lingui-scope.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:agent-commands": {
      "inputs": [
        ".agents/**",
        ".claude/commands",
        ".cursor/commands",
        ".opencode/commands",
        ".gemini/commands/**",
        ".github/prompts/**",
        ".windsurf/workflows/**",
        "libs/tools/scripts/sync-agent-commands.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:goals": {
      "dependsOn": ["@libs/tools#tc"],
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!libs/**", "!pkgs/**"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@apps/client#check:bundle-budget": {
      "dependsOn": ["@apps/client#build"],
      "inputs": [
        "dist/.vite/manifest.json",
        "dist/assets/**/*.js",
        "dist/assets/**/*.css",
        "dist/index.html",
        "perf-budget.json",
        "scripts/bundle-budget.ts",
        "scripts/bundle-budget-lazy.ts",
        "scripts/bundle-budget-manifest.ts",
        "scripts/perf-budget.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "check:worker-bundle": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/tools/scripts/check-worker-bundle.ts",
        "$TURBO_ROOT$/libs/tools/scripts/worker-compat-date.ts"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@apps/product#check:offline-shell": {
      "dependsOn": ["@apps/product#build"],
      "inputs": [
        "dist/**",
        "!dist/**/*.map",
        "scripts/check-offline-shell.ts",
        "scripts/dist-graph.ts",
        "scripts/sw-policy.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@libs/runtime#check:schema-evolution": {
      "dependsOn": ["tc"],
      "env": ["PR_BASE"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@libs/tools#check:static": {
      "env": [
        "CHECK_GIT_HEAD",
        "GH_EVENT",
        "GITHUB_EVENT_NAME",
        "PR_BASE",
        "PR_HEAD",
        "GITLEAKS_VERSION"
      ],
      "inputs": [
        "scripts/check-static.ts",
        "scripts/cli-deps/**",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/.github/workflows/**"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@libs/tools#install:cli": {
      "cache": false,
      "outputLogs": "errors-only"
    },
    "//#check": {
      "dependsOn": [
        "//#lint:root",
        "//#ci:syncpack",
        "//#ci:audit",
        "//#ci:i18n",
        "//#ci:agent-commands",
        "//#ci:goals",
        "tc",
        "lint",
        "test",
        "test:contract",
        "test:e2e",
        "@apps/client#check:bundle-budget",
        "@apps/product#check:offline-shell",
        "@apps/room-server#check:worker-bundle",
        "@apps/server#check:worker-bundle",
        "@libs/runtime#check:schema-evolution",
        "@libs/tools#check:static"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@apps/server#check:api": {
      "cache": false,
      "outputLogs": "errors-only"
    },
    "@libs/secrets#provision": {
      "cache": false,
      "dependsOn": ["@libs/tools#install:cli"]
    },
    "@libs/db#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/object-store#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/pubsub#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/observability#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/runtime#migrate": {
      "cache": false,
      "dependsOn": [
        "@libs/db#provision",
        "@libs/object-store#provision",
        "@libs/observability#provision",
        "@libs/pubsub#provision"
      ]
    },
    "@apps/room-server#deploy": {
      "cache": false,
      "dependsOn": ["@libs/runtime#migrate"]
    },
    "@apps/server#deploy": {
      "cache": false,
      "dependsOn": ["@apps/room-server#deploy"]
    },
    "@apps/product#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@libs/billing#billing:sync": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "health": {
      "cache": false,
      "dependsOn": ["@apps/product#deploy", "@libs/billing#billing:sync"],
      "outputLogs": "errors-only"
    },
    "//#deploy": {
      "cache": false,
      "dependsOn": ["//#check", "@apps/server#check:api", "health"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@libs/tools#test": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/.github/workflows/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    }
  }
}
