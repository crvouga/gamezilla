    },
    "//#ci:specs": {
      "dependsOn": ["@libs/tools#tc", "@pkgs/gherkin#tc", "@pkgs/quint#tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/**",
        "!libs/**",
        "!pkgs/**",
        "specs/**",
        "apps/**/*.feature",
        "apps/**/*.qnt",
        "libs/**/*.feature",
        "libs/**/*.qnt",
        "pkgs/**/*.feature",
        "pkgs/**/*.qnt",
        "libs/*/package.json",
        "libs/*/turbo.json",
        "libs/*/tests/steps/**",
        "libs/*/tests/quint/**",
        "libs/*/tests/dmn/**",
        "libs/*/tests/alloy/**",
        "libs/*/tests/openslo/**",
        "libs/*/STEPS_CATALOG.md",
        "pkgs/*/package.json",
        "pkgs/*/turbo.json",
        "pkgs/*/tests/steps/**",
        "pkgs/*/tests/quint/**",
        "pkgs/*/tests/dmn/**",
        "pkgs/*/tests/alloy/**",
        "pkgs/*/tests/openslo/**",
        "pkgs/*/STEPS_CATALOG.md",
        "apps/*/package.json",
        "apps/*/turbo.json",
        "apps/*/tests/steps/**",
        "apps/*/tests/quint/**",
        "apps/*/tests/dmn/**",
        "apps/*/tests/alloy/**",
        "apps/*/tests/openslo/**",
        "apps/*/STEPS_CATALOG.md",
        "libs/harness/src/spec/**",
        "pkgs/gherkin/src/**",
        "pkgs/quint/src/names.ts",
        "libs/tools/scripts/check-specs.ts",
        "libs/tools/scripts/spec-alloy-names.ts",
        "libs/tools/scripts/spec-decoupling.ts",
        "libs/tools/scripts/spec-glossary.ts",
        "libs/tools/scripts/spec-kinds.ts",
        "libs/tools/scripts/spec-location.ts",
        "libs/tools/scripts/spec-catalog.ts",
        "libs/tools/scripts/spec-packages.ts",
        "libs/tools/goal/**"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
