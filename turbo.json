{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "100%",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "PREVIEW_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "DATABASE_URL",
    "AUTH_*",
    "LOCAL_SECRETS",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "RAILWAY_*",
    "B2_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "OPENAI_*",
    "PS_*",
    "EXPO_TOKEN",
    "EXPO_USE_WATCHMAN",
    "SECRETS_*",
    "INFISICAL_*",
    "ACTIONS_ID_TOKEN_*",
    "WEB_CLIENT_*",
    "EMQX_*",
    "OBSERVABILITY_*",
    "TURBO_*",
    "SIM_FIDELITY",
    "SIM_REPORT",
    "PLAYWRIGHT_BASE_URL",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.tc.json",
        "../../tsconfig.base.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "@pkgs/auth#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/clock#tc",
        "@pkgs/db-migrate#tc",
        "@pkgs/db-schema#tc",
        "@pkgs/db-schema-postgres#tc",
        "@pkgs/db-schema-sqlite#tc",
        "@pkgs/http-client#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/matchmaking#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/http-client#tc",
        "@pkgs/keyword#tc",
        "@pkgs/logger#tc"
      ]
    },
    "@pkgs/room#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/attribute#tc",
        "@pkgs/clock#tc",
        "@pkgs/keyword#tc",
        "@pkgs/kv#tc",
        "@pkgs/message#tc",
        "@pkgs/uuid#tc"
      ]
    },
    "@pkgs/sql-client-sqlite#tc": {
      "dependsOn": [
        "@pkgs/assert#tc",
        "@pkgs/clock#tc",
        "@pkgs/logger#tc",
        "@pkgs/object-store#tc",
        "@pkgs/sql#tc",
        "@pkgs/sql-client#tc"
      ]
    },
    "test": {
      "dependsOn": ["tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tests/**", "package.json", "*.cjs"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:auth": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/auth-*.ts",
        "tests/auth-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:spaces": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/space-*.ts",
        "tests/space-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:friends": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/friends-*.ts",
        "tests/friends-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:profile": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/profile-*.ts",
        "tests/profile-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:chess": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/chess-*.ts",
        "tests/chess-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:walk": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/product-walk.test.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:topology": {
      "dependsOn": ["tc"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/topology-*.ts",
        "tests/topology-*.tsx",
        "package.json",
        "*.cjs",
        "bun-*.ts"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:max": {
      "cache": false,
      "dependsOn": ["tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tests/**", "package.json", "*.cjs"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_E2E",
        "EXPO_PUBLIC_ALLOW_PRODUCTION_API_URL"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.mts",
        "index.html",
        "public/**",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "test:integration": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "*.cjs",
        "**/integration/**"
      ],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "test:contract": {
      "inputs": ["**/*.ts", "**/*.tsx", "package.json", "*.cjs"],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "test:e2e": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mjs",
        "package.json",
        "e2e/**",
        "*.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "billing:check": {
      "inputs": ["**/*.ts", "**/*.tsx", "package.json", "scripts/**"],
      "outputLogs": "new-only",
      "outputs": [],
      "dependsOn": ["tc"]
    },
    "lint": {
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx,cjs}",
        "tests/**/*.{ts,tsx,js,jsx,cjs}",
        "scripts/**/*.{ts,tsx,js,cjs}",
        "package.json",
        "biome.json",
        "../../biome.json",
        "../../tools/biome-plugins/**",
        "tools/biome-plugins/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#lint:vocab": {
      "inputs": [
        "tools/scripts/check-no-removed-auth-vocab.ts",
        "libs/auth/**/*.{ts,tsx}",
        "pkgs/auth/**/*.{ts,tsx}"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#lint:eslint": {
      "inputs": [
        "eslint.config.mjs",
        "tools/port/solid-scope.json",
        "tsconfig.base.json",
        "apps/**/*.{ts,tsx}",
        "apps/*/tsconfig.json",
        "libs/**/*.{ts,tsx}",
        "pkgs/**/*.{ts,tsx}",
        "product/**/*.{ts,tsx}"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:purge-scan": {
      "inputs": [
        "tools/scripts/purge-scan.ts",
        "tools/port/**",
        "apps/**",
        "libs/**",
        "pkgs/**",
        "product/**",
        "tools/**",
        "docs/**",
        "*.json",
        "*.jsonc",
        "*.md",
        "*.cjs",
        "*.mjs",
        "*.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/client#check:bundle-budget": {
      "dependsOn": ["@apps/client#build"],
      "inputs": ["../../tools/scripts/bundle-budget.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check": {
      "dependsOn": [
        "lint",
        "//#lint:vocab",
        "//#lint:eslint",
        "//#ci:purge-scan",
        "tc",
        "test"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:full": {
      "dependsOn": [
        "//#check",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "@libs/secrets#check",
        "@apps/server#build",
        "@apps/room-server#build",
        "test:contract",
        "test:e2e",
        "@libs/billing#billing:check",
        "@tools#check:static",
        "@apps/server#check:api",
        "@apps/client#check:bundle-budget"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@tools#install:cli": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@tools#check:static": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@apps/server#check:api": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@libs/secrets#provision": {
      "cache": false,
      "dependsOn": ["@tools#install:cli"]
    },
    "@libs/db#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/object-store#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/pubsub#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/db#migrate": {
      "cache": false,
      "dependsOn": [
        "@libs/db#provision",
        "@libs/object-store#provision",
        "@libs/pubsub#provision"
      ]
    },
    "@libs/secrets#check": {
      "env": ["CHECK_SECRETS_FINGERPRINT"],
      "inputs": [
        "libs/secrets/src/bin/check-secrets.ts",
        "libs/secrets/src/shared/secrets/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/room-server#deploy": {
      "cache": false,
      "dependsOn": ["@libs/db#migrate"]
    },
    "@apps/server#deploy": {
      "cache": false,
      "dependsOn": ["@apps/room-server#deploy"]
    },
    "@apps/client#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@product/console#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@libs/billing#billing:sync": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@apps/server#smoke": {
      "cache": false,
      "dependsOn": [
        "@apps/client#deploy",
        "@product/console#deploy",
        "@libs/billing#billing:sync"
      ]
    },
    "deploy": {
      "cache": false,
      "dependsOn": [
        "lint",
        "//#lint:vocab",
        "tc",
        "test",
        "@apps/server#build",
        "@apps/room-server#build",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "test:contract",
        "test:e2e",
        "@libs/billing#billing:check",
        "@tools#check:static",
        "@apps/server#check:api",
        "@apps/client#check:bundle-budget",
        "//#lint:eslint",
        "//#ci:purge-scan",
        "@libs/secrets#check",
        "@tools#install:cli",
        "@libs/billing#billing:sync"
      ]
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "product/*/package.json",
        "tools/package.json",
        ".syncpackrc.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "product/**/*.ts",
        "product/**/*.tsx",
        ".dependency-cruiser.cjs",
        "tools/port/solid-scope.json",
        "tools/port/core-scope.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "inputs": ["bun.lock", "tools/scripts/ci-audit.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.ts",
        "lingui.solid.config.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "product/**/*.ts",
        "product/**/*.tsx",
        "apps/client/src/i18n/locales/**",
        "apps/client/babel.config.js",
        "product/console/babel.config.js",
        "product/test/babel.test.config.cjs",
        "tools/scripts/ci-i18n.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:static": {
      "cache": false,
      "outputLogs": "new-only"
    }
  }
}
