{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AWS_ACCESS_KEY_ID",
    "AWS_DEFAULT_REGION",
    "AWS_REGION",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "GITHUB_ACTIONS",
    "GITHUB_STEP_SUMMARY"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:req-res": {
      "dependsOn": ["@gamezilla/local#up"],
      "persistent": true,
      "cache": false
    },
    "dev:worker": {
      "dependsOn": ["@gamezilla/local#up"],
      "persistent": true,
      "cache": false
    },
    "check": {
      "dependsOn": ["tc", "lint", "test"]
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "../../tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "eslint.config.js"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.css", "**/*.html", "vite.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "deploy:prechecks": {
      "cache": false
    },
    "deploy:postchecks": {
      "cache": false
    },
    "deploy:summary": {
      "cache": false
    }
  }
}
