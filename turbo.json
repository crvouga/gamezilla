{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "10",
  "globalDependencies": ["bun.lock", "tsconfig.json", "package.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "PREVIEW_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "DATABASE_URL",
    "AUTH_*",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "OPENAI_*",
    "PS_*",
    "EXPO_TOKEN",
    "EXPO_USE_WATCHMAN",
    "SECRETS_ENV",
    "SECRETS_PROJECT_ID",
    "SECRETS_ADDR",
    "SECRETS_TOKEN",
    "TURBO_*",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "../../tsconfig.json"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "eslint.config.js"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.ts",
        "tsconfig.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts", "**/integration/**"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^tc"],
      "cache": false,
      "outputs": ["../../qa/playwright-report/**", "../../qa/test-results/**"]
    },
    "//#ci:format": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        ".syncpackrc.cjs",
        "scripts/check-catalog-deps.ts",
        "scripts/check-no-patches.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        ".dependency-cruiser.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:circular-deps": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "scripts/check-circular-deps.ts",
        "scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-direct-pg-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "scripts/check-no-direct-pg-imports.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:database-url-policy": {
      "inputs": [
        "apps/api/scripts/setup-dev-vars.ts",
        "apps/api/scripts/migrate-db.ts",
        "apps/api/src/app/request-db-middleware.ts",
        "libs/stripe/src/script-runtime.ts",
        "libs/chess/src/server/seed-chess-puzzle/chess-puzzle-seeder.ts",
        "libs/integration-test/src/preview-stack-env.ts",
        "scripts/check-database-url-policy.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:tier-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "apps/**/*.mts",
        "apps/**/*.cts",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "libs/**/*.mts",
        "libs/**/*.cts",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "pkgs/**/*.mts",
        "pkgs/**/*.cts",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "scripts/check-tier-imports.ts",
        "scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-provider-leaks": {
      "inputs": ["scripts/check-no-provider-leaks.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "cache": false
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.cjs",
        "apps/client/src/**/*.ts",
        "apps/client/src/**/*.tsx",
        "pkgs/ui/src/**/*.ts",
        "pkgs/ui/src/**/*.tsx",
        "pkgs/chess-board/src/**/*.ts",
        "pkgs/chess-board/src/**/*.tsx",
        "pkgs/room-widgets/src/**/*.ts",
        "pkgs/room-widgets/src/**/*.tsx",
        "libs/chess/src/**/*.ts",
        "libs/chess/src/**/*.tsx",
        "libs/profile/src/**/*.ts",
        "libs/profile/src/**/*.tsx",
        "libs/auth/src/**/*.ts",
        "libs/auth/src/**/*.tsx",
        "libs/spaces/src/**/*.ts",
        "libs/spaces/src/**/*.tsx",
        "pkgs/llm/src/**/*.ts",
        "pkgs/llm/src/**/*.tsx",
        "pkgs/tts/src/**/*.ts",
        "pkgs/tts/src/**/*.tsx",
        "libs/client-config/src/**/*.ts",
        "libs/client-config/src/**/*.tsx",
        "apps/client/src/i18n/**"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": false
    }
  }
}
