{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "10",
  "globalDependencies": ["bun.lock", "tsconfig.json", "package.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "BETTER_AUTH_PREVIEW_API_URL",
    "LOCAL_PREVIEW_API_PROXY_TARGET",
    "PREVIEW_PORT",
    "DEV_IDP_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "DATABASE_URL",
    "VAULT_TOKEN",
    "VAULT_CONFIG",
    "VAULT_PROJECT",
    "VAULT_ENVIRONMENT",
    "TURBO_*",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "../../tsconfig.json"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "eslint.config.js"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.ts",
        "tsconfig.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "qa": {
      "cache": false
    },
    "//#ci:format": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        ".syncpackrc.cjs",
        "scripts/check-catalog-deps.ts",
        "scripts/check-no-patches.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        ".dependency-cruiser.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:circular-deps": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "scripts/check-circular-deps.ts",
        "scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-direct-pg-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "scripts/check-no-direct-pg-imports.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:database-url-policy": {
      "inputs": [
        "apps/api/scripts/setup-dev-vars.ts",
        "apps/api/scripts/migrate-db.ts",
        "apps/api/src/app/request-db-middleware.ts",
        "libs/stripe/src/script-runtime.ts",
        "libs/chess/src/server/seed-chess-puzzle/chess-puzzle-seeder.ts",
        "pkgs/dev-idp/src/dev-server.ts",
        "libs/qa/src/constants/preview-stack-env.ts",
        "scripts/check-database-url-policy.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:tier-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "apps/**/*.mts",
        "apps/**/*.cts",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "libs/**/*.mts",
        "libs/**/*.cts",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "pkgs/**/*.mts",
        "pkgs/**/*.cts",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "scripts/check-tier-imports.ts",
        "scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:expo-go": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "bun.lock",
        "scripts/check-expo-go-compat.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "ci:expo-go-deps": {
      "dependsOn": ["setup"],
      "inputs": ["package.json", "../../bun.lock"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "cache": false
    },
    "//#ci:i18n": {
      "cache": false
    }
  }
}
