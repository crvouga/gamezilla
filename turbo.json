{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "10",
  "globalDependencies": ["bun.lock", "tsconfig.json", "package.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "PREVIEW_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "DATABASE_URL",
    "AUTH_*",
    "BETTER_AUTH_*",
    "LOCAL_SECRETS",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "B2_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "OPENAI_*",
    "PS_*",
    "EXPO_TOKEN",
    "EXPO_USE_WATCHMAN",
    "SECRETS_ENV",
    "SECRETS_PROJECT_ID",
    "SECRETS_ADDR",
    "SECRETS_TOKEN",
    "TURBO_*",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "tsconfig.tc.json",
        "../../tsconfig.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_E2E",
        "EXPO_PUBLIC_ALLOW_PRODUCTION_API_URL"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts", "**/integration/**"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "//#ci:lint": {
      "inputs": ["$TURBO_DEFAULT$", "biome.json", "tools/biome-plugins/**"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:format": {
      "inputs": ["$TURBO_DEFAULT$", "biome.json", "tools/biome-plugins/**"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-size-limit-overrides": {
      "inputs": [
        "biome.json",
        "apps/**/*.{ts,tsx,js,jsx}",
        "libs/**/*.{ts,tsx,js,jsx}",
        "pkgs/**/*.{ts,tsx,js,jsx}",
        "tools/scripts/check-no-size-limit-overrides.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        ".syncpackrc.cjs",
        "tools/scripts/check-catalog-deps.ts",
        "tools/scripts/check-no-patches.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        ".dependency-cruiser.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:circular-deps": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "tools/scripts/check-circular-deps.ts",
        "tools/scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-direct-pg-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "tools/scripts/check-no-direct-pg-imports.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:database-url-policy": {
      "inputs": [
        "apps/api/scripts/setup-dev-vars.ts",
        "apps/api/src/db/migrate.ts",
        "apps/api/src/app/request-db-middleware.ts",
        "libs/stripe/src/script-runtime.ts",
        "libs/chess/src/server/seed-chess-puzzle/chess-puzzle-seeder.ts",
        "tools/scripts/check-database-url-policy.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:local-dev-self-contained": {
      "inputs": [
        "apps/api/scripts/setup-dev-vars.ts",
        "apps/api/scripts/dev-vars.ts",
        "apps/client/scripts/setup-env.ts",
        "tools/scripts/check-local-dev-self-contained.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:tier-imports": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "apps/**/*.mts",
        "apps/**/*.cts",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "libs/**/*.mts",
        "libs/**/*.cts",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "pkgs/**/*.mts",
        "pkgs/**/*.cts",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "tools/scripts/check-tier-imports.ts",
        "tools/scripts/workspace-package-import-graph.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:component-ids": {
      "inputs": [
        "pkgs/ui/src/components/**/*.ts",
        "pkgs/ui/src/components/**/*.tsx",
        "pkgs/ui/src/component-id/**/*.ts",
        "tools/scripts/check-component-ids.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-local-tables": {
      "inputs": [
        "libs/db/src/shared/**/*.ts",
        "pkgs/sync-engine/src/shared/assert-domain-tables.ts",
        "pkgs/sync-engine/src/shared/framework-server-ddl.ts",
        "tools/scripts/check-local-table-categories.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-legacy-writes": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "pkgs/**/*.js",
        "pkgs/**/*.cjs",
        "pkgs/**/*.mjs",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "tools/scripts/check-no-legacy-writes.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-domain-hard-delete": {
      "inputs": [
        "libs/**/shared/mutations/**/*.ts",
        "libs/**/shared/mutations/**/*.tsx",
        "libs/**/shared/**/*-sql/**/*.ts",
        "libs/friends/src/server/friend-repository.ts",
        "libs/friends/src/server/block-service.ts",
        "tools/scripts/check-no-domain-hard-delete.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:fanout-rows-from-reads": {
      "inputs": [
        "pkgs/sync-engine/src/server/**/*.ts",
        "pkgs/sync-engine/src/sim/server-handlers.ts",
        "tools/scripts/check-fanout-rows-from-reads.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:mutation-determinism": {
      "inputs": [
        "libs/**/mutations/**/*.ts",
        "libs/**/mutations/**/*.tsx",
        "pkgs/**/mutations/**/*.ts",
        "pkgs/**/mutations/**/*.tsx",
        "tools/scripts/check-mutation-determinism.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:channel-exhaustiveness": {
      "inputs": [
        "apps/api/src/sync/app-mutations.ts",
        "apps/api/src/sync/app-queries.ts",
        "libs/**/mutations/**/*.ts",
        "libs/**/queries/**/*.ts",
        "pkgs/**/mutations/**/*.ts",
        "pkgs/**/queries/**/*.ts",
        "pkgs/sync-engine/src/shared/channel-exhaustiveness.ts",
        "tools/scripts/check-channel-exhaustiveness.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sync-engine-terminology": {
      "inputs": [
        "pkgs/sync-engine/**",
        "apps/client/src/sync/**",
        "apps/api/src/sync/**",
        "libs/**/shared/mutations/**",
        "libs/db/src/shared/sync-topics.ts",
        "AGENTS.md",
        "tools/scripts/check-sync-engine-terminology.ts",
        "tools/scripts/check-no-domain-hard-delete.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sync-engine-blackbox-tests": {
      "inputs": [
        "pkgs/sync-engine/**/*.test.ts",
        "pkgs/sync-engine/src/tests/**",
        "tools/scripts/check-sync-engine-blackbox-tests.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sync-engine-framework-leak": {
      "inputs": [
        "apps/**/*.{ts,tsx}",
        "libs/**/*.{ts,tsx}",
        "pkgs/inbox/**/*.{ts,tsx}",
        "tools/scripts/check-sync-engine-framework-leak.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sync-engine-protocol-freeze": {
      "inputs": [
        "pkgs/sync-engine/src/protocol/v1.ts",
        "pkgs/sync-engine/api-reports/protocol-v1.sha256",
        "tools/scripts/check-sync-engine-protocol-freeze.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sync-engine-public-api": {
      "inputs": [
        "pkgs/sync-engine/src/client/index.ts",
        "pkgs/sync-engine/src/server/index.ts",
        "pkgs/sync-engine/src/shared/index.ts",
        "pkgs/sync-engine/src/test/index.ts",
        "pkgs/sync-engine/api-reports/**",
        "tools/scripts/check-sync-engine-public-api.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-provider-leaks": {
      "inputs": [
        "tools/scripts/check-no-provider-leaks.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-bare-io": {
      "inputs": [
        "tools/scripts/check-no-bare-io.ts",
        "tools/scripts/io-scan-roots.ts",
        "tools/scripts/io-scan-pragma.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:hard-determinism": {
      "inputs": [
        "tools/scripts/check-hard-determinism.ts",
        "libs/**/src/shared/**/*.ts",
        "libs/**/src/shared/**/*.tsx",
        "pkgs/sync-engine/src/mutations/**/*.ts",
        "pkgs/sync-engine/src/client/**/*.ts",
        "pkgs/sync-engine/src/sim/**/*.ts",
        "pkgs/room/src/client/core/**/*.ts",
        "pkgs/room/src/server/core/**/*.ts",
        "pkgs/room/src/types.ts",
        "pkgs/room/src/hash-room-state.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:sim-determinism": {
      "inputs": [
        "tools/scripts/run-sim-determinism.ts",
        "libs/**/*.sim.test.ts",
        "pkgs/**/*.sim.test.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-resolve-wall-defaults": {
      "inputs": [
        "tools/scripts/check-no-resolve-wall-defaults.ts",
        "tools/scripts/io-scan-roots.ts",
        "tools/scripts/io-scan-pragma.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:no-sql-wall-io": {
      "inputs": [
        "tools/scripts/check-no-sql-wall-io.ts",
        "tools/scripts/io-scan-roots.ts",
        "tools/scripts/io-scan-pragma.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "apps/**/*.sql",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "libs/**/*.sql",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "pkgs/**/*.sql"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:pubsub-emqx-imports": {
      "inputs": [
        "tools/scripts/check-pubsub-emqx-imports.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "cache": false
    },
    "//#check:static": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "//#check:secrets:validate": {
      "env": ["CHECK_SECRETS_FINGERPRINT"],
      "inputs": [
        "libs/infra/src/bin/check-secrets.ts",
        "libs/infra/src/cli/secrets/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:api": {
      "cache": false
    }
  }
}
