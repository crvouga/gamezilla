        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "apps/*/tests/steps/**",
        "libs/*/tests/steps/**",
        "pkgs/*/tests/steps/**",
        "apps/*/tests/quint/**",
        "libs/*/tests/quint/**",
