    "//#ci:conformance": {
      "dependsOn": ["@libs/tools#tc", "@pkgs/conformance#tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/**",
        "!libs/**",
        "!pkgs/**",
        "specs/**",
