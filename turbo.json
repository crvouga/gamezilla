{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "50%",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "FEEDBACK_*",
    "POST_DEPLOY_*",
    "VITE_*",
    "PREVIEW_PORT",
    "API_NODE_*",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "LOCALHOST_STACK",
    "DATABASE_URL",
    "HYPERDRIVE_ID",
    "AUTH_*",
    "LOCAL_SECRETS",
    "PADDLE_*",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "PLANETSCALE_*",
    "AWS_ACCOUNT_*",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_ROLE_ARN",
    "IOT_*",
    "S3_*",
    "REPORTS_*",
    "ELEVEN_LABS_*",
    "PS_*",
    "SECRETS_*",
    "INFISICAL_*",
    "ACTIONS_ID_TOKEN_*",
    "GOOGLE_IDP_ORIGIN",
    "APPLE_*",
    "WEB_CLIENT_*",
    "EMQX_*",
    "MISE_*",
    "WEB_CLIENT_ORIGIN",
    "GRAFANA_*",
    "OBSERVABILITY_*",
    "OBS_*",
    "TURBO_*",
    "TOFU_*",
    "SYNTHETIC_MONITOR_TOKEN",
    "TMPDIR"
  ],
  "tasks": {
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "src": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "$TURBO_ROOT$/pkgs/ts-reset/src/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "tc": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/pkgs/ts-reset/src/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@pkgs/auth#src": {
      "dependsOn": [
        "@pkgs/clock#src",
        "@pkgs/db-migrate#src",
        "@pkgs/http-client#src",
        "@pkgs/sql-client#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/auth#tc": {
      "dependsOn": [
        "@pkgs/clock#src",
        "@pkgs/db-migrate#src",
        "@pkgs/http-client#src",
        "@pkgs/sql-client#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/auth-inhouse#src": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/auth#src",
        "@pkgs/clock#src",
        "@pkgs/db-migrate#src",
        "@pkgs/db-schema#src",
        "@pkgs/db-schema-postgres#src",
        "@pkgs/db-schema-sqlite#src",
        "@pkgs/http-client#src",
        "@pkgs/sql#src",
        "@pkgs/sql-client#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/auth-inhouse#tc": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/auth#src",
        "@pkgs/clock#src",
        "@pkgs/db-migrate#src",
        "@pkgs/db-schema#src",
        "@pkgs/db-schema-postgres#src",
        "@pkgs/db-schema-sqlite#src",
        "@pkgs/http-client#src",
        "@pkgs/sql#src",
        "@pkgs/sql-client#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/matchmaking#src": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/attribute#src",
        "@pkgs/clock#src",
        "@pkgs/http-client#src",
        "@pkgs/keyword#src",
        "@pkgs/logger#src"
      ]
    },
    "@pkgs/matchmaking#tc": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/attribute#src",
        "@pkgs/clock#src",
        "@pkgs/http-client#src",
        "@pkgs/keyword#src",
        "@pkgs/logger#src"
      ]
    },
    "@pkgs/room#src": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/attribute#src",
        "@pkgs/clock#src",
        "@pkgs/keyword#src",
        "@pkgs/kv#src",
        "@pkgs/message#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/room#tc": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/attribute#src",
        "@pkgs/clock#src",
        "@pkgs/keyword#src",
        "@pkgs/kv#src",
        "@pkgs/message#src",
        "@pkgs/uuid#src"
      ]
    },
    "@pkgs/sql-client-sqlite#src": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/clock#src",
        "@pkgs/logger#src",
        "@pkgs/object-store#src",
        "@pkgs/sql#src",
        "@pkgs/sql-client#src"
      ]
    },
    "@pkgs/sql-client-sqlite#tc": {
      "dependsOn": [
        "@pkgs/assert#src",
        "@pkgs/clock#src",
        "@pkgs/logger#src",
        "@pkgs/object-store#src",
        "@pkgs/sql#src",
        "@pkgs/sql-client#src"
      ]
    },
    "lint": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/libs/tools/biome-plugins/**",
        "$TURBO_ROOT$/oxlint.config.mts",
        "$TURBO_ROOT$/components.json",
        "$TURBO_ROOT$/pkgs/tailwind/src/lint.css",
        "$TURBO_ROOT$/pkgs/tailwind/src/tailwind.css",
        "$TURBO_ROOT$/pkgs/ui/codemod/theme.css",
        "$TURBO_ROOT$/pkgs/ui/src/components/hosts.css",
        "$TURBO_ROOT$/libs/tools/port/*.json",
        "$TURBO_ROOT$/libs/tools/scripts/lint-package.ts",
        "$TURBO_ROOT$/libs/tools/scripts/banned-words.ts",
        "$TURBO_ROOT$/libs/tools/scripts/biome-scope.ts",
        "$TURBO_ROOT$/libs/tools/scripts/package-boundaries.ts",
        "$TURBO_ROOT$/libs/tools/scripts/tc-scope.ts",
        "$TURBO_ROOT$/libs/tools/scripts/test-scripts.ts",
        "$TURBO_ROOT$/libs/tools/scripts/unused-dependencies.ts",
        "$TURBO_ROOT$/libs/tools/scripts/lingui-scope.ts",
        "$TURBO_ROOT$/libs/tools/naming/**",
        "$TURBO_ROOT$/libs/tools/goal/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["tc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:spec:0": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/harness/scripts/**",
        "$TURBO_ROOT$/libs/harness/src/ci/report-ready.ts"
      ],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-0/**"]
    },
    "test:spec:1": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/harness/scripts/**",
        "$TURBO_ROOT$/libs/harness/src/ci/report-ready.ts"
      ],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-1/**"]
    },
    "test:spec:2": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/harness/scripts/**",
        "$TURBO_ROOT$/libs/harness/src/ci/report-ready.ts"
      ],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-2/**"]
    },
    "test:spec:3": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/harness/scripts/**",
        "$TURBO_ROOT$/libs/harness/src/ci/report-ready.ts"
      ],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-3/**"]
    },
    "test:spec:4": {
      "dependsOn": ["tc"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/harness/scripts/**",
        "$TURBO_ROOT$/libs/harness/src/ci/report-ready.ts"
      ],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-4/**"]
    },
    "test:spec:5": {
      "dependsOn": ["tc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "HARNESS_MODE",
        "HARNESS_WITH_DOM",
        "HARNESS_FIDELITY",
        "PBT_NUM_RUNS",
        "PBT_RANDOM",
        "FC_SEED"
      ],
      "outputLogs": "errors-only",
      "outputs": [".cache/harness-report/part-5/**"]
    },
    "check:models": {
      "inputs": [
        "package.json",
        "tests/quint/**",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/pkgs/quint/package.json",
        "$TURBO_ROOT$/pkgs/quint/src/**",
        "$TURBO_ROOT$/pkgs/conformance/src/**",
        "$TURBO_ROOT$/libs/tools/scripts/check-models.ts",
        "$TURBO_ROOT$/libs/tools/scripts/spec-packages.ts",
        "$TURBO_ROOT$/libs/tools/scripts/spec-kinds.ts"
      ],
      "outputs": [".cache/harness-report/models/**"],
      "outputLogs": "errors-only"
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_API_URL",
        "VITE_TEST_HOOKS",
        "VITE_ALLOW_PRODUCTION_API_URL"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.mts",
        "index.html",
        "public/**",
        "!public/sql-workers/**",
        "!public/generated/**",
        "!dist/**",
        "!.cache/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js"
      ],
      "outputLogs": "errors-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "//#lint:root": {
      "dependsOn": ["@libs/tools#tc"],
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!libs/**", "!pkgs/**"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "libs/tools/package.json",
        ".syncpackrc.cjs"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:audit": {
      "inputs": ["bun.lock", "libs/tools/scripts/ci-audit.ts", "package.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.ts",
        "lingui.solid.config.ts",
        "libs/account-privacy/src/**/*.{ts,tsx}",
        "libs/auth/src/**/*.{ts,tsx}",
        "libs/billing/src/**/*.{ts,tsx}",
        "libs/chess/src/**/*.{ts,tsx}",
        "libs/client-app/src/**/*.{ts,tsx}",
        "libs/client-config/src/**/*.{ts,tsx}",
        "libs/friends/src/**/*.{ts,tsx}",
        "libs/notifications/src/**/*.{ts,tsx}",
        "libs/permissions/src/**/*.{ts,tsx}",
        "libs/profile/src/**/*.{ts,tsx}",
        "libs/search/src/**/*.{ts,tsx}",
        "libs/spaces/src/**/*.{ts,tsx}",
        "libs/user-search/src/**/*.{ts,tsx}",
        "pkgs/chess-board/src/**/*.{ts,tsx}",
        "pkgs/ui/src/**/*.{ts,tsx}",
        "pkgs/ui-devtools/src/**/*.{ts,tsx}",
        "libs/client-app/src/i18n/locales/**",
        "apps/client/babel.config.js",
        "pkgs/bun-test-solid/src/babel.config.cjs",
        "libs/tools/scripts/ci-i18n.ts",
        "libs/tools/scripts/lingui-scope.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#ci:agent-commands": {
      "inputs": [
        ".agents/**",
        ".claude/commands",
        ".cursor/commands",
        ".opencode/commands",
        ".gemini/commands/**",
