{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "100%",
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "PREVIEW_PORT",
    "POSTGRES_SCHEMA",
    "API_URL",
    "LOCAL_PREVIEW_API_ORIGIN",
    "DATABASE_URL",
    "AUTH_*",
    "LOCAL_SECRETS",
    "STRIPE_*",
    "CLOUDFLARE_*",
    "RAILWAY_*",
    "B2_*",
    "S3_*",
    "ELEVEN_LABS_*",
    "OPENAI_*",
    "PS_*",
    "EXPO_TOKEN",
    "EXPO_USE_WATCHMAN",
    "SECRETS_*",
    "INFISICAL_*",
    "ACTIONS_ID_TOKEN_*",
    "WEB_CLIENT_*",
    "EMQX_*",
    "OBSERVABILITY_*",
    "TURBO_*",
    "SIM_FIDELITY",
    "SIM_REPORT",
    "PLAYWRIGHT_BASE_URL",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "tsconfig.json",
        "tsconfig.tc.json",
        "../../tsconfig.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tests/**",
        "package.json",
        "jest.config.*",
        "*.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:max": {
      "cache": false,
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tests/**",
        "package.json",
        "jest.config.*",
        "*.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_E2E",
        "EXPO_PUBLIC_ALLOW_PRODUCTION_API_URL"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.tc.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "test:integration": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "jest.config.*",
        "*.cjs",
        "**/integration/**"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:contract": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "jest.config.*",
        "*.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:e2e": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mjs",
        "package.json",
        "e2e/**",
        "jest.config.*",
        "*.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "billing:check": {
      "inputs": ["**/*.ts", "**/*.tsx", "package.json", "scripts/**"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint": {
      "inputs": [
        "apps/**/*.{ts,tsx,js,jsx}",
        "libs/**/*.{ts,tsx,js,jsx}",
        "pkgs/**/*.{ts,tsx,js,jsx}",
        "sim/**/*.{ts,tsx,js,jsx,cjs}",
        "tools/**/*.{ts,tsx,js,cjs}",
        "biome.json",
        "tools/biome-plugins/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check": {
      "dependsOn": ["lint", "tc", "test"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:full": {
      "dependsOn": [
        "//#check",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "@libs/secrets#check",
        "@apps/server#build",
        "@apps/room-server#build",
        "test:contract",
        "test:e2e",
        "@libs/billing#billing:check",
        "@tools#check:static",
        "@apps/server#check:api"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@tools#install:cli": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@tools#check:static": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@apps/server#check:api": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "@libs/secrets#provision": {
      "cache": false,
      "dependsOn": ["@tools#install:cli"]
    },
    "@libs/db#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/object-store#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/pubsub#provision": {
      "cache": false,
      "dependsOn": ["@libs/secrets#provision"]
    },
    "@libs/db#migrate": {
      "cache": false,
      "dependsOn": [
        "@libs/db#provision",
        "@libs/object-store#provision",
        "@libs/pubsub#provision"
      ]
    },
    "@libs/secrets#check": {
      "env": ["CHECK_SECRETS_FINGERPRINT"],
      "inputs": [
        "libs/secrets/src/bin/check-secrets.ts",
        "libs/secrets/src/shared/secrets/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@apps/room-server#deploy": {
      "cache": false,
      "dependsOn": ["@libs/db#migrate"]
    },
    "@apps/server#deploy": {
      "cache": false,
      "dependsOn": ["@apps/room-server#deploy"]
    },
    "@apps/client#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@sim/console#deploy": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@libs/billing#billing:sync": {
      "cache": false,
      "dependsOn": ["@apps/server#deploy"]
    },
    "@apps/server#smoke": {
      "cache": false,
      "dependsOn": [
        "@apps/client#deploy",
        "@sim/console#deploy",
        "@libs/billing#billing:sync"
      ]
    },
    "@apps/client#deploy:ota": {
      "cache": false,
      "dependsOn": ["@apps/server#smoke"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": [
        "lint",
        "tc",
        "test",
        "@apps/server#build",
        "@apps/room-server#build",
        "//#ci:syncpack",
        "//#ci:depcruise",
        "//#ci:audit",
        "//#ci:i18n",
        "test:contract",
        "test:e2e",
        "@libs/billing#billing:check",
        "@tools#check:static",
        "@apps/server#check:api",
        "@libs/secrets#check",
        "@tools#install:cli",
        "@libs/billing#billing:sync",
        "@apps/client#deploy:ota"
      ]
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "sim/*/package.json",
        "tools/package.json",
        ".syncpackrc.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "sim/**/*.ts",
        "sim/**/*.tsx",
        ".dependency-cruiser.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "inputs": ["bun.lock", "tools/scripts/ci-audit.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:i18n": {
      "inputs": [
        "lingui.config.cjs",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "sim/**/*.ts",
        "sim/**/*.tsx",
        "apps/client/src/i18n/locales/**",
        "apps/client/babel.config.js",
        "sim/console/babel.config.js",
        "sim/test/babel.jest.config.js",
        "tools/scripts/ci-i18n.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#check:static": {
      "cache": false,
      "outputLogs": "new-only"
    }
  }
}
