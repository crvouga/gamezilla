{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "10",
  "globalDependencies": ["bun.lock", "tsconfig.json", "package.json"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "POST_DEPLOY_*",
    "EXPO_PUBLIC_*",
    "DOPPLER_TOKEN",
    "DOPPLER_CONFIG",
    "DOPPLER_PROJECT",
    "DOPPLER_ENVIRONMENT",
    "TURBO_*",
    "TMPDIR"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "kill": {
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "../../tsconfig.json"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "eslint.config.js"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.css",
        "**/*.json",
        "**/*.html",
        "vite.config.ts",
        "tsconfig.json",
        "babel.config.js",
        "metro.config.js"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**"]
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "qa": {
      "cache": false
    },
    "//#ci:format": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:syncpack": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        ".syncpackrc.cjs",
        "scripts/check-catalog-deps.ts",
        "scripts/check-no-patches.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:depcruise": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        ".dependency-cruiser.cjs"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:circular-deps": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "libs/**/*.ts",
        "libs/**/*.tsx",
        "pkgs/**/*.ts",
        "pkgs/**/*.tsx",
        "apps/*/package.json",
        "libs/*/package.json",
        "pkgs/*/package.json",
        "scripts/check-circular-deps.ts"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:audit": {
      "cache": false
    },
    "//#ci:i18n": {
      "cache": false
    }
  }
}
