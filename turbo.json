{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "AWS_ACCESS_KEY_ID",
    "AWS_DEFAULT_REGION",
    "AWS_REGION",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "GITHUB_ACTIONS",
    "GITHUB_STEP_SUMMARY",
    "POST_DEPLOY_HTTP_MAX_WAIT_MS",
    "POST_DEPLOY_HTTP_RETRY_MS"
  ],
  "tasks": {
    "up": {
      "cache": false
    },
    "install:deps": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["install:deps"],
      "persistent": true,
      "cache": false
    },
    "dev:req-res": {
      "dependsOn": ["@gamezilla/local#up"],
      "persistent": true,
      "cache": false
    },
    "dev:worker": {
      "dependsOn": ["@gamezilla/local#up"],
      "persistent": true,
      "cache": false
    },
    "check": {
      "dependsOn": ["tc", "lint", "test"]
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "../../tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "eslint.config.js"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.test.ts"],
      "outputs": []
    },
    "export:web": {
      "dependsOn": ["^build"],
      "env": ["EXPO_PUBLIC_STAGE"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.css", "**/*.json", "tsconfig.json"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.css", "**/*.html", "vite.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    }
  }
}
