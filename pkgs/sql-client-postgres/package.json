{
  "name": "@pkgs/sql-client-postgres",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.contract.test.ts'",
    "test:contract": "bun test src/postgres.contract.test.ts"
  },
  "dependencies": {
    "@crvouga/postgres-mem": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/postgres-sqlite-compat": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
