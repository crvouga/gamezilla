{
  "name": "@pkgs/sql-client-postgres",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts'",
    "test:contract": "bun test src/postgres.contract.test.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-postgres": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/postgres-sqlite-compat": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@pkgs/postgres-embedded": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
