    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload",
    "test:e2e": "bun run ../../libs/harness/scripts/test-e2e.ts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
