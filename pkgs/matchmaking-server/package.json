    "@pkgs/matchmaking-shared": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server"
}
