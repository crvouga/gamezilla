{
  "name": "@pkgs/pubsub-emqx",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.contract.test.ts'",
    "test:broker": "bun test --timeout 60000 src/emqx.contract.test.ts",
    "test:contract": "bun test --timeout 60000 src/emqx.contract.test.ts"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/pubsub-mqtt": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "mqtt": "catalog:",
    "typescript": "catalog:"
  }
}
