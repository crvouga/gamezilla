{
  "name": "@pkgs/postgres",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "dev": "bun run src/dev.ts",
    "drop": "bun run src/drop.ts",
    "kill": "bun run src/kill.ts",
    "lint": "eslint src --max-warnings 0",
    "preview": "bun run src/dev.ts",
    "setup": "bun -e \"process.exit(0)\"",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "embedded-postgres": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
