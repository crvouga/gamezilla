{
  "name": "@pkgs/sql-client-harness",
  "version": "0.0.0",
  "private": true,
  "category": "harness",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/harness-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/object-store-shared": "workspace:*",
    "@pkgs/sql-client-postgres-server": "workspace:*",
    "@pkgs/sql-client-postgres-shared": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-server": "workspace:*",
    "@pkgs/sql-client-sqlite-web-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "better-sqlite3": "catalog:",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
