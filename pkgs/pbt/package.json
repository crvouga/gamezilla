{
  "name": "@pkgs/pbt",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test",
    "test:pbt": "bun run --filter @pkgs/pbt test",
    "test:pbt:random": "bun run ../../tools/scripts/test-pbt-random.ts"
  },
  "dependencies": {
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
