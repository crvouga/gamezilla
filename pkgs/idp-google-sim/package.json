{
  "name": "@pkgs/idp-google-sim",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./server": "./src/server/index.ts",
    "./shared/*": [
      "./src/shared/*.ts"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*/index.ts"
    ],
    "./embedded": "./web/src/embedded-page.tsx",
    "./start-server": "./scripts/start-idp-server.ts"
  },
  "scripts": {
    "build:web": "bun run scripts/build-web-assets.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "start": "bun --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/register scripts/serve.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload ./tests",
    "web:dev": "vite --config vite.config.mts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@solidjs/router": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
