{
  "name": "@pkgs/auth-inhouse",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload ./src ./tests"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@pkgs/auth": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/db-schema-postgres": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@crvouga/mockingbird-service-oauth": "catalog:",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
