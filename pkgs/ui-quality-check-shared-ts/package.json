    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "category": "isomorphic",
  "language": "typescript"
}
