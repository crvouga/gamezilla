{
  "name": "@pkgs/ui-quality-check-server",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "benchmark": "bun run src/cli.ts benchmark",
    "build": "bun run scripts/build.ts",
    "evaluate": "bun run scripts/evaluate.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepack": "bun run build",
    "setup": "bun run src/cli.ts setup",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/object-store-root-shared": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/ui-quality-check-shared": "workspace:*",
    "ffmpeg-static": "5.3.0",
    "onnxruntime-node": "1.30.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@pkgs/property-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "category": "server"
}
