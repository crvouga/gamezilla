{
  "name": "@pkgs/feedback",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./harness": "./src/harness/index.ts",
    "./vite": "./scripts/vite.ts",
    "./browser": "./src/client/wall.ts",
    "./context": "./src/client/context.ts"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
