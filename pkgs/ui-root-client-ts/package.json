{
  "name": "@pkgs/ui-root-client-ts",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./*": [
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ],
    "./*.css": "./src/*.css"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts && bun run scripts/generate-tokens-css.ts --check",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload --parallel tests",
    "tokens:generate": "bun run scripts/generate-tokens-css.ts",
    "tokens:verify": "bun run scripts/generate-tokens-css.ts --check"
  },
  "dependencies": {
    "@fontsource/manrope": "catalog:",
    "@fontsource/unbounded": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/a11y-shared-ts": "workspace:*",
    "@pkgs/clock-client-ts": "workspace:*",
    "@pkgs/i18n-shared-ts": "workspace:*",
    "@pkgs/keyword-shared-ts": "workspace:*",
    "@pkgs/kv-root-client-ts": "workspace:*",
    "@pkgs/kv-root-shared-ts": "workspace:*",
    "@pkgs/os-shared-ts": "workspace:*",
    "@pkgs/solid-context-client-ts": "workspace:*",
    "@pkgs/ui-root-shared-ts": "workspace:*",
    "@solidjs/router": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "lucide-solid": "catalog:",
    "prosemirror-commands": "catalog:",
    "prosemirror-history": "catalog:",
    "prosemirror-inputrules": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-markdown": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-schema-list": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-view": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "language": "typescript"
}
