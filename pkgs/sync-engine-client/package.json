{
  "name": "@pkgs/sync-engine-client",
  "version": "0.0.0",
  "private": true,
  "category": "client",
  "sideEffects": false,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@pkgs/assert-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/observability-shared": "workspace:*",
    "@pkgs/outbox-shared": "workspace:*",
    "@pkgs/pubsub-shared": "workspace:*",
    "@pkgs/solid-context-client": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
