{
  "name": "@pkgs/chess-board",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --preload ./tests/board-style-preload.ts --path-ignore-patterns='**/browser/**' tests",
    "test:contract": "bun test tests/browser",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/a11y": "workspace:*",
    "@pkgs/chess-board-core": "workspace:*",
    "@pkgs/chess-rules": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/harness": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/gherkin": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@pkgs/quint": "workspace:*",
    "@pkgs/tailwind": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/ui-testing-solid-dom": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "chess.js": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "specDomains": [
    "chess-board"
  ],
  "specParts": 1
}
