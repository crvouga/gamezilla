{
  "name": "@pkgs/chess-board",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --path-ignore-patterns='**/e2e/**' tests",
    "test:e2e": "bun ./e2e/run-e2e.ts"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/chess-board-core": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/tailwind": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/ui-testing-bun-webview": "workspace:*",
    "@pkgs/ui-testing-solid-dom": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "chess.js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
