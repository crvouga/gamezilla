{
  "name": "@pkgs/chess-board",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
