    "@pkgs/ui-root-client-ts": "workspace:*",
    "@pkgs/ui-root-shared-ts": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "language": "typescript"
}
