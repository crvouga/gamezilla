  "dependencies": {},
  "devDependencies": {
    "@pkgs/property-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
