{
  "name": "@pkgs/matchmaking-root-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --parallel=1 --timeout 120000 tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/8",
    "test:spec:1": "bun run ../../libs/harness/scripts/test-spec.ts --part 1/8",
    "test:spec:2": "bun run ../../libs/harness/scripts/test-spec.ts --part 2/8",
    "test:spec:3": "bun run ../../libs/harness/scripts/test-spec.ts --part 3/8",
    "test:spec:4": "bun run ../../libs/harness/scripts/test-spec.ts --part 4/8",
    "test:spec:5": "bun run ../../libs/harness/scripts/test-spec.ts --part 5/8",
    "test:spec:6": "bun run ../../libs/harness/scripts/test-spec.ts --part 6/8",
    "test:spec:7": "bun run ../../libs/harness/scripts/test-spec.ts --part 7/8"
  },
  "dependencies": {
    "@pkgs/assert-root-shared": "workspace:*",
    "@pkgs/attribute-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/matchmaking-root-shared": "workspace:*",
    "@pkgs/matchmaking-sql-server": "workspace:*",
    "@pkgs/postgres-mockingbird-server": "workspace:*",
    "@pkgs/sql-client-postgres-server": "workspace:*",
    "@pkgs/sql-client-postgres-shared": "workspace:*",
    "@pkgs/sql-client-root-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "fast-check": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@pkgs/alloy-shared": "workspace:*",
    "@pkgs/gherkin-shared": "workspace:*",
    "@pkgs/quint-server": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "specDomains": [
    "matchmaking"
  ],
  "specParts": 8
}
