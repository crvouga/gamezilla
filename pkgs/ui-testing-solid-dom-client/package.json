{
  "name": "@pkgs/ui-testing-solid-dom-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/ui-testing-root-shared": "workspace:*",
    "@pkgs/ui-testing-solid-dom-shared": "workspace:*",
    "@testing-library/user-event": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/clock-client": "workspace:*",
    "@pkgs/ui-root-client": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "language": "typescript"
}
