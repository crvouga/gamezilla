{
  "name": "@pkgs/sql-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./sqlite/web": "./src/sqlite/web/index.ts",
    "./sqlite/web/*": [
      "./src/sqlite/web/*.ts",
      "./src/sqlite/web/*/index.ts"
    ],
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/*.ts",
      "./src/*/*.tsx"
    ]
  },
  "scripts": {
    "build:web-workers": "bun ./scripts/build-web-workers.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.contract.test.ts' --path-ignore-patterns='**/e2e/**'",
    "test:contract": "bun test src/postgres/postgres.contract.test.ts",
    "test:e2e": "bun ./scripts/build-web-workers.ts && playwright test -c ./e2e/playwright.config.mjs"
  },
  "dependencies": {
    "@crvouga/postgres-mem": "catalog:",
    "@crvouga/sqlite-mem": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/determinism": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/postgres-sqlite-compat": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "better-sqlite3": "catalog:",
    "expo-sqlite": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@pkgs/pbt": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:"
  }
}
