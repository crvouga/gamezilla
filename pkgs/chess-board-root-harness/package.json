{
  "name": "@pkgs/chess-board-root-harness",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload --preload @pkgs/chess-board-root-client/board-style-preload --path-ignore-patterns='**/browser/**' tests",
    "test:contract": "bun test tests/browser",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/a11y-shared": "workspace:*",
    "@pkgs/chess-board-core-shared": "workspace:*",
    "@pkgs/chess-board-root-client": "workspace:*",
    "@pkgs/chess-board-root-shared": "workspace:*",
    "@pkgs/clock-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/sounds-client": "workspace:*",
    "@pkgs/sounds-shared": "workspace:*",
    "@pkgs/tailwind-shared": "workspace:*",
    "@pkgs/ui-root-client": "workspace:*",
    "chess.js": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/gherkin-shared": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@pkgs/vite-workspace-resolver-server": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "category": "harness",
  "specDomains": [
    "chess-board"
  ],
  "specParts": 1
}
