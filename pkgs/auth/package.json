{
  "name": "@pkgs/auth",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test ./src ./tests",
    "test:e2e": "bun ./e2e/run-e2e.ts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/db-schema-postgres": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@pkgs/logger": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
