{
  "name": "@pkgs/sql-client-root-harness-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/db-schema-root-shared-ts": "workspace:*",
    "@pkgs/db-schema-sqlite-shared-ts": "workspace:*",
    "@pkgs/harness-root-shared-ts": "workspace:*",
    "@pkgs/logger-shared-ts": "workspace:*",
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/postgres-mockingbird-server-ts": "workspace:*",
    "@pkgs/sql-client-postgres-server-ts": "workspace:*",
    "@pkgs/sql-client-postgres-shared-ts": "workspace:*",
    "@pkgs/sql-client-root-shared-ts": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server-ts": "workspace:*",
    "@pkgs/sql-client-sqlite-web-client-ts": "workspace:*",
    "@pkgs/sql-client-sqlite-web-shared-ts": "workspace:*",
    "@pkgs/sql-root-shared-ts": "workspace:*",
    "better-sqlite3": "catalog:",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript"
}
