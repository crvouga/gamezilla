{
  "name": "@pkgs/object-store-s3",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.contract.test.ts'",
    "test:contract": "bun test src/object-store.s3.contract.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/object-store": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/uuid": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
