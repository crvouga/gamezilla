{
  "name": "@pkgs/object-store-s3",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts'",
    "test:contract": "bun test src/object-store.s3.contract.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@pkgs/clock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@xmldom/xmldom": "catalog:"
  },
  "devDependencies": {
    "@pkgs/property": "workspace:*",
    "@pkgs/s3-server": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
