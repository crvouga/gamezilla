{
  "name": "@pkgs/object-store-s3-shared",
  "version": "0.0.0",
  "private": true,
  "category": "isomorphic",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
