{
  "name": "@pkgs/pubsub-emqx-harness",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts' tests",
    "test:contract": "bun test --timeout 60000 tests/emqx.contract.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/emqx-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/pubsub-emqx-shared": "workspace:*",
    "@pkgs/pubsub-root-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "mqtt": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript"
}
