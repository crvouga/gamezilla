{
  "name": "@pkgs/simulation-report",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun ./src/build-web.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
