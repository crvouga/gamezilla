  },
  "dependencies": {
    "@pkgs/object-store": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
