{
  "name": "@pkgs/feedback-harness-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload tests",
    "test:spec": "bun run ../../libs/harness-ts/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 0/1"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/clock-client-ts": "workspace:*",
    "@pkgs/feedback-client-ts": "workspace:*",
    "@pkgs/feedback-server-ts": "workspace:*",
    "@pkgs/feedback-shared-ts": "workspace:*",
    "@pkgs/harness-root-shared-ts": "workspace:*",
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/gherkin-shared-ts": "workspace:*",
    "@pkgs/http-client-shared-ts": "workspace:*",
    "@pkgs/object-store-node-fs-server-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript",
  "specDomains": [
    "feedback"
  ],
  "specParts": 1
}
