{
  "name": "@pkgs/object-store",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
