  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@pkgs/assert": "workspace:*",
    "expo-file-system": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
