{
  "name": "@pkgs/system-console",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "bun run scripts/local-report-server.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test src --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/io": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/system": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
