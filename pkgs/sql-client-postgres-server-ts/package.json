{
  "name": "@pkgs/sql-client-postgres-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts' tests",
    "test:contract": "bun test tests/postgres.contract.test.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-postgres": "catalog:",
    "@pkgs/assert-root-shared-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/postgres-sqlite-compat-shared-ts": "workspace:*",
    "@pkgs/sql-client-postgres-shared-ts": "workspace:*",
    "@pkgs/sql-client-root-shared-ts": "workspace:*",
    "@pkgs/sql-root-shared-ts": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@pkgs/postgres-mockingbird-server-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
