{
  "name": "@pkgs/room-root-client-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload tests"
  },
  "dependencies": {
    "@pkgs/assert-root-shared-ts": "workspace:*",
    "@pkgs/attribute-shared-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/keyword-shared-ts": "workspace:*",
    "@pkgs/kv-root-shared-ts": "workspace:*",
    "@pkgs/message-shared-ts": "workspace:*",
    "@pkgs/room-root-shared-ts": "workspace:*",
    "@pkgs/solid-context-client-ts": "workspace:*",
    "@pkgs/uuid-shared-ts": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "language": "typescript"
}
