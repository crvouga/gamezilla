{
  "name": "@pkgs/sql-client-sqlite-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./scripts/sqlite-web-assets.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/e2e/**'",
    "test:e2e": "bun ./scripts/build-web-workers.ts && bun ./e2e/run-e2e.ts"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "devDependencies": {
    "@pkgs/os": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
