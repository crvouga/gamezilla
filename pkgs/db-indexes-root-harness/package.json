{
  "name": "@pkgs/db-indexes-root-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepare:spec": "bun run --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client/register ../../libs/harness/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1",
    "verify:models": "bun run ../../libs/tools/scripts/verify-models.ts"
  },
  "dependencies": {
    "@pkgs/assert-root-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/db-indexes-root-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/gherkin-shared": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@pkgs/quint-server": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript",
  "specDomains": [
    "db-indexes"
  ],
  "specParts": 1
}
