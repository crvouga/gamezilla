{
  "name": "@pkgs/postgres-embedded-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "install:deps": "bun run scripts/install-deps.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "setup": "bun run scripts/setup.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json"
  },
  "dependencies": {
    "@pkgs/os-server": "workspace:*",
    "@pkgs/postgres-embedded-shared": "workspace:*",
    "embedded-postgres": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
