{
  "name": "@pkgs/ui-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "tokens:check": "bun run scripts/generate-tokens-css.ts --check",
    "tokens:generate": "bun run scripts/generate-tokens-css.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@pkgs/ui-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
