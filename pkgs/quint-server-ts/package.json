{
  "name": "@pkgs/quint-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --max-concurrency=$(bun ../os-server-ts/src/test-concurrency.ts) tests"
  },
  "dependencies": {
    "@informalsystems/quint": "catalog:",
    "@pkgs/conformance-server-ts": "workspace:*",
    "@pkgs/conformance-shared-ts": "workspace:*",
    "@pkgs/os-shared-ts": "workspace:*",
    "@pkgs/quint-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
