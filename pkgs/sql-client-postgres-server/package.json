{
  "name": "@pkgs/sql-client-postgres-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts' tests",
    "test:contract": "bun test tests/postgres.contract.test.ts"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-postgres": "catalog:",
    "@pkgs/assert-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/postgres-sqlite-compat-shared": "workspace:*",
    "@pkgs/sql-client-postgres-shared": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@pkgs/postgres-embedded-server": "workspace:*",
    "@pkgs/sql-client-sqlite-server": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
