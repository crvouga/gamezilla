    "@pkgs/kv": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/uuid": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/sim": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
