{
  "name": "@pkgs/room",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./solid": "./src/solid.ts",
    "./client/adapters/storage/key-value": "./src/client/adapters/storage/key-value/index.ts"
  },
  "scripts": {
    "bench": "bun tests/bench/hot-paths.bench.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {}
}
