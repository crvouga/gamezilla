{
  "name": "@pkgs/room",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./solid": "./src/solid.ts",
    "./client/adapters/storage/key-value": "./src/client/adapters/storage/key-value/index.ts"
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.test.tsx' && vitest run",
    "test:sim": "bun run --filter @pkgs/room-sim test",
    "bench": "bun tests/bench/hot-paths.bench.ts"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/sim": "workspace:*",
    "@pkgs/vitest-solid": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {}
}
