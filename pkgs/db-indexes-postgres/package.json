{
  "name": "@pkgs/db-indexes-postgres",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.contract.test.ts'",
    "test:contract": "bun test tests/postgres.contract.test.ts"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-indexes": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
