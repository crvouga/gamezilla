{
  "name": "@pkgs/feedback-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/clock-client": "workspace:*",
    "@pkgs/feedback-client": "workspace:*",
    "@pkgs/feedback-server": "workspace:*",
    "@pkgs/feedback-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/object-store-root-shared": "workspace:*",
    "@pkgs/ui-root-client": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/gherkin-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript",
  "specDomains": [
    "feedback"
  ],
  "specParts": 1
}
