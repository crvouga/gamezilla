{
  "name": "@pkgs/observability-root-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests",
    "verify:collector-configs": "bun run scripts/validate-collector-configs.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/http-client-shared-ts": "workspace:*",
    "@pkgs/message-shared-ts": "workspace:*",
    "@pkgs/observability-root-shared-ts": "workspace:*",
    "@pkgs/observability-runtime-shared-ts": "workspace:*",
    "@pkgs/outbox-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/os-server-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
