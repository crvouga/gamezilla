{
  "name": "@pkgs/ui-root-harness-ts",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "ci:storybook": "playwright test -c storybook/playwright.config.ts --grep 'storybook integration|primitives-|button--|checkbox--|components-overlay-mutationmodal--|product-game-arena--searching|templates-form-editor|templates-search-and-collections'",
    "dev:storybook": "storybook dev --ci --no-open -c storybook -p 6006",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "storybook:build": "storybook build -c storybook -o .cache/storybook",
    "storybook:coverage": "bun scripts/storybook-coverage.ts",
    "storybook:dev": "bun ../../libs/tools-harness-ts/scripts/owned-command.ts storybook dev --ci --no-open -c storybook -p 6006",
    "storybook:mcp:test": "playwright test -c storybook/mcp.config.ts",
    "storybook:test": "playwright test -c storybook/playwright.config.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload tests"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@solidjs/router": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/a11y-shared-ts": "workspace:*",
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/clock-client-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/i18n-shared-ts": "workspace:*",
    "@pkgs/os-shared-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "@pkgs/ui-root-shared-ts": "workspace:*",
    "@pkgs/ui-testing-bun-webview-server-ts": "workspace:*",
    "@pkgs/vite-workspace-resolver-server-ts": "workspace:*",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "axe-core": "catalog:",
    "fast-check": "catalog:",
    "storybook": "catalog:",
    "storybook-solidjs-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "category": "harness",
  "language": "typescript"
}
