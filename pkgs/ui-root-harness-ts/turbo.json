{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "src": {
      "dependsOn": []
    },
    "dev:storybook": {
      "dependsOn": ["@apps/product-ts#dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "storybook:dev": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "dependsOn": [
        "^src",
        "@pkgs/assistant-client-ts#src",
        "@pkgs/collab-ui-client-ts#src",
        "@pkgs/chess-board-root-client-ts#src",
        "@pkgs/ui-devtools-client-ts#src"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!tests/**",
        "!scripts/**",
        "!**/*.md",
        "$TURBO_ROOT$/lingui.solid.config.ts",
        "$TURBO_ROOT$/lingui.config.ts",
        "$TURBO_ROOT$/libs/tools-harness-ts/scripts/lingui-scope.ts",
        "$TURBO_ROOT$/pkgs/{ui-root,ui-devtools,chess-board-root,assistant,collab-ui}-client-ts/src/**/*.stories.tsx",
        "$TURBO_ROOT$/pkgs/{ui-root,ui-devtools,chess-board-root,assistant,collab-ui}-client-ts/src/**/*.example.tsx",
        "$TURBO_ROOT$/pkgs/ui-root-client-ts/storybook/**",
        "$TURBO_ROOT$/pkgs/{ui-root,ui-devtools,chess-board-root}-client-ts/src/tsconfig.json"
      ],
      "outputs": [".cache/storybook/**"]
    },
    "storybook:coverage": {
      "dependsOn": ["storybook:build"],
      "cache": false
    },
    "storybook:test": {
      "dependsOn": ["storybook:build"],
      "cache": false
    },
    "storybook:mcp:test": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^src", "storybook:build"]
    },
    "ci:storybook": {
      "dependsOn": ["storybook:build", "storybook:coverage"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo-platform-key.json",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/pkgs/{ui-root,ui-devtools,chess-board-root,assistant,collab-ui}-client-ts/src/**/baselines/**"
      ],
      "outputs": [],
      "env": ["BUN_CHROME_PATH"]
    }
  }
}
