{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/specs/db-indexes/*.qnt"]
    },
    "test:spec:0": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/specs/db-indexes/**"]
    },
    "verify:models": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/specs/db-indexes/*.qnt"]
    },
    "src": {
      "dependsOn": [
        "@pkgs/assert-root-shared-ts#src",
        "@pkgs/clock-shared-ts#src"
      ]
    }
  }
}
