{
  "name": "@pkgs/sounds",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "fetch:assets": "bun run scripts/fetch-kenney-packs.ts && bun run scripts/curate-sounds.ts && bun run scripts/generate-manifest.ts",
    "lint": "eslint src --max-warnings 0",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests",
    "verify:licenses": "bun run scripts/verify-licenses.ts"
  },
  "dependencies": {
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "expo-audio": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
