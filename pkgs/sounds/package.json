{
  "name": "@pkgs/sounds",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "fetch:assets": "bun run scripts/fetch-kenney-packs.ts && bun run scripts/curate-sounds.ts && bun run scripts/generate-manifest.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload",
    "verify:licenses": "bun run scripts/verify-licenses.ts"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
