{
  "name": "@pkgs/tts-root-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@pkgs/http-client-client": "workspace:*",
    "@pkgs/object-store-root-client": "workspace:*",
    "@pkgs/object-store-root-shared": "workspace:*",
    "@pkgs/solid-context-client": "workspace:*",
    "@pkgs/sounds-client": "workspace:*",
    "@pkgs/sounds-shared": "workspace:*",
    "@pkgs/tts-root-shared": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client"
}
