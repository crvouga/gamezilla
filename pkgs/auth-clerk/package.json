{
  "name": "@pkgs/auth-clerk",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@clerk/backend": "catalog:",
    "@clerk/expo": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "expo-auth-session": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-web-browser": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
