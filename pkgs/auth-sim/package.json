{
  "name": "@pkgs/auth-sim",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --parallel=1 --timeout 120000 --pass-with-no-tests tests"
  },
  "dependencies": {
    "@pkgs/auth": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/idp-google-sim": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
