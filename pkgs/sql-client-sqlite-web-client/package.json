{
  "name": "@pkgs/sql-client-sqlite-web-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-web-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client"
}
