    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/quint-server": "workspace:*",
    "@pkgs/sql-client-sqlite-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
