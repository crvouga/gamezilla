{
  "name": "@pkgs/sync-engine-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "sideEffects": false,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
