{
  "name": "@pkgs/observability",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client/*": ["./src/client/*.ts", "./src/client/*.tsx"],
    "./server/*": ["./src/server/*.ts", "./src/server/*.tsx"],
    "./shared/*": ["./src/shared/*.ts"],
    "./port/*": ["./src/port/*.ts"],
    "./impl-noop/*": ["./src/impl-noop/*.ts"],
    "./impl-local-file/*": ["./src/impl-local-file/*.ts"],
    "./*": ["./src/*.ts", "./src/*.tsx", "./src/*/index.ts"]
  },
  "scripts": {
    "dev": "bun run src/impl-local-file/dev.ts",
    "lint": "eslint src --max-warnings 0",
    "summarize": "bun run src/impl-local-file/summarize-cli.ts",
    "tc": "tsc --noEmit -p ./tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "hono": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
