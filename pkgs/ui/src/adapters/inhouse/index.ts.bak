/**
 * In-house adapter -- the default `UIAdapter` implementation.
 *
 * Imports every component the port exposes from `../../components/**` and
 * assembles them into a single object. The boot-time switch in
 * `../../adapter-registry.ts` returns this object when `UI_IMPL` is
 * `'inhouse'` (the default).
 *
 * No HeroUI primitives are imported here; the in-house implementation is the
 * source of truth for the default look-and-feel of the design system.
 */

import {
  Avatar,
  AvatarGroup,
  BackIconButton,
  Badge,
  Box,
  BrandIcon,
