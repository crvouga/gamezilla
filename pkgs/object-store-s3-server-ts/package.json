{
  "name": "@pkgs/object-store-s3-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./impl-s3": {
      "types": "./src/impl-s3.ts",
      "bun": {
        "browser": "./.cache/browser/impl-s3.js",
        "default": "./src/impl-s3.ts"
      },
      "default": "./src/impl-s3.ts"
    },
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "generate:browser": "bun run scripts/generate-browser.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts' tests",
    "test:contract": "bun test tests/object-store.s3.contract.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/object-store-s3-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/property-shared-ts": "workspace:*",
    "@pkgs/s3-server-ts": "workspace:*",
    "@pkgs/uuid-shared-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
