{
  "name": "@pkgs/matchmaking-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --parallel=1 --timeout 120000 tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/harness": "workspace:*",
    "@pkgs/matchmaking": "workspace:*",
    "@pkgs/matchmaking-sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/gherkin": "workspace:*",
    "@pkgs/quint": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "specDomains": [
    "matchmaking"
  ]
}
