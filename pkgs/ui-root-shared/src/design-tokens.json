{
  "$description": "Design tokens, the single source of every visual value (W3C Design Tokens format). Edit here, then run `bun run --filter @pkgs/ui-root-client tokens:generate`.",
  "color": {
    "$type": "color",
    "$description": "Neutral surfaces and one blue. Each scheme defines every role; `[data-theme]` picks the scheme at runtime.",
    "light": {
      "background": {
        "$description": "The canvas: white / true black.",
        "$value": {
          "colorSpace": "hsl",
          "components": [0, 0, 100],
          "alpha": 1
        }
      },
      "surface": {
        "$description": "Panels and cards, one step off the canvas.",
        "$value": {
          "colorSpace": "hsl",
          "components": [180, 14, 97],
          "alpha": 1
        }
      },
      "surfaceSunken": {
        "$description": "Deeper than background: the page-level recessed canvas.",
        "$value": {
          "colorSpace": "hsl",
          "components": [195, 15, 94],
          "alpha": 1
        }
      },
      "surfaceMuted": {
        "$description": "Inline recessed fill: inputs, tags, segmented tracks.",
        "$value": {
          "colorSpace": "hsl",
          "components": [195, 15, 94],
          "alpha": 1
        }
      },
      "surfaceElevated": {
