      "sm": { "$value": "{space.scale.2}" },
      "md": { "$value": "{space.scale.3}" },
      "lg": { "$value": "{space.scale.4}" },
      "xl": { "$value": "{space.scale.6}" },
      "2xl": { "$value": "{space.scale.8}" },
      "3xl": { "$value": "{space.scale.12}" }
