      "warning": { "$value": "{color.light.warningSurface}" },
      "info": { "$value": "{color.light.infoSurface}" }
    }
  },
  "space": {
    "$type": "dimension",
    "scale": {
      "$description": "The 4px grid. Step n is n x 4px; `0-5` is the 2px half step.",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
