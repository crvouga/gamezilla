        "$value": {
          "colorSpace": "hsl",
          "components": [0, 0, 100],
          "alpha": 1
        }
      },
      "surfaceOverlay": {
        "$description": "Floating above content: popovers, menus.",
        "$value": {
          "colorSpace": "hsl",
          "components": [0, 0, 100],
          "alpha": 1
        }
