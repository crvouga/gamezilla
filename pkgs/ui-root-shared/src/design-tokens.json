  "tone": {
    "$type": "color",
    "$description": "Color roles a component prop may name. An alias points at the light entry of the role it names; the rendered color is that role in the active scheme.",
    "text": {
      "default": { "$value": "{color.light.text}" },
      "secondary": { "$value": "{color.light.textSecondary}" },
      "tint": { "$value": "{color.light.tint}" },
      "destructive": { "$value": "{color.light.destructive}" },
