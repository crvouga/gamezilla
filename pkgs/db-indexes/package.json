{
  "name": "@pkgs/db-indexes",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "mutants": "bun tests/mutants/scripted-mutants.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests",
    "test:e2e": "bun run ../../libs/sim-harness/scripts/test-e2e.ts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "node-sql-parser": "catalog:"
  },
  "devDependencies": {
    "@pkgs/gherkin": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@pkgs/quint": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "specDomains": [
    "index-tuning"
  ]
}
