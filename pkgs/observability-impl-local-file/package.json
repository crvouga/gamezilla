{
  "name": "@pkgs/observability-impl-local-file",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "collector": "bun run src/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "summarize": "bun run src/summarize-cli.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
