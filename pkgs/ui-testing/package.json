{
  "name": "@pkgs/ui-testing",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/*.ts",
      "./src/*/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test src --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
