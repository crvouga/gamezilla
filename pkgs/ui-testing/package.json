{
  "name": "@pkgs/ui-testing",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/*.ts",
      "./src/*/*.tsx",
      "./src/*/*/index.ts",
      "./src/*/*/*.ts",
      "./src/*/*/*.tsx"
    ]
  },
  "scripts": {
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test src/core src/selector src/drivers/playwright src/drivers/detox --pass-with-no-tests && bunx jest --config ./jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@pkgs/clock": "workspace:*",
    "@pkgs/io": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-test-renderer": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "@typescript/native": "catalog:",
    "expo": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "typescript": "catalog:"
  }
}
