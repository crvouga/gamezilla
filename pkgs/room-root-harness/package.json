{
  "name": "@pkgs/room-root-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "bench": "bun tests/hot-paths.bench.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepare:spec": "bun run --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client/register ../../libs/harness/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1",
    "verify:models": "bun run ../../libs/tools/scripts/verify-models.ts"
  },
  "dependencies": {
    "@pkgs/attribute-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/message-shared": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@pkgs/room-adapter-memory-shared": "workspace:*",
    "@pkgs/room-root-client": "workspace:*",
    "@pkgs/room-root-server": "workspace:*",
    "@pkgs/room-root-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/gherkin-shared": "workspace:*",
    "@pkgs/keyword-shared": "workspace:*",
    "@pkgs/kv-root-shared": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "specDomains": [
    "room"
  ],
  "specParts": 1
}
