{
  "name": "@pkgs/llm",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server": "./src/server/index.ts",
    "./client/llm-context": "./src/client/llm-context.tsx",
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./shared/adapters/*": [
      "./src/shared/adapters/*.ts"
    ],
    "./solid": "./src/solid/index.tsx"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/kv-postgres": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
