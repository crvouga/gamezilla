{
  "name": "@gamezilla/tts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server": "./src/server/index.ts",
    "./client/tts-context": "./src/client/tts-context.tsx",
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "tc": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@gamezilla/assert": "workspace:*",
    "@gamezilla/object-store": "workspace:*",
    "@gamezilla/secret-store": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "expo-audio": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
