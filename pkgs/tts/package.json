{
  "name": "@pkgs/tts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server": "./src/server/index.ts",
    "./client/tts-context": "./src/client/tts-context.tsx",
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./solid": "./src/client/solid.tsx"
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
