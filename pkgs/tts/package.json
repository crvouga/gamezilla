{
  "name": "@pkgs/tts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server": "./src/server/index.ts",
    "./client/tts-context": "./src/client/tts-context.tsx",
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./solid": "./src/client/solid.tsx"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
