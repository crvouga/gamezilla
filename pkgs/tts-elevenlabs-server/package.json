{
  "name": "@pkgs/tts-elevenlabs-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json"
  },
  "dependencies": {
    "@pkgs/object-store-shared": "workspace:*",
    "@pkgs/secret-store-shared": "workspace:*",
    "@pkgs/tts-elevenlabs-shared": "workspace:*",
    "@pkgs/tts-server": "workspace:*",
    "@pkgs/tts-shared": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
