{
  "name": "@pkgs/postgres-mockingbird-server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@crvouga/mockingbird-service-postgres": "catalog:",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/object-store-root-shared": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/postgres-local-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "server"
}
