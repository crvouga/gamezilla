{
  "name": "@pkgs/turn-game-shared-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/uuid-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "isomorphic",
  "gameApi": [
    "game-automation",
    "game-frame",
    "game-presentation",
    "game-puzzles",
    "game-rules",
    "puzzle-content",
    "puzzle-content-catalog",
    "simulation",
    "game-simulation"
  ],
  "language": "typescript"
}
