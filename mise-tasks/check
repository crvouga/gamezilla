#!/usr/bin/env bash
#MISE description="Run cached typecheck, lint and unit tests for a workspace package"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
if [[ $# != 1 || ! "$1" =~ ^@(apps|libs|pkgs)/[a-z0-9-]+$ ]]; then
  echo "usage: mise run check -- @scope/package" >&2
  exit 2
fi
exec bun x --no-install turbo run tc lint test "--filter=$1"
