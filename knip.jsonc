{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "actionlint",
    "doppler",
    "gitleaks",
    "lsof",
    "pkill",
    "wrangler",
  ],
  "ignore": [
    "**/*.bench.ts",
    "packages/client/babel.config.js",
    "packages/client/scripts/shims/**",
    "packages/lib/src/sql-client/absurd-sql-db.worker.ts",
    "packages/lib/src/ts-reset.ts",
    "packages/eslint-rules/**/*.cjs",
    "lingui.config.cjs",
    "packages/infra/src/cli/secrets/planetscale.ts",
    "packages/infra/src/cli/secrets/turbo-token.ts",
    "packages/client/src/connection/offline-indicator.tsx",
  ],
  "ignoreDependencies": [
    "expo-updates",
    "@react-navigation/bottom-tabs",
    "@react-navigation/elements",
    // `packages/client/scripts/bundle-skia-canvaskit-wasm.ts` uses createRequire only.
    "@shopify/react-native-skia",
    "absurd-sql",
    "canvaskit-wasm",
    "expo-font",
    "expo-image",
    "expo-linear-gradient",
    "expo-status-bar",
    "make-plural",
    "@jlongster/sql.js",
    "sql.js",
    "buffer",
    "@gorhom/bottom-sheet",
    "@lingui/core",
    "expo",
    "expo-sqlite",
    "react-dom",
    "react-native-web",
    "@lingui/react",
    "react-native",
    "react-native-svg",
    "eslint-plugin-naming",
    "wrangler",
    "@lingui/conf",
    "@total-typescript/ts-reset",
    "turbo",
    "typescript-eslint",
    "@gamezilla/api",
    "@gamezilla/chess",
    "@gamezilla/profile",
  ],
  "workspaces": {
    ".": {
      "entry": ["package.json", "scripts/*.ts"],
    },
    "packages/stripe-cli": {
      "entry": "src/dev.ts",
    },
    "packages/qa": {
      "entry": "src/browser/playwright.config.ts",
    },
  },
}
