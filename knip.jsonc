{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "actionlint",
    "infisical",
    "gitleaks",
    "lsof",
    "pkill",
    "wrangler"
  ],
  "ignore": [
    "**/*.bench.ts",
    "apps/client/babel.config.js",
    "pkgs/eslint-rules/**/*.cjs",
    "lingui.config.ts",
    "libs/infra/src/cli/secrets/planetscale.ts",
    "apps/client/src/connection/offline-indicator.tsx"
  ],
  "ignoreDependencies": [
    "expo-updates",
    "@react-navigation/bottom-tabs",
    "@react-navigation/elements",
    // `apps/client/scripts/bundle-skia-canvaskit-wasm.ts` uses createRequire only.
    "@shopify/react-native-skia",
    "canvaskit-wasm",
    "expo-font",
    "expo-image",
    "expo-linear-gradient",
    "expo-status-bar",
    "make-plural",
    "buffer",
    "@gorhom/bottom-sheet",
    "@lingui/core",
    "expo",
    "expo-sqlite",
    "react-dom",
    "react-native-web",
    "@lingui/react",
    "react-native",
    "react-native-svg",
    "eslint-plugin-naming",
    "wrangler",
    "@lingui/conf",
    "@total-typescript/ts-reset",
    "turbo",
    "typescript-eslint",
    "@apps/server",
    "@pkgs/assistant",
    "@libs/chess",
    "@libs/profile",
    "@libs/spaces",
    "@pkgs/assert"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "eslint.config.mjs",
        "lingui.config.ts",
        "lingui.solid.config.ts",
        "tools/scripts/*.ts",
        "tools/*.ts"
      ]
    },
    "apps/client": {
      "entry": [
        "src/main.tsx",
        "src/integration/*.test.ts",
        "vite.config.mts",
        "vitest.config.mts",
        "tests/support/*.ts"
      ]
    },
    "libs/object-store": {
      "entry": "src/scripts/provision.ts"
    },
    "libs/pubsub": {
      "entry": "src/scripts/provision.ts"
    }
  }
}
