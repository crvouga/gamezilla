{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["actionlint", "gitleaks", "lsof", "pkill", "wrangler"],
  "ignore": [
    "**/*.bench.ts",
    "apps/client/babel.config.js",
    "apps/client/public/**/*.worker.js",
    "apps/client/scripts/shims/**",
    "libs/lib/src/sql-client/absurd-sql-db.worker.ts",
    "libs/lib/src/ts-reset.ts",
    "libs/eslint-rules/**/*.cjs",
    "lingui.config.cjs",
    "apps/infra/src/cli/secrets/planetscale.ts",
    "apps/infra/src/cli/secrets/turbo-token.ts",
    "apps/client/src/auth/fetch-client-runtime-config.ts",
    "apps/client/src/connection/offline-indicator.tsx",
    "apps/client/src/profile/profile-actions.ts",
  ],
  "ignoreDependencies": [
    "expo-updates",
    "@react-navigation/bottom-tabs",
    "@react-navigation/elements",
    "absurd-sql",
    "canvaskit-wasm",
    "expo-font",
    "expo-haptics",
    "expo-image",
    "expo-linear-gradient",
    "expo-status-bar",
    "make-plural",
    "@jlongster/sql.js",
    "sql.js",
    "buffer",
    "@gorhom/bottom-sheet",
    "@lingui/core",
    "expo",
    "expo-sqlite",
    "react-dom",
    "react-native-web",
    "@lingui/react",
    "react-native",
    "react-native-svg",
    "eslint-plugin-naming",
    "wrangler",
    "@lingui/conf",
    "@total-typescript/ts-reset",
    "eslint-plugin-lingui",
    "turbo",
    "typescript-eslint",
  ],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
    },
    "apps/stripe-cli": {
      "entry": "src/dev.ts",
    },
    "apps/qa": {
      "entry": "src/browser/playwright.config.ts",
    },
  },
}
