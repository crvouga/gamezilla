{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "actionlint",
    "infisical",
    "gitleaks",
    "lsof",
    "pkill",
    "wrangler"
  ],
  "ignore": [
    "**/*.bench.ts",
    "apps/client/babel.config.js",
    "pkgs/eslint-rules/**/*.cjs",
    "lingui.config.ts",
    "libs/infra/src/cli/secrets/planetscale.ts",
    "apps/client/src/connection/offline-indicator.tsx"
  ],
  "ignoreDependencies": [
    "make-plural",
    "buffer",
    "@lingui/core",
    "eslint-plugin-naming",
    "wrangler",
    "@lingui/conf",
    "@total-typescript/ts-reset",
    "turbo",
    "typescript-eslint",
    "@apps/server",
    "@pkgs/assistant",
    "@libs/chess",
    "@libs/profile",
    "@libs/spaces",
    "@pkgs/assert"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "eslint.config.mjs",
        "lingui.config.ts",
        "lingui.solid.config.ts"
      ]
    },
    "apps/client": {
      "entry": [
        "src/main.tsx",
        "src/integration/*.test.ts",
        "vite.config.mts",
        "vitest.config.mts"
      ]
    },
    "libs/object-store": {
      "entry": "src/scripts/provision.ts"
    },
    "libs/pubsub": {
      "entry": "src/scripts/provision.ts"
    },
    "libs/tools": {
      "entry": ["package.json", "scripts/**/*.ts"]
    },
    "pkgs/chess-board": {
      "entry": [
        "e2e/run-e2e.ts",
        "e2e/tests/*.test.ts",
        "e2e/harness/browser-entry.tsx"
      ]
    }
  }
}
