{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./packages/app/src/*"],
      "@gamezilla/shared/*": ["./packages/shared/src/*"],
      "@gamezilla/patch-db/*": ["./packages/patch-db/src/*"],
      "@gamezilla/peer-store/*": ["./packages/peer-store/src/*"],
      "@gamezilla/patch-db-app/*": ["./packages/patch-db-app/src/*"],
      "@gamezilla/peer-store-app/*": ["./packages/peer-store-app/src/*"]
    }
  },
  "include": [
    "packages/app/src/**/*.ts",
    "packages/app/src/**/*.tsx",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/patch-db/src/**/*.ts",
    "packages/patch-db/src/**/*.tsx",
    "packages/peer-store/src/**/*.ts",
    "packages/peer-store/src/**/*.tsx",
    "packages/patch-db-app/src/**/*.ts",
    "packages/patch-db-app/src/**/*.tsx",
    "packages/peer-store-app/src/**/*.ts",
    "packages/peer-store-app/src/**/*.tsx",
    "packages/app/.expo/types/**/*.ts",
    "packages/app/expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-build",
    "packages/aws/dist",
    "packages/aws/cdk.out",
    "packages/aws/lib",
    "packages/aws/bin/app.ts"
  ]
}
