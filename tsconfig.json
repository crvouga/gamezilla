{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@gamezilla/api/*": ["./apps/api/src/*"],
      "@gamezilla/client/*": ["./apps/client/src/*"],
      "@gamezilla/lib/*": ["./libs/lib/src/*"],
      "@gamezilla/patch-db/*": ["./libs/patch-db/src/*"],
      "@gamezilla/room": ["./libs/room/src/index.ts"],
      "@gamezilla/room/server": ["./libs/room/src/server.ts"],
      "@gamezilla/room/*": ["./libs/room/src/*"],
      "@gamezilla/patch-db-example/*": ["./libs/patch-db-example/src/*"],
      "@gamezilla/room-example/*": ["./libs/room-example/src/*"],
      "@gamezilla/stripe/*": ["./libs/stripe/src/*"],
      "@gamezilla/chess/*": ["./libs/chess/src/*"],
      "@gamezilla/profile/*": ["./libs/profile/src/*"],
      "@gamezilla/auth/*": ["./libs/auth/src/*"],
      "@gamezilla/spaces/*": ["./libs/spaces/src/*"],
      "@gamezilla/client-config/*": ["./libs/client-config/src/*"]
    }
  },
  "include": [
    "libs/lib/src/ts-reset.ts",
    "apps/api/src/**/*.ts",
    "apps/api/src/**/*.d.ts",
    "apps/client/src/**/*.ts",
    "apps/client/src/**/*.tsx",
    "libs/lib/src/**/*.ts",
    "libs/lib/src/**/*.tsx",
    "libs/patch-db/src/**/*.ts",
    "libs/patch-db/src/**/*.tsx",
    "libs/room/src/**/*.ts",
    "libs/room/src/**/*.tsx",
    "libs/patch-db-example/src/**/*.ts",
    "libs/patch-db-example/src/**/*.tsx",
    "libs/room-example/src/**/*.ts",
    "libs/room-example/src/**/*.tsx",
    "libs/stripe/src/**/*.ts",
    "libs/chess/src/**/*.ts",
    "libs/chess/src/**/*.tsx",
    "libs/chess/scripts/**/*.ts",
    "libs/profile/src/**/*.ts",
    "libs/profile/src/**/*.tsx",
    "libs/auth/src/**/*.ts",
    "libs/auth/src/**/*.tsx",
    "libs/spaces/src/**/*.ts",
    "libs/spaces/src/**/*.tsx",
    "libs/client-config/src/**/*.ts",
    "libs/client-config/src/**/*.tsx",
    "libs/client-config/scripts/**/*.ts",
    "apps/turbo-cache/src/**/*.ts",
    "apps/stripe-cli/src/**/*.ts",
    "apps/pg/src/**/*.ts",
    "apps/client/.expo/types/**/*.ts",
    "apps/client/expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "web-build"]
}
