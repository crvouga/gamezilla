      "@pkgs/pub-sub/*": ["./pkgs/pub-sub/src/*"],
      "@pkgs/async/*": ["./pkgs/async/src/*"],
      "@pkgs/object-store/*": ["./pkgs/object-store/src/*"],
      "@pkgs/secure-storage": ["./pkgs/secure-storage/src/index.ts"],
      "@pkgs/secure-storage/*": ["./pkgs/secure-storage/src/*"],
      "@pkgs/secret-store": ["./pkgs/secret-store/src/index.ts"],
