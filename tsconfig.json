    "libs/friends/src/**/*.ts",
    "libs/friends/src/**/*.tsx",
    "libs/search/src/**/*.ts",
    "libs/search/src/**/*.tsx",
    "libs/profile/src/**/*.ts",
    "libs/profile/src/**/*.tsx",
    "libs/auth/src/**/*.ts",
    "libs/auth/src/**/*.tsx",
    "libs/integration-test/src/**/*.ts",
    "libs/integration-test/scripts/**/*.ts",
    "libs/integration-test/playwright/**/*.ts",
    "libs/integration-test/e2e/**/*.ts",
    "libs/spaces/src/**/*.ts",
    "libs/spaces/src/**/*.tsx",
    "pkgs/tts/src/**/*.ts",
