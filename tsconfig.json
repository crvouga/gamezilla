{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./packages/client/src/*"],
      "@gamezilla/shared/*": ["./packages/shared/src/*"],
      "@gamezilla/patch-db/*": ["./packages/patch-db/src/*"],
      "@gamezilla/peer-store/*": ["./packages/peer-store/src/*"],
      "@gamezilla/patch-db-app/*": ["./packages/patch-db-app/src/*"],
      "@gamezilla/peer-store-app/*": ["./packages/peer-store-app/src/*"]
    }
  },
  "include": [
    "packages/api/src/**/*.ts",
    "packages/client/src/**/*.ts",
    "packages/client/src/**/*.tsx",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/patch-db/src/**/*.ts",
    "packages/patch-db/src/**/*.tsx",
    "packages/peer-store/src/**/*.ts",
    "packages/peer-store/src/**/*.tsx",
    "packages/patch-db-app/src/**/*.ts",
    "packages/patch-db-app/src/**/*.tsx",
    "packages/peer-store-app/src/**/*.ts",
    "packages/peer-store-app/src/**/*.tsx",
    "packages/turbo-cache/src/**/*.ts",
    "packages/client/.expo/types/**/*.ts",
    "packages/client/expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-build"
  ]
}
