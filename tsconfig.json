{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./packages/app/src/*"],
      "@gamezilla/shared/*": ["./packages/shared/*"],
      "@gamezilla/patch-db/*": ["./packages/patch-db/*"]
    }
  },
  "include": [
    "packages/app/src/**/*.ts",
    "packages/app/src/**/*.tsx",
    "packages/shared/**/*.ts",
    "packages/shared/**/*.tsx",
    "packages/patch-db/**/*.ts",
    "packages/patch-db/**/*.tsx",
    "packages/app/.expo/types/**/*.ts",
    "packages/app/expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-build",
    "packages/aws/dist",
    "packages/aws/cdk.out",
    "packages/aws/lib",
    "packages/aws/bin/app.ts",
    "packages/patch-db-app"
  ]
}
