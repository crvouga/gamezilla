  "include": [
    "pkgs/ts-reset/src/index.ts",
    "apps/api/src/**/*.ts",
    "apps/api/src/**/*.d.ts",
    "apps/client/src/**/*.ts",
    "apps/client/src/**/*.tsx",
    "pkgs/llm/src/**/*.ts",
    "pkgs/llm/src/**/*.tsx",
