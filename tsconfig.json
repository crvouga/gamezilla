    "pkgs/sql-client/src/**/*.tsx",
    "pkgs/sql-cli/src/**/*.ts",
    "pkgs/sql-cli/src/**/*.tsx",
    "pkgs/kv/src/**/*.ts",
    "pkgs/observability/src/**/*.ts",
    "pkgs/observability/src/**/*.tsx",
    "pkgs/distributed-lock/src/**/*.ts",
    "pkgs/ndjson/src/**/*.ts",
    "pkgs/os/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "web-build"]
}
