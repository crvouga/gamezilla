    "pkgs/uuid/src/**/*.ts",
    "pkgs/sql/src/**/*.ts",
    "pkgs/sqlite/src/**/*.ts",
    "pkgs/pub-sub/src/**/*.ts",
    "pkgs/async/src/**/*.ts",
    "pkgs/object-store/src/**/*.ts",
    "pkgs/object-store/src/**/*.tsx",
    "pkgs/secure-storage/src/**/*.ts",
    "pkgs/secret-store/src/**/*.ts",
    "pkgs/secret-string/src/**/*.ts",
    "pkgs/static-file-server/src/**/*.ts",
    "pkgs/task-dag/src/**/*.ts",
    "pkgs/attribute/src/**/*.ts",
    "pkgs/message/src/**/*.ts",
    "pkgs/write/src/**/*.ts",
