{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./apps/client/src/*"],
      "@gamezilla/shared/*": ["./libs/shared/src/*"],
      "@gamezilla/patch-db/*": ["./libs/patch-db/src/*"],
      "@gamezilla/peer-store/*": ["./libs/peer-store/src/*"],
      "@gamezilla/patch-db-example/*": ["./libs/patch-db-example/src/*"],
      "@gamezilla/peer-store-example/*": ["./libs/peer-store-example/src/*"]
    }
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/client/src/**/*.ts",
    "apps/client/src/**/*.tsx",
    "libs/shared/src/**/*.ts",
    "libs/shared/src/**/*.tsx",
    "libs/patch-db/src/**/*.ts",
    "libs/patch-db/src/**/*.tsx",
    "libs/peer-store/src/**/*.ts",
    "libs/peer-store/src/**/*.tsx",
    "libs/patch-db-example/src/**/*.ts",
    "libs/patch-db-example/src/**/*.tsx",
    "libs/peer-store-example/src/**/*.ts",
    "libs/peer-store-example/src/**/*.tsx",
    "apps/turbo-cache/src/**/*.ts",
    "apps/client/.expo/types/**/*.ts",
    "apps/client/expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "web-build"]
}
