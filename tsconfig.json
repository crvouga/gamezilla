      "@pkgs/colors": ["./pkgs/colors/src/index.ts"],
      "@pkgs/colors/*": ["./pkgs/colors/src/*"],
      "@pkgs/uuid": ["./pkgs/uuid/src/index.ts"],
      "@pkgs/uuid/*": ["./pkgs/uuid/src/*"],
      "@pkgs/sql": ["./pkgs/sql/src/index.ts"],
      "@pkgs/sql/*": ["./pkgs/sql/src/*"],
      "@pkgs/sqlite": ["./pkgs/sqlite/src/index.ts"],
