<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="unfinished-game-limit-decisions" name="The unfinished matched game limit" namespace="urn:product:decisions">
  <decision id="unfinished-game-limit" name="May this account start another matched game?">
    <description>An account may seek an opponent for a new matched game, in any game, only after its earlier matched game is over or aborted, and only while it is not a participant of a custom game under way. A matched game that is over or aborted no longer counts as unfinished. The account requirement is decided separately by access. Free accounts and Plus members have the same limit of one unfinished matched game.</description>
    <decisionTable id="unfinished-game-limit-table" hitPolicy="UNIQUE">
      <input id="who" label="who is asking">
        <inputExpression id="who-expression" typeRef="string"><text>who is asking</text></inputExpression>
        <inputValues id="who-values"><text>"free account","Plus member"</text></inputValues>
      </input>
      <input id="unfinished" label="unfinished matched games">
        <inputExpression id="unfinished-expression" typeRef="number"><text>unfinished matched games</text></inputExpression>
        <inputValues id="unfinished-values"><text>[0..2]</text></inputValues>
      </input>
      <input id="custom" label="custom games under way as a participant">
        <inputExpression id="custom-expression" typeRef="number"><text>custom games under way as a participant</text></inputExpression>
        <inputValues id="custom-values"><text>[0..1]</text></inputValues>
      </input>
      <output id="answer" name="answer" typeRef="string">
        <outputValues id="answer-values"><text>"yes","no"</text></outputValues>
      </output>
      <output id="reason" name="reason" typeRef="string">
        <outputValues id="reason-values"><text>"none","finish the current matched game","finish the current custom game"</text></outputValues>
      </output>
      <rule id="no-unfinished-game">
        <description>An account without an unfinished matched game or custom game may seek an opponent.</description>
        <inputEntry id="no-unfinished-game-in-1"><text>-</text></inputEntry>
        <inputEntry id="no-unfinished-game-in-2"><text>&lt; 1</text></inputEntry>
        <inputEntry id="no-unfinished-game-in-3"><text>&lt; 1</text></inputEntry>
        <outputEntry id="no-unfinished-game-out-1"><text>"yes"</text></outputEntry>
        <outputEntry id="no-unfinished-game-out-2"><text>"none"</text></outputEntry>
      </rule>
      <rule id="finish-first">
        <description>An account with an unfinished matched game must finish it first.</description>
        <inputEntry id="finish-first-in-1"><text>-</text></inputEntry>
        <inputEntry id="finish-first-in-2"><text>&gt;= 1</text></inputEntry>
        <inputEntry id="finish-first-in-3"><text>-</text></inputEntry>
        <outputEntry id="finish-first-out-1"><text>"no"</text></outputEntry>
        <outputEntry id="finish-first-out-2"><text>"finish the current matched game"</text></outputEntry>
      </rule>
      <rule id="finish-custom-game-first">
        <description>A participant of a custom game under way must finish it first.</description>
        <inputEntry id="finish-custom-game-first-in-1"><text>-</text></inputEntry>
        <inputEntry id="finish-custom-game-first-in-2"><text>&lt; 1</text></inputEntry>
        <inputEntry id="finish-custom-game-first-in-3"><text>&gt;= 1</text></inputEntry>
        <outputEntry id="finish-custom-game-first-out-1"><text>"no"</text></outputEntry>
        <outputEntry id="finish-custom-game-first-out-2"><text>"finish the current custom game"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
