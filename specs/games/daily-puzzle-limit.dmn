<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="daily-puzzle-limit-decisions" name="The daily puzzle limit" namespace="urn:product:decisions">
  <decision id="daily-puzzle-limit" name="May this person start another rated puzzle today?">
    <description>A guest starts at most 20 rated puzzles a day, and the day starts again at midnight UTC; puzzles started before today never count. The daily puzzle limit is one allowance for every game offering puzzles: rated puzzles a guest starts today in any of those games count toward the same 20. Free accounts and Plus members have no daily puzzle limit.</description>
    <decisionTable id="daily-puzzle-limit-table" hitPolicy="UNIQUE">
      <input id="who" label="who is asking">
        <inputExpression id="who-expression" typeRef="string"><text>who is asking</text></inputExpression>
        <inputValues id="who-values"><text>"guest","free account","Plus member"</text></inputValues>
      </input>
      <input id="today" label="rated puzzles started today">
        <inputExpression id="today-expression" typeRef="number"><text>rated puzzles started today</text></inputExpression>
        <inputValues id="today-values"><text>[0..100]</text></inputValues>
      </input>
      <input id="earlier" label="rated puzzles started before today">
        <inputExpression id="earlier-expression" typeRef="number"><text>rated puzzles started before today</text></inputExpression>
        <inputValues id="earlier-values"><text>[0..100]</text></inputValues>
      </input>
      <output id="answer" name="answer" typeRef="string">
        <outputValues id="answer-values"><text>"yes","no"</text></outputValues>
      </output>
      <output id="reason" name="reason" typeRef="string">
        <outputValues id="reason-values"><text>"none","daily puzzle limit reached"</text></outputValues>
      </output>
      <rule id="guest-below-limit">
        <description>A guest who started fewer than 20 rated puzzles today, across every game offering puzzles, may start another.</description>
        <inputEntry id="guest-below-limit-in-1"><text>"guest"</text></inputEntry>
        <inputEntry id="guest-below-limit-in-2"><text>&lt; 20</text></inputEntry>
        <inputEntry id="guest-below-limit-in-3"><text>-</text></inputEntry>
        <outputEntry id="guest-below-limit-out-1"><text>"yes"</text></outputEntry>
        <outputEntry id="guest-below-limit-out-2"><text>"none"</text></outputEntry>
      </rule>
      <rule id="guest-at-limit">
        <description>A guest who started 20 rated puzzles today, across every game offering puzzles, has reached the daily puzzle limit.</description>
        <inputEntry id="guest-at-limit-in-1"><text>"guest"</text></inputEntry>
        <inputEntry id="guest-at-limit-in-2"><text>&gt;= 20</text></inputEntry>
        <inputEntry id="guest-at-limit-in-3"><text>-</text></inputEntry>
        <outputEntry id="guest-at-limit-out-1"><text>"no"</text></outputEntry>
        <outputEntry id="guest-at-limit-out-2"><text>"daily puzzle limit reached"</text></outputEntry>
      </rule>
      <rule id="accounts-unlimited">
        <description>Free accounts and Plus members have no daily puzzle limit.</description>
        <inputEntry id="accounts-unlimited-in-1"><text>"free account","Plus member"</text></inputEntry>
        <inputEntry id="accounts-unlimited-in-2"><text>-</text></inputEntry>
        <inputEntry id="accounts-unlimited-in-3"><text>-</text></inputEntry>
        <outputEntry id="accounts-unlimited-out-1"><text>"yes"</text></outputEntry>
        <outputEntry id="accounts-unlimited-out-2"><text>"none"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
