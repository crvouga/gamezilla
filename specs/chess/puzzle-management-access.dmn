<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="puzzle-management-access-decisions" name="Puzzle management access" namespace="urn:product:decisions">
  <decision id="puzzle-management-access" name="May this person manage puzzles?">
    <description>Only a signed-in person on the team for this environment may check or save the Lichess file, add puzzles or stop adding puzzles.</description>
    <decisionTable id="puzzle-management-access-table" hitPolicy="UNIQUE">
      <input id="signed-in" label="signed in">
        <inputExpression id="signed-in-expression" typeRef="string"><text>signed in</text></inputExpression>
        <inputValues id="signed-in-values"><text>"yes","no"</text></inputValues>
      </input>
      <input id="on-team" label="on the team for this environment">
        <inputExpression id="on-team-expression" typeRef="string"><text>on the team for this environment</text></inputExpression>
        <inputValues id="on-team-values"><text>"yes","no"</text></inputValues>
      </input>
      <output id="answer" name="answer" typeRef="string">
        <outputValues id="answer-values"><text>"yes","no"</text></outputValues>
      </output>
      <output id="reason" name="reason" typeRef="string">
        <outputValues id="reason-values"><text>"none","needs an account","not on the team"</text></outputValues>
      </output>
      <rule id="team-account-adds-puzzles">
        <description>A signed-in person on the team may check or save the Lichess file, add puzzles or stop adding puzzles.</description>
        <inputEntry id="team-account-adds-puzzles-in-1"><text>"yes"</text></inputEntry>
        <inputEntry id="team-account-adds-puzzles-in-2"><text>"yes"</text></inputEntry>
        <outputEntry id="team-account-adds-puzzles-out-1"><text>"yes"</text></outputEntry>
        <outputEntry id="team-account-adds-puzzles-out-2"><text>"none"</text></outputEntry>
      </rule>
      <rule id="account-outside-team-cannot-add-puzzles">
        <description>A signed-in person outside the team cannot check or save the Lichess file, add puzzles or stop adding puzzles.</description>
        <inputEntry id="account-outside-team-cannot-add-puzzles-in-1"><text>"yes"</text></inputEntry>
        <inputEntry id="account-outside-team-cannot-add-puzzles-in-2"><text>"no"</text></inputEntry>
        <outputEntry id="account-outside-team-cannot-add-puzzles-out-1"><text>"no"</text></outputEntry>
        <outputEntry id="account-outside-team-cannot-add-puzzles-out-2"><text>"not on the team"</text></outputEntry>
      </rule>
      <rule id="guest-cannot-add-puzzles">
        <description>A person without an account cannot check or save the Lichess file, add puzzles or stop adding puzzles.</description>
        <inputEntry id="guest-cannot-add-puzzles-in-1"><text>"no"</text></inputEntry>
        <inputEntry id="guest-cannot-add-puzzles-in-2"><text>-</text></inputEntry>
        <outputEntry id="guest-cannot-add-puzzles-out-1"><text>"no"</text></outputEntry>
        <outputEntry id="guest-cannot-add-puzzles-out-2"><text>"needs an account"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
