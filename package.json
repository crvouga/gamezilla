{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "pkgs/*"
  ],
  "scripts": {
    "check": "bun run check:static && bun run check:ci",
    "check:actionlint": "actionlint -color",
    "check:ci": "bun run check:ci:turbo && bun run check:ci:build",
    "check:ci:build": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- bun run scripts/turbo-ci-run.ts build --filter='!@apps/client'",
    "check:ci:turbo": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- sh -c 'bun run scripts/check-turbo-remote-cache.ts && bun run --filter @apps/client setup && bun run scripts/turbo-ci-run.ts ci:syncpack ci:knip ci:depcruise ci:circular-deps ci:tier-imports ci:audit ci:i18n tc lint test'",
    "check:deployment-pipeline": "bun run libs/infra/src/bin/run-deployment-pipeline-checks.ts",
    "check:gitleaks": "gitleaks detect --redact --verbose --no-banner --log-opts=-1",
    "check:no-patches": "bun run scripts/check-no-patches.ts",
    "check:static": "bun run check:actionlint && bun run check:gitleaks",
    "check:turbo-remote-cache": "DOPPLER_CONFIG=local doppler run -- bun run scripts/check-turbo-remote-cache.ts",
    "chess:puzzles:seed": "bun run --filter @libs/chess seed:puzzles",
    "ci:audit": "bun run scripts/ci-audit.ts",
    "ci:circular-deps": "bun run scripts/check-circular-deps.ts",
    "ci:depcruise": "NODE_OPTIONS=--max-old-space-size=16384 dependency-cruise apps libs pkgs --validate .dependency-cruiser.cjs --output-type err",
    "ci:format": "prettier --check .",
    "ci:i18n": "lingui extract && bun run i18n:compile && git diff --exit-code -- apps/client/src/i18n pkgs/patch-db-example/src/i18n pkgs/room-example/src/i18n",
    "ci:knip": "knip --no-progress -c knip.jsonc --exclude exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates",
    "ci:syncpack": "syncpack lint --dependency-types prod,dev && bun run scripts/check-catalog-deps.ts && bun run scripts/check-no-patches.ts",
    "ci:tier-imports": "bun run scripts/check-tier-imports.ts",
    "db:drop": "bun run --filter @pkgs/postgres drop",
    "db:migrate": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- bun run --filter @apps/api db:migrate",
    "deps:graph": "bun run scripts/render-package-deps-graph.ts",
    "dev": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- turbo dev --ui=tui",
    "format": "sort-package-json && prettier --write .",
    "gh": "bun x open https://github.com/crvouga/gamezilla/actions/workflows/deployment-pipeline.yml",
    "i18n:compile": "lingui compile --typescript && bun run scripts/ensure-trailing-newline.ts apps/client/src/i18n/locales/en/messages.ts",
    "i18n:extract": "lingui extract",
    "infra": "DOPPLER_PROJECT=gamezilla DOPPLER_CONFIG=prod bun run libs/infra/src/bin/cli.ts",
    "preview": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- turbo run preview --filter=@pkgs/postgres --filter=@apps/api --filter=@apps/client",
    "pw": "bun run --filter '@libs/qa' browser",
    "pw:headed": "bun run --filter '@libs/qa' browser:headed",
    "pw:ui": "bun run --filter '@libs/qa' browser:ui",
    "qa": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- turbo run qa --filter=@libs/qa",
    "qa:api": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- bun run --filter '@libs/qa' api",
    "qa:browser": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID DOPPLER_CONFIG=local doppler run -- bun run --filter '@libs/qa' browser",
    "stripe:check": "bun run --filter '@libs/stripe' check",
    "stripe:listen": "bun run --filter '@libs/stripe-cli' dev",
    "stripe:sync": "bun run --filter '@libs/stripe' sync",
    "wipe": "git clean -xfd"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "fast-uri": "^3.1.2",
    "js-cookie": "^3.0.7",
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/conf": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "expo": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "sort-package-json": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@better-auth/core": "^1.6.9",
    "@better-auth/expo": "^1.6.9",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.0.21",
