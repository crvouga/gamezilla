    "gc": "turbo run //#task:gc --",
    "generate": "turbo run @pkgs/object-store-s3-server#generate:browser @libs/infra-shared#generate:infra-map //#task:i18n:compile //#task:spec:catalog //#task:spec:inputs",
    "gh": "turbo run //#task:gh --",
    "git-sync": "turbo run //#task:git-sync --",
    "health": "turbo run //#task:health --",
