    "task:i18n:extract": "lingui extract --clean --overwrite",
    "task:infra:destroy": "bun run libs/infra-server/scripts/destroy-env.ts",
    "task:inspect": "bun run libs/infra-server/scripts/inspect.ts",
    "task:install-system": "bun run libs/tools/scripts/install-system.ts",
    "task:kill": "bun run libs/tools/scripts/kill-dev-stack.ts",
    "task:lint:naming": "bun run libs/tools/scripts/check-naming.ts",
    "task:naming:fix": "bun run libs/tools/scripts/fix-naming.ts",
    "task:reports:cleanup": "bun run libs/harness/scripts/report-cleanup.ts",
    "task:reports:collect": "bun run libs/harness/scripts/reports-local.ts collect",
    "task:reports:part": "bun run libs/harness/scripts/reports-local.ts part",
    "task:reports:performance": "bun run libs/harness/scripts/reports-local.ts performance",
    "task:secrets:pull": "bun run libs/secrets-server/scripts/secrets-pull.ts",
    "task:spec": "bun run libs/tools/scripts/spec-run.ts",
    "task:spec:catalog": "bun run libs/tools/scripts/spec-catalog.ts",
    "task:spec:inputs": "bun run libs/harness/scripts/spec-inputs.ts",
    "task:test:pbt:random": "bun run apps/product/scripts/test-pbt-random.ts",
    "task:wipe": "git clean -xfd",
    "task:workspace:sync": "bun run libs/tools/scripts/sync-workspace-lifecycle.ts",
    "test:pbt:random": "turbo run //#task:test:pbt:random --",
    "wipe": "turbo run //#task:wipe --",
