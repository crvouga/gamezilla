    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "serialize-javascript": "7.0.5",
    "sharp": "^0.35.4",
    "shell-quote": "^1.10.0",
    "smol-toml": "^1.8.0",
    "undici": "7.29.1",
    "ws": "^8.21.0"
  },
