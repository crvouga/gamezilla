{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "pkgs/*",
    "product/*",
    "tools"
  ],
  "scripts": {
    "billing:check": "bun run --filter @libs/billing billing:check",
    "billing:sync": "bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/billing billing:sync",
    "check": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/turbo-ci-run.ts check",
    "check:api": "bun run tools/scripts/secrets-run.ts -- bun run --filter @apps/server check:api",
    "check:ci": "echo 'deprecated: use bun check' && exit 1",
    "check:ci:build": "echo 'deprecated: use bun check' && exit 1",
    "check:ci:gates": "echo 'deprecated: use bun check' && exit 1",
    "check:ci:verify": "echo 'deprecated: use bun check' && exit 1",
    "check:client": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/turbo-ci-run.ts test:integration --filter=@apps/client",
    "check:deployment-pipeline": "bun run check:full",
    "check:full": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/turbo-ci-run.ts check:full",
    "check:gitleaks": "gitleaks detect --redact --verbose --no-banner --log-opts=-1",
    "check:heal": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/check-heal.ts",
    "check:secrets": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-secrets.ts",
    "check:secrets:validate": "bun run --filter @libs/secrets check",
    "check:static": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/turbo-ci-run.ts check:static --filter=@tools",
    "chess:puzzles:export-load": "SECRETS_ENV=prd bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/chess export:puzzles-load -- --confirm-prod",
    "chess:puzzles:seed": "bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/chess seed:puzzles",
    "ci:audit": "bun run tools/scripts/ci-audit.ts",
    "ci:depcruise": "NODE_OPTIONS=--max-old-space-size=4096 dependency-cruise apps libs pkgs product --validate .dependency-cruiser.cjs --output-type err",
    "ci:i18n": "bun run tools/scripts/ci-i18n.ts",
    "ci:knip": "knip --dependencies --files --no-progress --no-config-hints",
    "ci:purge-scan": "bun run tools/scripts/purge-scan.ts",
    "ci:setup-secrets-auth": "bun run tools/scripts/setup-ci-secrets-auth.ts",
    "ci:syncpack": "syncpack lint --dependency-types prod,dev",
    "client:ios": "bun run tools/scripts/secrets-run.ts -- bun run --filter @apps/client ios",
    "db:migrate": "bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/db migrate",
    "db:wipe:dev": "SECRETS_ENV=dev bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/db db:wipe:dev",
    "deploy": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/turbo-ci-run.ts deploy",
    "deploy:dev": "SECRETS_ENV=dev TURBO_UI=tui bun run deploy",
    "deploy:prd": "SECRETS_ENV=prd TURBO_UI=tui bun run deploy",
    "deps:graph": "bun run tools/scripts/render-package-deps-graph.ts",
    "dev": "SECRETS_ENV=dev bun run tools/scripts/secrets-run.ts -- turbo dev --ui=tui --filter=@product/console",
    "dev:client": "SECRETS_ENV=dev bun run tools/scripts/secrets-run.ts -- turbo dev --ui=stream --filter=@apps/client",
    "fc": "clear && bun run fmt && bun run check",
    "fmt": "biome format --write . & sort-package-json \"**/package.json\" -i \"**/node_modules/**\" & bun run tools/scripts/remove-empty-dirs.ts & wait",
    "gh": "bun x open https://github.com/crvouga/gamezilla/actions/workflows/deployment-pipeline.yml",
    "i18n:compile": "lingui compile --typescript --strict && bun run tools/scripts/ensure-trailing-newline.ts apps/client/src/i18n/locales/en/messages.ts",
    "i18n:extract": "lingui extract --clean --overwrite",
    "inspect": "SECRETS_ENV=prd bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/inspect.ts",
    "install:cli": "bun run --filter @tools install:cli",
    "kill": "bun run tools/scripts/kill-dev-stack.ts",
    "lint": "bun run tools/scripts/turbo-ci-run.ts lint --filter=./apps/* --filter=./libs/* --filter=./pkgs/* --filter=./product/* --filter=./tools && bun run lint:vocab && bun run lint:eslint",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:vocab": "bun run tools/scripts/check-no-removed-auth-vocab.ts",
    "pg:monitoring": "bun run tools/scripts/enable-pg-monitoring.ts",
    "preview": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/boot-embedded-postgres.ts",
    "psql": "bun ./pkgs/postgres-embedded/scripts/psql.ts",
    "scaffold:game": "bun run tools/scripts/scaffold-game.ts",
    "sims:open": "bun run tools/scripts/sims/open-sims.ts",
    "sims:setup": "bun run tools/scripts/sims/setup-sims.ts",
    "test:pbt": "bun run tools/scripts/test-pbt-random.ts",
    "test:pbt:random": "bun run tools/scripts/test-pbt-random.ts",
    "test:product": "SIM_REPORT=0 turbo test -F @product/test --force",
    "test:product:report": "SIM_REPORT=1 turbo test -F @product/test --force",
    "wipe": "git clean -xfd"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.8",
