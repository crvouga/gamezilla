    "jiti": "catalog:",
    "knip": "catalog:",
    "sort-package-json": "catalog:",
    "syncpack": "catalog:",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
