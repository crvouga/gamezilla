    "ci:goals": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:goals",
    "ci:i18n": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:i18n",
    "ci:spec-ownership": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:spec-ownership",
    "ci:specs": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:specs",
    "ci:statecharts": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:statecharts",
    "ci:syncpack": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:syncpack",
    "ci:workspace-lifecycle": "bun run libs/tools/scripts/turbo-ci-run.ts @libs/tools#ci:workspace-lifecycle",
