{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID doppler run -- turbo check build",
    "dev": "env -u CURSOR_AGENT -u CURSOR_TRACE_ID doppler run -- turbo dev",
    "format": "sort-package-json && prettier --write .",
    "format:check": "prettier --check .",
    "infra": "bun run packages/infra/src/bin/cli.ts",
    "gh": "gh run view --web"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.25.0",
    "eslint-plugin-naming": "^0.1.10",
    "expo": "~54.0.33",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "turbo": "^2.9.6",
    "typescript": "~5.9.2"
  }
}
