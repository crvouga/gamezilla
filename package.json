{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "sort-package-json && prettier --write .",
    "format:check": "prettier --check .",
    "dev:backend": "turbo run dev:req-res dev:worker --parallel"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "expo": "~54.0.33",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "turbo": "^2.8.21",
    "typescript": "~5.9.2"
  }
}
