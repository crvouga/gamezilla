{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "aws"
  ],
  "scripts": {
    "android": "expo start --android",
    "check": "clear && bun run tc && bun run lint && bun run test && echo 'All checks passed ✅'",
    "deploy": "bun run aws/bin/deployment-pipeline-cli.ts cdk-deploy && bun run aws/bin/deployment-pipeline-cli.ts deploy-apps",
    "deploy:postchecks": "bun run aws/bin/deployment-pipeline-cli.ts post-deploy",
    "deploy:prechecks": "bun run aws/bin/deployment-pipeline-cli.ts preflight",
    "deploy:summary": "bun run aws/bin/deployment-pipeline-cli.ts write-summary",
    "export:web": "expo export -p web",
    "format": "sort-package-json && prettier --write .",
    "format:check": "prettier --check .",
    "frontend:web:build": "expo export -p web",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "patch-db-app:build": "vite --config ./src/patch-db-app/vite.config.ts build",
    "patch-db-app:dev": "vite --config ./src/patch-db-app/vite.config.ts --open",
    "patch-db-app:preview": "bun run patch-db-app:build && bun run patch-db-app:serve",
    "patch-db-app:serve": "bun x serve dist",
    "preview": "bun export:web && bun run sync-server",
    "start": "expo start",
    "sync-server": "bun run src/sync-server.ts",
    "sync-server:watch": "bun --watch src/sync-server.ts",
    "tc": "tsc --noEmit",
    "test": "bun test",
    "test:fast": "SKIP_POSTGRES_TESTS=1 bun test",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1018.0",
    "@aws-sdk/client-sts": "^3.1018.0",
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-socket": "^0.0.21",
    "@formkit/auto-animate": "^0.9.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.9",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.11",
    "@types/sql.js": "^1.4.10",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-naming": "^0.1.10",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vite": "^8.0.2"
  }
}
