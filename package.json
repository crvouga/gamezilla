{
  "name": "gamezilla",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "frontend:web:build": "expo export -p web",
    "sync-server": "bun run src/sync-server.ts",
    "sync-server:watch": "bun --watch src/sync-server.ts",
    "test": "bun test",
    "viz:build": "bun run src/@shared/patch-db/test/sim/generate-sim-viz.ts",
    "viz:build:open": "bun run viz:build && bun run viz:open",
    "viz:open": "open sim-viz/index.html",
    "viz:serve": "bun run src/@shared/patch-db/test/sim/serve-sim-viz.ts",
    "viz:dev": "vite --config ./src/@shared/patch-db/test/sim/sim-viz/vite.config.ts --open",
    "test:fast": "SKIP_POSTGRES_TESTS=1 bun test",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tc": "tsc --noEmit",
    "preview": "bun export:web && bun run sync-server",
    "check": "clear && bun run tc && bun run lint && bun run test && echo 'All checks passed ✅'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-socket": "^0.0.21",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.9",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.11",
    "@types/sql.js": "^1.4.10",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-naming": "^0.1.10",
    "gsap": "^3.14.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vite": "^8.0.2"
  },
  "private": true,
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
