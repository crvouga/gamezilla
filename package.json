{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "pkgs/*"
  ],
  "scripts": {
    "agents:sync": "bun run libs/tools/scripts/sync-agent-commands.ts",
    "billing:sync": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/billing billing:sync",
    "check": "bun run libs/tools/scripts/workflow-remote.ts check",
    "check:coverage": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/tools/scripts/check-coverage.ts",
    "check:heal": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/tools/scripts/check-heal.ts",
    "check:local": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/tools/scripts/turbo-ci-run.ts check",
    "chess:puzzles:export-load": "SECRETS_ENV=prd bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/chess export:puzzles-load -- --confirm-prod",
    "chess:puzzles:seed": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/chess seed:puzzles",
    "ci:agent-commands": "bun run libs/tools/scripts/sync-agent-commands.ts --check",
    "ci:audit": "bun run libs/tools/scripts/ci-audit.ts",
    "ci:conformance": "bun run libs/tools/scripts/check-conformance.ts",
    "ci:goals": "bun run libs/tools/scripts/check-goals.ts",
    "ci:i18n": "bun run libs/tools/scripts/ci-i18n.ts",
    "ci:spec-ownership": "bun run libs/tools/scripts/check-spec-ownership.ts",
    "ci:specs": "bun run libs/tools/scripts/check-specs.ts",
    "ci:syncpack": "syncpack lint --dependency-types prod,dev",
    "ci:workspace-lifecycle": "bun run libs/tools/scripts/sync-workspace-lifecycle.ts --check",
    "conformance": "bun run libs/tools/scripts/conformance-report.ts",
    "db:migrate": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/runtime migrate",
    "db:wipe:dev": "SECRETS_ENV=dev bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/runtime db:wipe:dev",
    "deploy": "bun run libs/tools/scripts/workflow-remote.ts deploy",
    "deploy:dev": "SECRETS_ENV=dev TURBO_UI=tui bun run deploy:local",
    "deploy:local": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/tools/scripts/turbo-ci-run.ts //#deploy",
    "deploy:prd": "SECRETS_ENV=prd TURBO_UI=tui bun run deploy:local",
    "deps:graph": "bun run libs/tools/scripts/render-package-deps-graph.ts",
    "dev": "bun run --silent --cwd apps/product dev --",
    "dev:client": "SECRETS_ENV=dev bun run libs/secrets/src/scripts/secrets-run.ts -- turbo dev --ui=stream --filter=@apps/client",
    "fc": "clear && bun run fmt && bun run check",
    "fmt": "biome format --write . & sort-package-json \"**/package.json\" -i \"**/node_modules/**\" & bun run libs/tools/scripts/remove-empty-dirs.ts & wait",
    "gh": "bun x open https://github.com/crvouga/gamezilla/actions/workflows/check.yml",
    "git-sync": "bun run libs/tools/scripts/git-sync.ts",
    "health": "bun run libs/tools/scripts/workflow-remote.ts health",
    "health:local": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/tools/scripts/turbo-ci-run.ts health",
    "health:prd": "SECRETS_ENV=prd bun run health:local",
    "hooks:install": "git config core.hooksPath libs/tools/githooks",
    "hooks:uninstall": "git config --unset core.hooksPath || true",
    "i18n:compile": "lingui compile --typescript --strict && bun run libs/tools/scripts/ensure-trailing-newline.ts libs/client-app/src/i18n/locales/en/messages.ts",
    "i18n:extract": "lingui extract --clean --overwrite",
    "infra:bootstrap": "SECRETS_ENV=prd bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/infra apply:bootstrap",
    "infra:destroy": "bun run libs/infra/scripts/destroy-env.ts",
    "infra:fleet": "SECRETS_ENV=shared bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @apps/auth-relay deploy && SECRETS_ENV=shared bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @libs/infra apply:fleet",
    "inspect": "SECRETS_ENV=prd bun run libs/secrets/src/scripts/secrets-run.ts -- bun run libs/infra/scripts/inspect.ts",
    "install-system": "bun run libs/tools/scripts/install-system.ts",
    "kill": "bun run libs/tools/scripts/kill-dev-stack.ts",
    "lint": "bun run libs/tools/scripts/turbo-ci-run.ts lint //#lint:root",
    "lint:naming": "bun run libs/tools/scripts/check-naming.ts",
    "lint:root": "bun run libs/tools/scripts/lint-package.ts",
    "migrate-to-tailwind": "bun run --filter @pkgs/ui codemod -- --write",
    "naming:fix": "bun run libs/tools/scripts/fix-naming.ts",
    "obs": "bun run libs/secrets/src/scripts/obs.ts",
    "psql": "bun ./pkgs/postgres-embedded/scripts/psql.ts",
    "secrets:pull": "bun run libs/secrets/src/scripts/secrets-pull.ts",
    "secrets:seed": "bun run libs/secrets/src/scripts/secrets-seed.ts",
    "sims:open": "bun run apps/product/scripts/sims/open-sims.ts",
    "spec": "bun run libs/tools/scripts/spec-run.ts",
    "spec:catalog": "bun run libs/tools/scripts/spec-catalog.ts",
    "spec:check": "bun run libs/tools/scripts/check-specs.ts",
    "spec:ownership": "bun run libs/tools/scripts/check-spec-ownership.ts",
    "stack": "bun run --silent dev",
    "synthetic": "bun run libs/secrets/src/scripts/secrets-run.ts -- bun run --filter @apps/product synthetic",
    "synthetic:prd": "SECRETS_ENV=prd bun run synthetic",
    "test:pbt:random": "bun run apps/product/scripts/test-pbt-random.ts",
    "wipe": "git clean -xfd",
    "workspace:sync": "bun run libs/tools/scripts/sync-workspace-lifecycle.ts",
    "feedback": "bun run pkgs/feedback/scripts/report.ts"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "adm-zip": "^0.6.1",
    "brace-expansion": "5.0.12",
