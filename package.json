{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "pkgs/*",
    "tools"
  ],
  "scripts": {
    "check": "SECRETS_ENV=dev LOCAL_SECRETS=1 bun run tools/scripts/turbo-ci-run.ts tc test ci:lint ci:syncpack ci:no-direct-pg-imports ci:database-url-policy ci:local-dev-self-contained ci:no-local-tables ci:no-legacy-writes ci:no-domain-hard-delete ci:no-top-level-di-functions ci:no-eager-di-construction ci:layer-c-sql-tx ci:no-di-container ci:fanout-rows-from-reads ci:mutation-determinism ci:channel-exhaustiveness ci:sync-engine-terminology ci:sync-engine-blackbox-tests ci:sync-engine-framework-leak ci:sync-engine-protocol-freeze ci:sync-engine-public-api ci:no-provider-leaks ci:no-bare-io ci:no-resolve-wall-defaults ci:no-sql-wall-io ci:hard-determinism ci:sim-determinism ci:pubsub-emqx-imports ci:depcruise ci:circular-deps ci:tier-imports ci:component-ids ci:no-size-limit-overrides ci:audit check:static @apps/api#build @apps/minio#build @apps/postgres#build",
    "check:actionlint": "actionlint -color",
    "check:api": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/check-api.ts",
    "check:ci": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-turbo.ts ci",
    "check:ci:build": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-turbo.ts build",
    "check:ci:gates": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-turbo.ts gates",
    "check:ci:verify": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-turbo.ts verify",
    "check:client": "turbo run test:integration --filter=@apps/client",
    "check:deployment-pipeline": "bun run check",
    "check:gitleaks": "gitleaks detect --redact --verbose --no-banner --log-opts=-1",
    "check:heal": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/check-heal.ts",
    "check:no-direct-pg-imports": "bun run tools/scripts/check-no-direct-pg-imports.ts",
    "check:no-patches": "bun run tools/scripts/check-no-patches.ts",
    "check:secrets": "bun run tools/scripts/secrets-run.ts -- bun run tools/scripts/run-check-secrets.ts",
    "check:secrets:validate": "bun run libs/infra/src/bin/check-secrets.ts",
    "check:static": "bun run check:actionlint && bun run check:gitleaks",
    "chess:puzzles:export-load": "SECRETS_ENV=prd bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/chess export:puzzles-load -- --confirm-prod",
    "chess:puzzles:seed": "bun run tools/scripts/secrets-run.ts -- bun run --filter @libs/chess seed:puzzles",
    "ci:audit": "bun run tools/scripts/ci-audit.ts",
    "ci:channel-exhaustiveness": "bun run tools/scripts/check-channel-exhaustiveness.ts",
    "ci:circular-deps": "bun run tools/scripts/check-circular-deps.ts",
    "ci:component-ids": "bun run tools/scripts/check-component-ids.ts",
    "ci:database-url-policy": "bun run tools/scripts/check-database-url-policy.ts",
    "ci:depcruise": "NODE_OPTIONS=--max-old-space-size=16384 dependency-cruise apps libs pkgs --validate .dependency-cruiser.cjs --output-type err",
    "ci:fanout-rows-from-reads": "bun run tools/scripts/check-fanout-rows-from-reads.ts",
    "ci:format": "bunx biome check --error-on-warnings .",
    "ci:hard-determinism": "bun run tools/scripts/check-hard-determinism.ts",
    "ci:layer-c-sql-tx": "bun run tools/scripts/check-layer-c-sql-tx.ts",
    "ci:lint": "bunx biome check --error-on-warnings .",
    "ci:local-dev-self-contained": "bun run tools/scripts/check-local-dev-self-contained.ts",
    "ci:mutation-determinism": "bun run tools/scripts/check-mutation-determinism.ts && bun run tools/scripts/check-mutation-idempotency.ts",
    "ci:no-bare-io": "bun run tools/scripts/check-no-bare-io.ts",
    "ci:no-di-container": "bun run tools/scripts/check-no-di-container.ts",
    "ci:no-direct-pg-imports": "bun run tools/scripts/check-no-direct-pg-imports.ts",
    "ci:no-domain-hard-delete": "bun run tools/scripts/check-no-domain-hard-delete.ts",
    "ci:no-eager-di-construction": "bun run tools/scripts/check-no-eager-di-construction.ts",
    "ci:no-legacy-writes": "bun run tools/scripts/check-no-legacy-writes.ts",
    "ci:no-local-tables": "bun run tools/scripts/check-local-table-categories.ts",
    "ci:no-provider-leaks": "bun run tools/scripts/check-no-provider-leaks.ts",
    "ci:no-resolve-wall-defaults": "bun run tools/scripts/check-no-resolve-wall-defaults.ts",
    "ci:no-size-limit-overrides": "bun run tools/scripts/check-no-size-limit-overrides.ts",
    "ci:no-sql-wall-io": "bun run tools/scripts/check-no-sql-wall-io.ts",
    "ci:no-top-level-di-functions": "bun run tools/scripts/check-no-top-level-di-functions.ts",
    "ci:pubsub-emqx-imports": "bun run tools/scripts/check-pubsub-emqx-imports.ts",
    "ci:setup-secrets-auth": "bun run tools/scripts/setup-ci-secrets-auth.ts",
    "ci:sim-determinism": "bun run tools/scripts/run-sim-determinism.ts",
    "ci:sync-engine-blackbox-tests": "bun run tools/scripts/check-sync-engine-blackbox-tests.ts",
    "ci:sync-engine-framework-leak": "bun run tools/scripts/check-sync-engine-framework-leak.ts",
    "ci:sync-engine-protocol-freeze": "bun run tools/scripts/check-sync-engine-protocol-freeze.ts",
    "ci:sync-engine-public-api": "bun run tools/scripts/check-sync-engine-public-api.ts",
    "ci:sync-engine-terminology": "bun run tools/scripts/check-sync-engine-terminology.ts",
    "ci:syncpack": "syncpack lint --dependency-types prod,dev && bun run tools/scripts/check-catalog-deps.ts && bun run tools/scripts/check-no-patches.ts",
    "ci:tier-imports": "bun run tools/scripts/check-tier-imports.ts",
    "client:ios": "bun run tools/scripts/secrets-run.ts -- bun run --filter @apps/client ios",
    "client:sentry-dsn": "bun run --filter @apps/client setup:sentry-dsn",
    "db:migrate": "bun run tools/scripts/secrets-run.ts -- bun run apps/api/src/db/migrate-cli.ts --wait",
    "db:wipe:dev": "SECRETS_ENV=dev bun run tools/scripts/secrets-run.ts -- bun run --filter @apps/api db:wipe:dev",
    "deps:graph": "bun run tools/scripts/render-package-deps-graph.ts",
    "dev": "SECRETS_ENV=dev bun run tools/scripts/secrets-run.ts -- turbo dev --ui=tui",
    "format": "sort-package-json \"package.json\" \"apps/*/package.json\" \"libs/*/package.json\" \"pkgs/*/package.json\" \"tools/package.json\" && bunx biome check --write . && bun run tools/scripts/remove-empty-dirs.ts",
    "gh": "bun x open https://github.com/crvouga/gamezilla/actions/workflows/deployment-pipeline.yml",
    "i18n:compile": "lingui compile --typescript && bun run tools/scripts/ensure-trailing-newline.ts apps/client/src/i18n/locales/en/messages.ts",
    "i18n:extract": "lingui extract",
    "infra": "SECRETS_ENV=prd bun run tools/scripts/secrets-run.ts -- bun run libs/infra/src/bin/cli.ts",
    "kill": "bun run tools/scripts/kill-dev-stack.ts",
    "pg:monitoring": "bun run tools/scripts/enable-pg-monitoring.ts",
    "preview": "bun run tools/scripts/secrets-run.ts -- turbo run preview --filter=@apps/api --filter=@apps/client --filter=@apps/postgres --filter=@apps/minio",
    "psql": "bun ./apps/postgres/scripts/psql.ts",
    "scaffold:game": "bun run tools/scripts/scaffold-game.ts",
    "sim:lab": "bun install && bun run --filter @pkgs/sync-engine sim:lab",
    "stripe:check": "bun run --filter '@libs/stripe' check",
    "stripe:sync": "bun run --filter '@libs/stripe' sync",
    "wipe": "git clean -xfd"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "js-cookie": "^3.0.7",
    "js-yaml": "^4.3.1",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "serialize-javascript": "7.0.5",
    "sharp": "^0.35.0",
    "shell-quote": "^1.10.0",
    "undici": "7.29.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@pkgs/os": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@tools/jingle": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lingui/cli": "catalog:",
    "@lingui/conf": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "dependency-cruiser": "catalog:",
    "expo": "catalog:",
    "knip": "catalog:",
    "sort-package-json": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
