{
  "name": "@apps/admin-api-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/worker.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "deploy": "bun run scripts/deploy.ts",
    "health": "bun run scripts/health.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "publish:permission-policy": "bun run scripts/publish-policy.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
