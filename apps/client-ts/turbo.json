{
  "extends": ["//"],
  "tasks": {
    "pwa:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "//#task:i18n:compile"]
    },
    "src": {
      "dependsOn": [
        "@libs/app-root-client-ts#src",
        "@libs/product-identity-shared-ts#src",
        "@libs/runtime-client-ts#src",
        "@libs/runtime-shared-ts#src",
        "@libs/spaces-client-ts#src",
        "@pkgs/bun-test-solid-client-ts#src",
        "@pkgs/clock-shared-ts#src",
        "@pkgs/feedback-client-ts#src",
        "@pkgs/http-client-shared-ts#src",
        "@pkgs/tailwind-shared-ts#src",
        "@pkgs/ui-root-client-ts#src"
      ]
    },
    "test": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/turbo-platform-key.json",
        "$TURBO_ROOT$/apps/{client-ts,product-ts,server-ts,synthetic-population-worker-ts}/package.json",
        "$TURBO_ROOT$/libs/{battleship-client-ts,battleship-harness-ts,battleship-shared-ts,chess-puzzle-client-ts,chess-puzzle-harness-ts,chess-puzzle-server-ts,chess-puzzle-shared-ts,chess-root-client-ts,chess-root-harness-ts,chess-root-server-ts,chess-root-shared-ts,chess-rules-shared-ts,chess-sub-shared-ts,connect-four-client-ts,connect-four-harness-ts,connect-four-shared-ts,game-catalog-shared-ts,games-client-ts,games-harness-ts,games-shared-ts,hearts-client-ts,hearts-harness-ts,hearts-shared-ts,light-cycles-client-ts,light-cycles-harness-ts,light-cycles-shared-ts,numberlink-client-ts,numberlink-harness-ts,numberlink-shared-ts,observatory-harness-ts,pong-client-ts,pong-harness-ts,pong-shared-ts,quoridor-client-ts,quoridor-harness-ts,quoridor-shared-ts,room-app-server-ts,runtime-client-ts,runtime-harness-ts,runtime-server-ts,runtime-shared-ts,sokoban-client-ts,sokoban-harness-ts,sokoban-shared-ts,spaces-shared-ts,synthetic-population-harness-ts,word-tiles-client-ts,word-tiles-harness-ts,word-tiles-shared-ts}/package.json",
        "$TURBO_ROOT$/pkgs/{chess-board-core-shared-ts,chess-board-root-client-ts,chess-board-root-harness-ts,chess-board-root-shared-ts,chess-rules-shared-ts}/package.json"
      ],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "dev": {
      "dependsOn": ["setup"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "setup": {
      "dependsOn": ["//#task:i18n:compile"],
      "cache": false,
      "passThroughEnv": ["*"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
