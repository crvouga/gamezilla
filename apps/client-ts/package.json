    "@lingui/conf": "catalog:",
    "@pkgs/assert-root-shared-ts": "workspace:*",
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/dev-owner-server-ts": "workspace:*",
    "@pkgs/feedback-server-ts": "workspace:*",
