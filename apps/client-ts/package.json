    "@libs/spaces-client-ts": "workspace:*",
    "@pkgs/feedback-client-ts": "workspace:*",
    "@pkgs/tailwind-shared-ts": "workspace:*",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@libs/app-config-shared-ts": "workspace:*",
