{
  "name": "@apps/client-ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build && bun run scripts/build-sw.ts",
    "dev": "bun run scripts/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "preview": "bun run scripts/preview-server.ts",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run --silent scripts/setup-env.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload",
    "verify:live-dist": "bun run scripts/live-bundle-guard-cli.ts verify-dist",
    "verify:live-env": "bun run scripts/live-bundle-guard-cli.ts verify-env",
    "verify:production-compression": "bun run scripts/verify-production-compression.ts"
  },
  "dependencies": {
