{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:release-journeys": {
      "dependsOn": ["^src", "//#task:i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/journeys/**",
        "$TURBO_ROOT$/specs/runtime/reopen-sokoban-position.feature",
        "$TURBO_ROOT$/specs/billing/open-provider-pages.feature",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["JOURNEY_CAPTURE_RUN", "JOURNEY_CAPTURE_STEPS", "JOURNEY_CAPTURE_VIEWPORT", "VERIFY_PROFILE"],
      "outputs": [
        ".cache/release-report/all/**",
        ".cache/critical-journeys/release-all/**"
      ],
      "passThroughEnv": ["*"]
    },
    "test:release-journeys:critical": {
      "dependsOn": ["^src", "//#task:i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/journeys/join-and-offline.feature",
        "$TURBO_ROOT$/specs/journeys/first-opening.feature",
        "$TURBO_ROOT$/specs/journeys/reopening.feature",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["JOURNEY_CAPTURE_STEPS", "VERIFY_PROFILE"],
      "outputs": [
        ".cache/release-report/all/**",
        ".cache/critical-journeys/release-all/**"
      ],
      "passThroughEnv": ["*"]
    },
    "test:release-journeys:0": {
      "dependsOn": ["^src", "//#task:i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/journeys/**",
        "$TURBO_ROOT$/specs/runtime/reopen-sokoban-position.feature",
        "$TURBO_ROOT$/specs/billing/open-provider-pages.feature",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["JOURNEY_CAPTURE_STEPS", "VERIFY_PROFILE"],
      "outputs": [
        ".cache/release-report/part-0-of-3/**",
        ".cache/critical-journeys/release-part-0-of-3/**"
      ],
      "passThroughEnv": ["*"]
    },
    "test:release-journeys:1": {
      "dependsOn": ["^src", "//#task:i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/journeys/**",
        "$TURBO_ROOT$/specs/runtime/reopen-sokoban-position.feature",
        "$TURBO_ROOT$/specs/billing/open-provider-pages.feature",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["JOURNEY_CAPTURE_STEPS", "VERIFY_PROFILE"],
      "outputs": [
        ".cache/release-report/part-1-of-3/**",
        ".cache/critical-journeys/release-part-1-of-3/**"
      ],
      "passThroughEnv": ["*"]
    },
    "test:release-journeys:2": {
      "dependsOn": ["^src", "//#task:i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/journeys/**",
        "$TURBO_ROOT$/specs/runtime/reopen-sokoban-position.feature",
        "$TURBO_ROOT$/specs/billing/open-provider-pages.feature",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ],
      "env": ["JOURNEY_CAPTURE_STEPS", "VERIFY_PROFILE"],
      "outputs": [
        ".cache/release-report/part-2-of-3/**",
        ".cache/critical-journeys/release-part-2-of-3/**"
      ],
      "passThroughEnv": ["*"]
    },
    "build": {
      "dependsOn": ["^src", "//#task:i18n:compile"]
    },
    "tc": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/tsconfig.paths.json"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/auth/**",
        "$TURBO_ROOT$/specs/battleship/battleship-health.feature",
        "$TURBO_ROOT$/specs/journeys/{battleship,quoridor}-game.feature",
        "$TURBO_ROOT$/specs/quoridor/quoridor-health.feature",
        "$TURBO_ROOT$/specs/billing/**",
        "$TURBO_ROOT$/specs/chess/**",
        "$TURBO_ROOT$/specs/friends/**",
        "$TURBO_ROOT$/specs/matchmaking/**",
        "$TURBO_ROOT$/specs/profile/**",
        "$TURBO_ROOT$/specs/room/**",
        "$TURBO_ROOT$/specs/spaces/**",
        "$TURBO_ROOT$/specs/sync-engine/**",
        "$TURBO_ROOT$/specs/system/**",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ]
    },
    "health:release": {
      "cache": false,
      "dependsOn": [
        "@libs/infra-server-ts#apply:edge",
        "@libs/billing-server-ts#billing:sync"
      ],
      "outputLogs": "full"
    },
    "health:objectives": {
      "cache": false,
      "outputs": []
    },
    "test:stack": {
      "cache": false,
      "env": ["JOURNEY_CAPTURE_STEPS"],
      "passThroughEnv": ["*"],
      "outputs": []
    },
    "test:spec:0": {
      "inputs": ["$TURBO_EXTENDS$"]
    },
    "test:unit:1": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/auth/**",
        "$TURBO_ROOT$/specs/battleship/battleship-health.feature",
        "$TURBO_ROOT$/specs/journeys/{battleship,quoridor}-game.feature",
        "$TURBO_ROOT$/specs/quoridor/quoridor-health.feature",
        "$TURBO_ROOT$/specs/billing/**",
        "$TURBO_ROOT$/specs/chess/**",
        "$TURBO_ROOT$/specs/friends/**",
        "$TURBO_ROOT$/specs/matchmaking/**",
        "$TURBO_ROOT$/specs/profile/**",
        "$TURBO_ROOT$/specs/room/**",
        "$TURBO_ROOT$/specs/spaces/**",
        "$TURBO_ROOT$/specs/sync-engine/**",
        "$TURBO_ROOT$/specs/system/**",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ]
    },
    "test:unit:2": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/specs/auth/**",
        "$TURBO_ROOT$/specs/battleship/battleship-health.feature",
        "$TURBO_ROOT$/specs/journeys/{battleship,quoridor}-game.feature",
        "$TURBO_ROOT$/specs/quoridor/quoridor-health.feature",
        "$TURBO_ROOT$/specs/billing/**",
        "$TURBO_ROOT$/specs/chess/**",
        "$TURBO_ROOT$/specs/friends/**",
        "$TURBO_ROOT$/specs/matchmaking/**",
        "$TURBO_ROOT$/specs/profile/**",
        "$TURBO_ROOT$/specs/room/**",
        "$TURBO_ROOT$/specs/spaces/**",
        "$TURBO_ROOT$/specs/sync-engine/**",
        "$TURBO_ROOT$/specs/system/**",
        "$TURBO_ROOT$/turbo-platform-key.json"
      ]
    },
    "src": {
      "dependsOn": [
        "@apps/product-api-ts#src",
        "@libs/app-config-shared-ts#src",
        "@libs/app-env-client-ts#src",
        "@libs/app-root-client-ts#src",
        "@libs/app-root-shared-ts#src",
        "@libs/auth-shared-ts#src",
        "@libs/battleship-harness-ts#src",
        "@libs/billing-harness-ts#src",
        "@libs/billing-shared-ts#src",
        "@libs/connect-four-harness-ts#src",
        "@libs/db-shared-ts#src",
        "@libs/harness-ts#src",
        "@libs/infra-server-ts#src",
        "@libs/infra-shared-ts#src",
        "@libs/observability-server-ts#src",
        "@libs/product-identity-shared-ts#src",
        "@libs/quoridor-harness-ts#src",
        "@libs/runtime-client-ts#src",
        "@libs/runtime-harness-ts#src",
        "@libs/runtime-shared-ts#src",
        "@libs/secrets-server-ts#src",
        "@libs/secrets-shared-ts#src",
        "@libs/spaces-client-ts#src",
        "@libs/sub-shared-ts#src",
        "@libs/synthetic-population-server-ts#src",
        "@libs/synthetic-population-shared-ts#src",
        "@libs/test-ids-shared-ts#src",
        "@pkgs/aedes-server-ts#src",
        "@pkgs/assert-crash-browser-client-ts#src",
        "@pkgs/assert-root-shared-ts#src",
        "@pkgs/auth-inhouse-server-ts#src",
        "@pkgs/billing-providers-server-ts#src",
        "@pkgs/billing-root-shared-ts#src",
        "@pkgs/billing-stripe-server-ts#src",
        "@pkgs/billing-stripe-shared-ts#src",
        "@pkgs/clock-shared-ts#src",
        "@pkgs/conformance-server-ts#src",
        "@pkgs/conformance-shared-ts#src",
        "@pkgs/db-migrate-shared-ts#src",
        "@pkgs/dev-owner-server-ts#src",
        "@pkgs/emqx-shared-ts#src",
        "@pkgs/feedback-client-ts#src",
        "@pkgs/fs-server-ts#src",
        "@pkgs/gherkin-server-ts#src",
        "@pkgs/gherkin-shared-ts#src",
        "@pkgs/git-shared-ts#src",
        "@pkgs/http-client-shared-ts#src",
        "@pkgs/logger-shared-ts#src",
        "@pkgs/object-store-node-fs-server-ts#src",
        "@pkgs/object-store-root-shared-ts#src",
        "@pkgs/observability-root-shared-ts#src",
        "@pkgs/openslo-server-ts#src",
        "@pkgs/openslo-shared-ts#src",
        "@pkgs/os-server-ts#src",
        "@pkgs/os-shared-ts#src",
        "@pkgs/polyfill-shared-ts#src",
        "@pkgs/postgres-local-shared-ts#src",
        "@pkgs/postgres-mockingbird-server-ts#src",
        "@pkgs/property-shared-ts#src",
        "@pkgs/s3-server-ts#src",
        "@pkgs/sql-client-postgres-server-ts#src",
        "@pkgs/sql-client-root-shared-ts#src",
        "@pkgs/sql-root-shared-ts#src",
        "@pkgs/tailwind-shared-ts#src",
        "@pkgs/ui-root-client-ts#src",
        "@pkgs/ui-testing-bun-webview-server-ts#src",
        "@pkgs/ui-testing-bun-webview-shared-ts#src",
        "@pkgs/ui-testing-root-shared-ts#src",
        "@pkgs/uuid-shared-ts#src"
      ]
    },
    "dev:prepare": {
      "dependsOn": ["//#workspace:install", "//#workspace:merge"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["dev:prepare"],
      "with": [
        "dev:postgres",
        "dev:openai",
        "dev:s3",
        "dev:mqtt",
        "dev:observability",
        "dev:idp",
        "dev:billing",
        "dev:server",
        "dev:population",
        "dev:web",
        "dev:admin-api",
        "dev:admin-client",
        "@pkgs/ui-root-harness-ts#dev:storybook"
      ],
      "persistent": true,
      "cache": false
    },
    "dev:postgres": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:openai": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:s3": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:mqtt": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:observability": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:idp": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:billing": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:server": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:population": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:admin-api": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:admin-client": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "dev:web": {
      "dependsOn": ["dev:prepare"],
      "persistent": true,
      "cache": false
    },
    "verify:worker-retirement": {
      "dependsOn": ["@apps/product-ts#build"],
      "inputs": ["scripts/verify-worker-retirement.ts", "public/sw.js"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "deploy": {
      "cache": false,
      "dependsOn": [
        "@apps/admin-api-ts#publish:permission-policy",
        "@libs/chess-puzzle-server-ts#initialize:catalog",
        "@apps/product-api-ts#verify:api",
        "@apps/product-ts#verify:worker-retirement",
        "@apps/product-ts#verify:worker-bundle",
        "@apps/product-ts#verify:rendered-worker"
      ]
    },
    "verify:worker-bundle": {
      "dependsOn": ["^src", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/tools-harness-ts/scripts/verify-worker-bundle.ts",
        "$TURBO_ROOT$/libs/tools-harness-ts/scripts/worker-compat-date.ts"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "verify:rendered-worker": {
      "dependsOn": ["^src", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/global.tfvars.json",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/envs/*.tfvars.json"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "synthetic": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:fuzz": {
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
