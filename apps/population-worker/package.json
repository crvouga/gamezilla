{
  "name": "@apps/population-worker",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "deploy": "bun run ../../libs/infra-server/scripts/publish-container.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "start": "bun --conditions=browser --conditions=development src/main.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@libs/app-root-client": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/population-server": "workspace:*",
    "@libs/population-shared": "workspace:*",
    "@libs/runtime-client": "workspace:*",
    "@libs/runtime-shared": "workspace:*",
    "@libs/spaces-client": "workspace:*",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server": "workspace:*",
    "@pkgs/ui-testing-root-shared": "workspace:*",
    "@pkgs/ui-testing-solid-dom-client": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "@solidjs/router": "catalog:",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness"
}
