{
  "name": "@apps/server",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "check:api": "bun run scripts/check-api.ts",
    "check:worker-bundle": "bun run ../../libs/tools/scripts/check-worker-bundle.ts",
    "contract:write": "bun run scripts/contract-manifest.ts",
    "deploy": "bun run scripts/deploy.ts",
    "health": "bun test --timeout 60000 ./health/*.health.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "preview": "bun run scripts/preview.ts",
    "preview:serve": "bun run scripts/preview-serve.ts",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/integration/**'",
    "test:integration": "bun test src/integration/"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/billing": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/infra": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async-local": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/auth-inhouse": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/billing-providers": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/room-adapter-bun": "workspace:*",
    "@pkgs/s3-server": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "better-sqlite3": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libs/games": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
