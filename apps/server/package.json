{
  "name": "@apps/server",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "db:migrate": "bun run src/db/migrate-cli.ts --wait",
    "db:wipe:dev": "bun run scripts/wipe-dev-db.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "migrate": "bun run src/db/migrate-cli.ts --wait",
    "preview": "bun run scripts/preview.ts",
    "preview:serve": "bun run scripts/preview-serve.ts",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "stripe:check": "bun run --filter @libs/stripe check",
    "stripe:sync": "bun run --filter @libs/stripe sync",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/integration/**'",
    "test:integration": "bun test src/integration/"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/friends": "workspace:*",
    "@libs/infra": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/stripe": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async-local": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/auth-better-auth": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/entity-store": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/matchmaking": "workspace:*",
    "@pkgs/minio-server": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/outbox": "workspace:*",
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/pubsub-emqx": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/system-console": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "better-sqlite3": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkgs/os": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
