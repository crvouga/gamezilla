{
  "name": "@apps/server",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./scripts/*": "./scripts/*.ts",
    "./worker": "./src/server.ts",
    "./room": "./src/room.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "check:api": "bun run scripts/check-api.ts",
    "contract:write": "bun run scripts/contract-manifest.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "preview": "bun run scripts/preview.ts",
    "preview:serve": "bun run scripts/preview-serve.ts",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test integration.test"
  },
  "dependencies": {
    "@libs/app-root-server": "workspace:*",
    "@libs/app-root-shared": "workspace:*",
    "@libs/billing-shared": "workspace:*",
    "@libs/db-shared": "workspace:*",
    "@libs/sub-shared": "workspace:*",
    "@libs/moderation-shared": "workspace:*",
    "@libs/room-app-server": "workspace:*",
    "@libs/room-app-shared": "workspace:*",
    "@libs/runtime-server": "workspace:*",
    "@libs/runtime-shared": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@pkgs/assert-root-shared": "workspace:*",
    "@pkgs/auth-root-shared": "workspace:*",
    "@pkgs/billing-providers-server": "workspace:*",
    "@pkgs/billing-root-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/feedback-server": "workspace:*",
    "@pkgs/llm-root-server": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/observability-root-server": "workspace:*",
    "@pkgs/observability-root-shared": "workspace:*",
    "@pkgs/s3-server": "workspace:*",
    "@pkgs/secret-store-shared": "workspace:*",
    "@pkgs/tts-root-server": "workspace:*"
  },
  "devDependencies": {
    "@libs/app-config-shared": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/chess-puzzle-server": "workspace:*",
    "@libs/db-server": "workspace:*",
    "@libs/games-shared": "workspace:*",
    "@libs/infra-shared": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/secrets-server": "workspace:*",
    "@libs/spaces-shared": "workspace:*",
    "@pkgs/database-url-policy-shared": "workspace:*",
    "@pkgs/db-migrate-shared": "workspace:*",
    "@pkgs/emqx-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/postgres-local-shared": "workspace:*",
    "@pkgs/postgres-mockingbird-server": "workspace:*",
    "@pkgs/room-adapter-bun-server": "workspace:*",
    "@pkgs/room-root-server": "workspace:*",
    "@pkgs/secrets-config-server": "workspace:*",
    "@pkgs/sql-client-postgres-server": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "category": "server"
}
