{
  "name": "@apps/product",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./console-nav/*": [
      "./src/console/console-nav/*.ts",
      "./src/console/console-nav/*.tsx",
      "./src/console/console-nav/*/index.ts"
    ],
    "./console/*": [
      "./src/console/*.ts",
      "./src/console/*.tsx",
      "./src/console/*/index.ts"
    ],
    "./product-simulator/*": [
      "./src/console/product-simulator/*.ts",
      "./src/console/product-simulator/*.tsx",
      "./src/console/product-simulator/*/index.ts"
    ],
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx"
    ]
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:production-dist": "bun run scripts/production-bundle-guard-cli.ts check-dist",
    "check:production-env": "bun run scripts/production-bundle-guard-cli.ts check-env",
    "deploy": "bun run scripts/deploy.ts",
    "predev": "bun run --silent setup",
    "dev": "vite",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "report:build": "bun run --filter @pkgs/sim-report build && bun run scripts/build-sim-report.ts",
    "report:open": "bun run --filter @pkgs/sim-report build && bun run scripts/build-sim-report.ts --open",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test scripts/sims scripts/sw-policy.test.ts src/console/console-nav src/console/product-simulator/product-simulator-snapshot-prune.test.ts",
    "test:e2e": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --preload @libs/sim-harness/preload --timeout 90000 --parallel tests",
    "test:fuzz": "bun run scripts/test-fuzz.ts",
    "test:max": "bun ./scripts/test-max.ts",
    "test:report": "bun run scripts/test-report.ts",
    "test:stack": "bun run scripts/test-stack.ts"
  },
  "dependencies": {
    "@apps/client": "workspace:*",
    "@apps/server": "workspace:*",
    "@libs/auth": "workspace:*",
    "@libs/billing": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-app": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/friends": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/search": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/sim-harness": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/aedes-server": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assert-crash-browser": "workspace:*",
    "@pkgs/chess-board": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/object-store-opfs": "workspace:*",
    "@pkgs/polyfill": "workspace:*",
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/s3-server": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/sim-console": "workspace:*",
    "@pkgs/sim-report": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/tailwind": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@solidjs/router": "catalog:",
    "better-sqlite3": "catalog:",
    "chess.js": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/runtime": "catalog:",
    "@clack/prompts": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/sql-client-sqlite-web": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "workbox-build": "catalog:"
  }
}
