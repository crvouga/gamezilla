{
  "name": "@apps/product",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts",
    "./ui-quality/*": "./scripts/ui-quality/*.ts",
    "./ui-quality/sources.json": "./scripts/ui-quality/sources.json",
    "./scripts/health": "./scripts/health.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:live-dist": "bun run scripts/live-bundle-guard-cli.ts check-dist",
    "check:live-env": "bun run scripts/live-bundle-guard-cli.ts check-env",
    "check:offline-shell": "bun run scripts/check-offline-shell.ts",
    "check:ui-quality": "bun run scripts/check.ts",
    "check:worker-bundle": "bun run ../../libs/tools/scripts/check-worker-bundle.ts",
    "deploy": "bun run scripts/deploy.ts",
    "dev": "bun run scripts/dev-run.ts",
    "dev:prepare": "bun run scripts/dev-prepare.ts",
    "dev:services": "bun run scripts/cli.ts",
    "explore:quint-system": "bun tests/quint/explore-campaign.ts",
    "health": "bun run scripts/health.ts",
    "health:objectives": "bun run scripts/health.ts --objectives",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepare:ui-quality": "bun run scripts/prepare.ts",
    "prepare:ui-quality-model": "bun run scripts/prepare-model.ts",
    "setup": "bun run scripts/setup-env.ts",
    "synthetic": "bun run scripts/health.ts --synthetic",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test --max-concurrency=$(bun ../../pkgs/os-server/src/test-concurrency.ts) scripts/dev-repo-root.test.ts scripts/ios-sim-name.test.ts scripts/sim-spec.test.ts scripts/health.test.ts scripts/sw-policy.test.ts scripts/stack-options.test.ts tests/console-nav.test.ts tests/dev-startup.test.ts tests/product-harness-snapshot-prune.test.ts tests/prepare-critical-journey-access.test.ts tests/wrangler-config.test.ts tests/worker.test.ts tests/openslo/health-job-results.test.ts tests/quint/simulation.test.ts tests/quint/effectiveness.test.ts tests/quint/campaign-tools.test.ts tests/live-browser.test.ts tests/ui-quality.test.ts tests/ui-quality-fingerprint.test.ts scripts/local-stack-config.test.ts scripts/start-observability-stack.test.ts scripts/spec-process.test.ts scripts/load-balancer.test.ts tests/ui-quality-model-location.test.ts",
    "test:contract": "bun test --max-concurrency=$(bun ../../pkgs/os-server/src/test-concurrency.ts 2) tests/quint/model-checks.test.ts && bun test --max-concurrency=$(bun ../../pkgs/os-server/src/test-concurrency.ts 2) tests/ui-quality-render.contract.test.ts",
    "test:fuzz": "bun run scripts/test-fuzz.ts",
    "test:max": "bun ./scripts/test-max.ts",
    "test:quint-system": "bun test tests/quint/simulation.test.ts tests/quint/effectiveness.test.ts",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1",
    "test:stack": "bun run scripts/test-stack.ts"
  },
