{
  "name": "@apps/product",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./console-nav/*": [
      "./src/console/console-nav/*.ts",
      "./src/console/console-nav/*.tsx",
      "./src/console/console-nav/*/index.ts"
    ],
    "./console/*": [
      "./src/console/*.ts",
      "./src/console/*.tsx",
      "./src/console/*/index.ts"
    ],
    "./product-harness/*": [
      "./src/console/product-harness/*.ts",
      "./src/console/product-harness/*.tsx",
      "./src/console/product-harness/*/index.ts"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./worker": "./src/worker.ts",
    "./scripts/health": "./scripts/health.ts"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:live-dist": "bun run scripts/live-bundle-guard-cli.ts check-dist",
    "check:live-env": "bun run scripts/live-bundle-guard-cli.ts check-env",
    "check:offline-shell": "bun run scripts/check-offline-shell.ts",
    "check:worker-bundle": "bun run ../../libs/tools/scripts/check-worker-bundle.ts",
    "deploy": "bun run scripts/deploy.ts",
    "predev": "bun run --silent setup",
    "dev": "bun run scripts/localhost-stack/cli.ts --",
    "explore:quint-system": "bun tests/quint/system/explore-campaign.ts",
    "health": "bun run scripts/health.ts",
    "health:objectives": "bun run scripts/health.ts --objectives",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "synthetic": "bun run scripts/health.ts --synthetic",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test scripts/sims scripts/health.test.ts scripts/sw-policy.test.ts scripts/reports-dev.test.ts scripts/localhost-stack/stack-options.test.ts src/console/console-nav src/console/reports src/console/product-harness/product-harness-snapshot-prune.test.ts src/harness/prepare-critical-journey-access.test.ts tests/wrangler-config.test.ts tests/worker.test.ts tests/developer-catalog-source.test.ts tests/openslo tests/quint/system/simulation.test.ts tests/quint/system/effectiveness.test.ts tests/quint/system/campaign-tools.test.ts tests/live-browser.test.ts",
    "test:contract": "bun test --max-concurrency 16 tests/quint/system/model-checks.test.ts",
    "test:fuzz": "bun run scripts/test-fuzz.ts",
    "test:max": "bun ./scripts/test-max.ts",
    "test:quint-system": "bun test tests/quint/system/simulation.test.ts tests/quint/system/effectiveness.test.ts",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1",
    "test:stack": "bun run scripts/test-stack.ts"
  },
  "dependencies": {
