{
  "name": "@apps/product",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/sim/index.ts",
    "./sim": "./src/sim/index.ts",
    "./sim/fabric/*": [
      "./src/sim/fabric/*.ts",
      "./src/sim/fabric/*/index.ts"
    ],
    "./sim/hosts/*": [
      "./src/sim/hosts/*.ts",
      "./src/sim/hosts/*/index.ts"
    ],
    "./sim/setup/*": [
      "./src/sim/setup/*.ts",
      "./src/sim/setup/*/index.ts"
    ],
    "./sim/system/*": [
      "./src/sim/system/*.ts",
      "./src/sim/system/*/index.ts"
    ],
    "./console/*": [
      "./src/console/*.ts",
      "./src/console/*.tsx",
      "./src/console/*/index.ts"
    ],
    "./console-nav/*": [
      "./src/console/console-nav/*.ts",
      "./src/console/console-nav/*.tsx",
      "./src/console/console-nav/*/index.ts"
    ],
    "./product-simulator/*": [
      "./src/console/product-simulator/*.ts",
      "./src/console/product-simulator/*.tsx",
      "./src/console/product-simulator/*/index.ts"
    ],
    "./test/*": [
      "./src/test/*.ts",
      "./src/test/*.tsx",
      "./src/test/*/index.ts"
    ],
    "./test-setup/*": [
      "./src/test/setup/*.ts",
      "./src/test/setup/*.tsx",
      "./src/test/setup/*/index.ts"
    ],
    "./test-fixtures/*": [
      "./src/test/fixtures/*.ts",
      "./src/test/fixtures/*.tsx",
      "./src/test/fixtures/*/index.ts"
    ],
    "./test-snapshots/*": [
      "./src/test/snapshots/*.ts",
      "./src/test/snapshots/*.tsx",
      "./src/test/snapshots/*/index.ts"
    ]
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:production-dist": "bun run scripts/production-bundle-guard-cli.ts check-dist",
    "check:production-env": "bun run scripts/production-bundle-guard-cli.ts check-env",
    "deploy": "bun run scripts/deploy.ts",
    "predev": "bun run --silent setup",
    "dev": "vite",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "report:build": "bun run --filter @pkgs/sim-report build && bun run scripts/build-sim-report.ts",
    "report:open": "bun run --filter @pkgs/sim-report build && bun run scripts/build-sim-report.ts --open",
    "seed:sim-db": "bun scripts/build-sim-seed.ts",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test scripts/sims && bun test src/console/console-nav src/console/product-simulator/product-simulator-snapshot-prune.test.ts && NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests",
    "test:auth": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/auth-login-logout.test.tsx tests/auth-oauth-port.test.ts",
    "test:billing": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/billing-*.test.tsx",
    "test:chess": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/chess-puzzle-play.test.tsx tests/chess-puzzle-feed.test.tsx tests/chess-puzzle-controls.test.tsx tests/chess-puzzle-stats.test.tsx tests/chess-puzzle-exhaust.test.tsx tests/chess-puzzle-spectator.test.tsx tests/chess-puzzle-offline.test.tsx",
    "test:explore": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 180000 tests/product-explore.test.tsx",
    "test:friends": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/friends-request-accept.test.tsx",
    "test:fuzz": "bun run scripts/test-fuzz.ts",
    "test:max": "bun ./scripts/test-max.ts",
    "test:profile": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/profile-edit.test.tsx",
    "test:report": "bun run scripts/test-report.ts",
    "test:shell": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/shell-boot.test.tsx",
    "test:spaces": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/space-create.test.tsx tests/space-end.test.tsx tests/space-friend-join.test.tsx tests/space-guest-host.test.tsx tests/space-lifecycle.test.tsx",
    "test:stack": "bun run scripts/test-stack.ts",
    "test:topology": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/topology-partition.test.tsx",
    "test:walk": "NODE_OPTIONS=--max-old-space-size=8192 bun test --conditions=browser --conditions=development --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests/product-walk.test.tsx"
  },
