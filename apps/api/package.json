{
  "name": "@gamezilla/api",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@better-auth/expo": "^1.6.9",
    "@gamezilla/domain": "workspace:*",
    "@gamezilla/lib": "workspace:*",
    "@gamezilla/patch-db": "workspace:*",
    "@gamezilla/room": "workspace:*",
    "@gamezilla/stripe": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "~5.9.2",
    "wrangler": "^4.54.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "bun test",
    "build": "bun -e \"process.exit(0)\"",
    "tc": "tsc --noEmit -p ../../tsconfig.json",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "stripe:sync": "bun run --filter @gamezilla/stripe sync",
    "stripe:check": "bun run --filter @gamezilla/stripe check",
    "dev": "bun run scripts/dev-refresh-client-config.ts & wrangler dev --port 8788 --inspector-port 9231",
    "kill": "lsof -ti :8788 | xargs kill -9 2>/dev/null || true",
    "preview": "wrangler dev --port 8788"
  }
}
