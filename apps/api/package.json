{
  "name": "@apps/api",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "migrate": "bun run scripts/migrate-db.ts",
    "dev": "bun run scripts/migrate-db.ts --wait && bun run --filter @libs/client-config dev:refresh & wrangler dev --port 8788 --inspector-port 9231",
    "kill": "bun run scripts/kill-dev.ts",
    "lint": "eslint src --max-warnings 0",
    "preview": "bun run scripts/migrate-db.ts --wait && wrangler dev --port 8788",
    "setup": "bun run scripts/setup-dev-vars.ts && bun run scripts/setup-better-auth-secret.ts",
    "stripe:check": "bun run --filter @libs/stripe check",
    "stripe:sync": "bun run --filter @libs/stripe sync",
    "tc": "tsc --noEmit -p ../../tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/infra": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/stripe": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/dev-idp": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/matchmaking": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/patch-db": "workspace:*",
    "@pkgs/pub-sub": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@pkgs/vault": "workspace:*",
    "hono": "catalog:",
    "pg": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@pkgs/os": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
