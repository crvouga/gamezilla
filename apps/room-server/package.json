{
  "name": "@apps/room-server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/room.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "deploy": "bun run scripts/deploy.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@libs/db": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/room": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
