{
  "name": "@apps/room-server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/room.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "check:worker-bundle": "bun run ../../libs/tools/scripts/check-worker-bundle.ts",
    "deploy": "bun run scripts/deploy.ts",
    "health": "bun test --timeout 60000 ./health/*.health.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test"
  },
  "dependencies": {
    "@libs/infra": "workspace:*",
    "@libs/room-app": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
