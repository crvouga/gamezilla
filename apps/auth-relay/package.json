{
  "name": "@apps/auth-relay",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/worker.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "check:worker-bundle": "bun run ../../libs/tools/scripts/check-worker-bundle.ts",
    "deploy": "bun run scripts/deploy.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pkgs/auth-inhouse-server": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@libs/infra-shared": "workspace:*",
    "@libs/secrets-server": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "category": "server"
}
