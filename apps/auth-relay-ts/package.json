{
  "name": "@apps/auth-relay-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/worker.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "deploy": "bun run scripts/deploy.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test",
    "verify:worker-bundle": "bun run ../../libs/tools-harness-ts/scripts/verify-worker-bundle.ts"
  },
  "dependencies": {
    "@pkgs/auth-inhouse-server-ts": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@libs/infra-shared-ts": "workspace:*",
    "@libs/secrets-server-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
