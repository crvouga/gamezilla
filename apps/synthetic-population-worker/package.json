{
  "name": "@apps/synthetic-population-worker",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "benchmark": "bun --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/register tests/benchmark.ts",
    "check:synthetic-population": "bun run scripts/check-synthetic-population.ts",
    "check:synthetic-population-foundation": "bun run scripts/check-synthetic-population-foundation.ts",
    "deploy": "bun run ../../libs/infra-server/scripts/publish-container.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "start": "bun --conditions=browser --conditions=development src/main.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --max-concurrency=1 --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@libs/app-root-client": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/synthetic-population-server": "workspace:*",
    "@libs/synthetic-population-shared": "workspace:*",
    "@libs/runtime-client": "workspace:*",
    "@libs/runtime-shared": "workspace:*",
    "@libs/spaces-client": "workspace:*",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/observability-root-server": "workspace:*",
    "@pkgs/observability-root-shared": "workspace:*",
    "@pkgs/observability-runtime-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server": "workspace:*",
    "@pkgs/ui-testing-root-shared": "workspace:*",
    "@pkgs/ui-testing-solid-dom-client": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "@solidjs/router": "catalog:",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@libs/harness": "workspace:*",
    "@libs/runtime-harness": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness"
}
