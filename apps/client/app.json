{
  "expo": {
    "name": "gamezilla",
    "slug": "gamezilla",
    "owner": "crvouga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "gamezilla",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "updates": {
      "url": "https://u.expo.dev/c83debca-1cc6-419a-812c-708547d93d03"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gamezilla",
      "buildNumber": "1",
      "deploymentTarget": "17.0"
    },
    "android": {
      "package": "app.gamezilla",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-dev-client"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c83debca-1cc6-419a-812c-708547d93d03"
      }
    }
  }
}
