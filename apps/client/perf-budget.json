{
  "version": 2,
  "compression": {
    "primary": "gzip",
    "alsoReport": ["brotli"]
  },
  "initial": {
    "jsGzipKb": 125,
    "cssGzipKb": 20,
    "fontsKb": 40,
    "criticalPathTotalGzipKb": 170,
    "jsRawKb": 400,
    "imagesRawKb": 50,
    "perImageRawKb": 40
  },
  "lazy": {
    "defaultGzipKb": 200,
    "overrides": {
      "game-plugins": 400,
      "chess": 350,
      "ui-explorer": 300,
      "profile-avatar": 750,
      "profile-dicebear-avatar": 700,
      "create-local-sync-engine": 600,
      "sync-engine-ready-tree": 550
    }
  },
  "deferredPathMustNotMatch": ["sql-workers", ".wasm"],
  "thirdParty": {
    "indexHtmlScriptAllowlist": []
  },
  "fonts": {
    "allowedFontDisplay": ["swap", "optional"]
  }
}
