{
  "name": "@apps/client",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./sync/*": [
      "./src/sync/*.ts",
      "./src/sync/*.tsx",
      "./src/sync/*/index.ts"
    ],
    "./device/*": [
      "./src/device/*.ts",
      "./src/device/*.tsx",
      "./src/device/*/index.ts"
    ],
    "./i18n/*": [
      "./src/i18n/*.ts",
      "./src/i18n/*.tsx",
      "./src/i18n/*/index.ts"
    ],
    "./shell/*": [
      "./src/shell/*.ts",
      "./src/shell/*.tsx",
      "./src/shell/*/index.ts"
    ],
    "./routes/*": [
      "./src/routes/*.ts",
      "./src/routes/*.tsx",
      "./src/routes/*/index.ts"
    ],
    "./chrome/*": [
      "./src/chrome/*.ts",
      "./src/chrome/*.tsx",
      "./src/chrome/*/index.ts"
    ],
    "./config/*": [
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ]
  },
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:bundle-budget": "bun run scripts/bundle-budget.ts dist --budget=./perf-budget.json",
    "check:critical-path": "bun run scripts/client-critical-path-imports.ts --budget=./perf-budget.json && bun run scripts/check-index-html-scripts.ts --budget=./perf-budget.json && bun run scripts/check-client-image-budgets.ts --budget=./perf-budget.json",
    "check:lighthouse": "bun run scripts/lighthouse-ci.ts --budget=./perf-budget.json --skip-upload",
    "check:memory": "bun run scripts/client-memory-probe.ts --budget=./perf-budget.json",
    "check:production-compression": "bun run scripts/check-production-compression.ts",
    "check:production-dist": "bun run scripts/production-bundle-guard-cli.ts check-dist",
    "check:production-env": "bun run scripts/production-bundle-guard-cli.ts check-env",
    "predev": "bun run --silent setup",
    "dev": "bun run scripts/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "preview": "bun run scripts/preview-server.ts",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "start": "bun run dev",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/integration/**' --path-ignore-patterns='**/*.test.tsx' && vitest run",
    "test:integration": "bun test --pass-with-no-tests src/integration/"
  },
  "dependencies": {
    "@apps/server": "workspace:*",
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/friends": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/search": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@libs/user-search": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assert-crash-browser": "workspace:*",
    "@pkgs/assistant": "workspace:*",
    "@pkgs/async": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/browser": "workspace:*",
    "@pkgs/chess-board": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/device": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/kv-web": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/object-store-opfs": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/observability-impl-local-file": "workspace:*",
    "@pkgs/polyfill": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/pubsub-aedes": "workspace:*",
    "@pkgs/pubsub-emqx": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/room-adapter-web": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secure-storage": "workspace:*",
    "@pkgs/secure-storage-web": "workspace:*",
    "@pkgs/sim-console": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-cli": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@pkgs/sql-client-sqlite-web": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/tailwind": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@solidjs/router": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "buffer": "catalog:",
