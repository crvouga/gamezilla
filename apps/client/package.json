{
  "name": "@apps/client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:live-dist": "bun run scripts/live-bundle-guard-cli.ts check-dist",
    "check:live-env": "bun run scripts/live-bundle-guard-cli.ts check-env",
    "check:production-compression": "bun run scripts/check-production-compression.ts",
    "predev": "bun run --silent setup",
    "dev": "bun run scripts/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "preview": "bun run scripts/preview-server.ts",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "start": "bun run dev",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload"
  },
  "dependencies": {
    "@libs/app-client": "workspace:*",
    "@libs/app-shared": "workspace:*",
    "@libs/runtime-client": "workspace:*",
    "@libs/runtime-shared": "workspace:*",
    "@libs/spaces-client": "workspace:*",
    "@pkgs/feedback-client": "workspace:*",
    "@pkgs/observability-client": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "solid-js": "catalog:",
    "@pkgs/tailwind-shared": "workspace:*",
    "@pkgs/ui-client": "workspace:*"
  },
  "devDependencies": {
    "@libs/app-config-shared": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@lingui/conf": "catalog:",
    "@pkgs/assert-shared": "workspace:*",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/git-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/os-server": "workspace:*",
    "@pkgs/secret-store-shared": "workspace:*",
    "@pkgs/vite-workspace-resolver-server": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "workbox-build": "catalog:",
    "@pkgs/feedback-server": "workspace:*",
    "@pkgs/sql-client-sqlite-web-server": "workspace:*",
    "@lingui/babel-plugin-lingui-macro": "catalog:"
  },
  "category": "client"
}
