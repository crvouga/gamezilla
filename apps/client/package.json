    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@pkgs/os": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "babel-plugin-macros": "catalog:",
    "esbuild": "catalog:",
