{
  "name": "@apps/client",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo start --android",
    "prebuild": "bun run bundle:absurd-sql-worker && bun run bundle:sqljs-wasm && bun run bundle:skia-canvaskit-wasm && cd ../.. && bun run i18n:compile",
    "build": "expo customize tsconfig.json && expo export -p web && bun run scripts/build-sw.ts",
    "bundle:absurd-sql-worker": "bun run scripts/bundle-absurd-sql-worker.ts",
    "bundle:skia-canvaskit-wasm": "bun run scripts/bundle-skia-canvaskit-wasm.ts",
    "bundle:sqljs-wasm": "bun run scripts/bundle-sqljs-wasm.ts",
    "predev": "bun run bundle:absurd-sql-worker && bun run bundle:sqljs-wasm && bun run bundle:skia-canvaskit-wasm && cd ../.. && bun run i18n:compile",
    "dev": "bun run scripts/run-ios-dedicated-sim.ts --web",
    "install:deps": "CI=1 npx expo install --check || true",
    "ios": "bun run scripts/run-ios-dedicated-sim.ts",
    "kill": "lsof -ti :5173 | xargs kill -9 2>/dev/null || true",
    "lint": "expo lint --no-cache --max-warnings 0",
    "preview": "serve -s dist -l 5173",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run scripts/setup-env.ts",
    "prestart": "bun run bundle:absurd-sql-worker && bun run bundle:sqljs-wasm && bun run bundle:skia-canvaskit-wasm",
    "start": "expo start --web",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests",
    "preweb": "bun run bundle:absurd-sql-worker && bun run bundle:sqljs-wasm && bun run bundle:skia-canvaskit-wasm",
    "web": "expo start --web"
  },
