{
  "name": "@apps/client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "bun run --cwd ../.. i18n:compile",
    "build": "vite build && bun run scripts/build-sw.ts",
    "check:bundle-budget": "bun run scripts/bundle-budget.ts dist --budget=./perf-budget.json",
    "check:production-compression": "bun run scripts/check-production-compression.ts",
    "check:live-dist": "bun run scripts/live-bundle-guard-cli.ts check-dist",
    "check:live-env": "bun run scripts/live-bundle-guard-cli.ts check-env",
    "predev": "bun run --silent setup",
    "dev": "bun run scripts/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "preview": "bun run scripts/preview-server.ts",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run --silent scripts/setup-env.ts && bun run --silent --cwd ../.. i18n:compile",
    "start": "bun run dev",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p tsconfig.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/client-app": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/tailwind": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/conf": "catalog:",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/sql-client-sqlite-web": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "workbox-build": "catalog:"
  }
}
