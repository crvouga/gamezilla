{
  "name": "@apps/client",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./providers/*": [
      "./src/providers/*.ts",
      "./src/providers/*.tsx",
      "./src/providers/*/index.ts"
    ],
    "./app": [
      "./src/app.tsx"
    ],
    "./App": [
      "./src/app.tsx"
    ],
    "./navigation/*": [
      "./src/navigation/*.ts",
      "./src/navigation/*.tsx",
      "./src/navigation/*/index.ts"
    ],
    "./sync/*": [
      "./src/sync/*.ts",
      "./src/sync/*.tsx",
      "./src/sync/*/index.ts"
    ],
    "./storage/*": [
      "./src/storage/*.ts",
      "./src/storage/*.tsx",
      "./src/storage/*/index.ts"
    ],
    "./device/*": [
      "./src/device/*.ts",
      "./src/device/*.tsx",
      "./src/device/*/index.ts"
    ],
    "./system/*": [
      "./src/system/*.ts",
      "./src/system/*.tsx",
      "./src/system/*/index.ts"
    ],
    "./i18n/*": [
      "./src/i18n/*.ts",
      "./src/i18n/*.tsx",
      "./src/i18n/*/index.ts"
    ]
  },
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "prebuild": "bun run bundle:skia-canvaskit-wasm && cd ../.. && bun run i18n:compile",
    "build": "expo customize tsconfig.json && expo export -p web && bun run scripts/build-sw.ts",
    "bundle:skia-canvaskit-wasm": "bun run scripts/bundle-skia-canvaskit-wasm.ts",
    "check:export:native": "bun run prebuild && expo export --platform android --platform ios --output-dir .check-native --clear",
    "check:production-dist": "bun run scripts/production-bundle-guard-cli.ts check-dist",
    "check:production-env": "bun run scripts/production-bundle-guard-cli.ts check-env",
    "check:production-native": "bun run scripts/production-bundle-guard-cli.ts check-native-dir",
    "predev": "bun run bundle:skia-canvaskit-wasm && cd ../.. && bun run i18n:compile",
    "dev": "expo start --port 5173",
    "dev:ios": "bun run scripts/run-ios-dedicated-sim.ts",
    "eas-build-post-install": "bun run prebuild",
    "install:deps": "CI=1 npx expo install --check || true",
    "ios": "bun run scripts/run-ios-dedicated-sim.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "preview": "bun run scripts/preview-server.ts",
    "pwa:generate": "bun run scripts/generate-pwa-assets.ts",
    "setup": "bun run scripts/setup-env.ts && bun run --filter @pkgs/sql-client build:web-workers",
    "prestart": "bun run bundle:skia-canvaskit-wasm && bun run --filter @pkgs/sql-client build:web-workers",
    "start": "expo start --web",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/integration/**'",
    "test:integration": "bun test src/integration/",
    "preweb": "bun run bundle:skia-canvaskit-wasm && bun run --filter @pkgs/sql-client build:web-workers",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@gorhom/bottom-sheet": "catalog:",
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/db": "workspace:*",
