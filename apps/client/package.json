  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@pkgs/os": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@pkgs/vitest-solid": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "workbox-build": "catalog:"
  }
}
