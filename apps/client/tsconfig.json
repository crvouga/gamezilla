      "@gamezilla/secure-storage": ["../secure-storage/src/index.ts"],
      "@gamezilla/secure-storage/*": ["../secure-storage/src/*"],
      "@gamezilla/sql-client/*": ["../sql-client/src/*"],
      "@gamezilla/sqlite": ["../sqlite/src/index.ts"],
      "@gamezilla/sqlite/*": ["../sqlite/src/*"],
      "@gamezilla/static-file-server/*": ["../static-file-server/src/*"],
      "@gamezilla/task-dag": ["../task-dag/src/index.ts"],
      "@gamezilla/task-dag/*": ["../task-dag/src/*"],
      "@gamezilla/ts-reset": ["../ts-reset/src/index.ts"],
      "@gamezilla/uuid": ["../uuid/src/index.ts"],
      "@gamezilla/uuid/*": ["../uuid/src/*"]
