      "@gamezilla/client-config/*": ["../client-config/src/*"],
      "@gamezilla/patch-db/*": ["../patch-db/src/*"],
      "@gamezilla/patch-db-example/*": ["../patch-db-example/src/*"],
      "@gamezilla/profile/*": ["../profile/src/*"],
      "@gamezilla/room": ["../room/src/index.ts"],
      "@gamezilla/room/server": ["../room/src/server.ts"],
      "@gamezilla/room/*": ["../room/src/*"],
      "@gamezilla/room-example/*": ["../room-example/src/*"],
      "@gamezilla/spaces/*": ["../spaces/src/*"],
      "@gamezilla/ui/*": ["../ui/src/*"],
      "@gamezilla/assert": ["../assert/src/index.ts"],
