      "@gamezilla/equal/*": ["../equal/src/*"],
      "@gamezilla/i18n": ["../i18n/src/index.ts"],
      "@gamezilla/i18n/*": ["../i18n/src/*"],
      "@gamezilla/keyword": ["../keyword/src/index.ts"],
      "@gamezilla/keyword/*": ["../keyword/src/*"],
      "@gamezilla/kv/*": ["../kv/src/*"],
      "@gamezilla/logger": ["../logger/src/index.ts"],
      "@gamezilla/logger/*": ["../logger/src/*"],
      "@gamezilla/message": ["../message/src/index.ts"],
      "@gamezilla/message/*": ["../message/src/*"],
      "@gamezilla/object-store/*": ["../object-store/src/*"],
