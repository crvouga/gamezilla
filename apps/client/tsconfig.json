{
  "extends": "../../tsconfig.json",
  "include": [
    "../ts-reset/src/index.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@gamezilla/api/*": ["../api/src/*"],
      "@gamezilla/app/*": ["../app/src/*"],
      "@gamezilla/auth/*": ["../auth/src/*"],
      "@gamezilla/chess/*": ["../chess/src/*"],
