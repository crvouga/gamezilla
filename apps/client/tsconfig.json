{
  "extends": "../../tsconfig.json",
  "include": [
    "../../libs/lib/src/ts-reset.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@gamezilla/lib/*": ["../../libs/lib/src/*"],
      "@gamezilla/domain/*": ["../../libs/domain/src/*"],
      "@gamezilla/patch-db/*": ["../../libs/patch-db/src/*"],
      "@gamezilla/room": ["../../libs/room/src/index.ts"],
      "@gamezilla/room/server": ["../../libs/room/src/server.ts"],
      "@gamezilla/room/*": ["../../libs/room/src/*"],
      "@gamezilla/api/*": ["../../apps/api/src/*"],
      "@gamezilla/client/*": ["../../apps/client/src/*"],
      "@gamezilla/room-example/*": ["../../libs/room-example/src/*"],
      "@gamezilla/patch-db-example/*": ["../../libs/patch-db-example/src/*"]
    }
  }
}
