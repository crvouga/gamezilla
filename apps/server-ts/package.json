    "@pkgs/tts-root-server-ts": "workspace:*",
    "@pkgs/turn-game-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@libs/app-config-shared-ts": "workspace:*",
    "@libs/chess-puzzle-server-ts": "workspace:*",
    "@libs/db-server-ts": "workspace:*",
    "@libs/games-shared-ts": "workspace:*",
    "@libs/infra-shared-ts": "workspace:*",
    "@libs/permissions-shared-ts": "workspace:*",
    "@libs/secrets-server-ts": "workspace:*",
    "@libs/spaces-shared-ts": "workspace:*",
    "@pkgs/database-url-policy-shared-ts": "workspace:*",
