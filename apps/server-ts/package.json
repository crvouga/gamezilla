{
  "name": "@apps/server-ts",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./scripts/*": "./scripts/*.ts",
    "./worker": "./src/server.ts",
    "./room": "./src/room.ts",
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "contract:write": "bun run scripts/contract-manifest.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "preview": "bun run scripts/preview.ts",
    "preview:serve": "bun run scripts/preview-serve.ts",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test integration.test",
    "verify:api": "bun run scripts/verify-api.ts"
  },
  "dependencies": {
    "@libs/app-root-server-ts": "workspace:*",
    "@libs/app-root-shared-ts": "workspace:*",
    "@libs/billing-shared-ts": "workspace:*",
    "@libs/db-shared-ts": "workspace:*",
    "@libs/game-catalog-shared-ts": "workspace:*",
    "@libs/moderation-shared-ts": "workspace:*",
    "@libs/observability-shared-ts": "workspace:*",
    "@libs/product-identity-shared-ts": "workspace:*",
    "@libs/room-app-server-ts": "workspace:*",
    "@libs/room-app-shared-ts": "workspace:*",
    "@libs/runtime-server-ts": "workspace:*",
    "@libs/runtime-shared-ts": "workspace:*",
    "@libs/sub-shared-ts": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@pkgs/assert-root-shared-ts": "workspace:*",
    "@pkgs/auth-root-shared-ts": "workspace:*",
    "@pkgs/billing-providers-server-ts": "workspace:*",
    "@pkgs/billing-root-shared-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/emqx-server-ts": "workspace:*",
    "@pkgs/feedback-server-ts": "workspace:*",
    "@pkgs/http-client-shared-ts": "workspace:*",
    "@pkgs/llm-root-server-ts": "workspace:*",
    "@pkgs/logger-shared-ts": "workspace:*",
    "@pkgs/observability-root-server-ts": "workspace:*",
    "@pkgs/observability-root-shared-ts": "workspace:*",
