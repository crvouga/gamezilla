{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "contract:write": {
      "cache": false
    },
    "build": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["kill", "install:deps", "setup"],
      "persistent": true,
      "cache": false
    },
    "preview": {
      "dependsOn": ["kill", "setup", "^build", "build"],
      "persistent": true,
      "cache": false
    },
    "migrate": {
      "dependsOn": ["kill", "setup"],
      "cache": false
    }
  }
}
