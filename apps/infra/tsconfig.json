{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@gamezilla/lib/*": ["../../libs/lib/src/*"],
      "@gamezilla/domain/*": ["../../libs/domain/src/*"]
    }
  },
  "include": ["../../libs/lib/src/ts-reset.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
