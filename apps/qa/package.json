{
  "name": "@gamezilla/qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api": "bun test ./src/api/",
    "browser": "playwright test --config src/browser/playwright.config.mjs",
    "qa": "bun run api && bun run browser",
    "browser:ui": "playwright test --config src/browser/playwright.config.mjs --ui",
    "browser:headed": "playwright test --config src/browser/playwright.config.mjs --headed",
    "tc": "tsc --noEmit -p ./tsconfig.json",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.9",
    "@types/node": "^20.17.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.54.0"
  }
}
