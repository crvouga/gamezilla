{
  "name": "@gamezilla/db",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./migrations/run-postgres-migrations": "./src/migrations/run-postgres-migrations.ts",
    "./migrations/better-auth-doppler-options": "./src/migrations/better-auth-doppler-options.ts"
  },
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "build": "bun -e \"process.exit(0)\"",
    "tc": "tsc --noEmit -p tsconfig.json",
    "setup": "bun -e \"process.exit(0)\"",
    "test": "bun test",
    "dev": "bun run src/pglite-socket.ts",
    "up": "bun run src/pglite-socket.ts",
    "start-daemon": "bun run src/start-background.ts",
    "migrate": "bun run scripts/migrate-db.ts",
    "preview": "bun run src/pglite-socket.ts",
    "kill": "PORT=\"${PGLITE_PORT:-5432}\"; pids=\"$(lsof -tiTCP:\"$PORT\" -sTCP:LISTEN 2>/dev/null || true)\"; if [ -n \"$pids\" ]; then echo \"$pids\" | xargs kill -TERM 2>/dev/null || true; fi",
    "stop": "bun run kill"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.9",
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.0.21",
    "@gamezilla/lib": "workspace:*",
    "@gamezilla/patch-db": "workspace:*",
    "better-auth": "^1.6.9",
    "kysely": "^0.28.9",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/pg": "^8.11.10",
    "typescript": "~5.9.2"
  }
}
