    "@pkgs/sim": "workspace:*",
    "@pkgs/sim-console": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
