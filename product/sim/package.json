{
  "name": "@product/sim",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./fabric/*": [
      "./src/fabric/*.ts",
      "./src/fabric/*/index.ts"
    ],
    "./hosts/*": [
      "./src/hosts/*.ts",
      "./src/hosts/*/index.ts"
    ],
    "./setup/*": [
      "./src/setup/*.ts",
      "./src/setup/*/index.ts"
    ],
    "./system/*": [
      "./src/system/*.ts",
      "./src/system/*/index.ts"
    ]
  },
  "scripts": {
    "tc": "tsc --noEmit -p ./tsconfig.json",
    "seed:sim-db": "bun scripts/build-sim-seed.ts"
  },
