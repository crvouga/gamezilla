{
  "expo": {
    "name": "console",
    "slug": "console",
    "owner": "crvouga",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "gamezilla-console",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gamezilla.console",
      "deploymentTarget": "17.0"
    },
    "android": {
      "package": "app.gamezilla.console"
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-sqlite", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "reactCompiler": true
    }
  }
}
