{
  "name": "@product/console",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./playground/*": [
      "./src/playground/*.ts",
      "./src/playground/*.tsx",
      "./src/playground/*/index.ts"
    ],
    "./console-nav/*": [
      "./src/console-nav/*.ts",
      "./src/console-nav/*.tsx",
      "./src/console-nav/*/index.ts"
    ]
  },
  "scripts": {
    "prebuild": "bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client-sqlite-web build:web-workers && cd ../.. && bun run i18n:compile",
    "build": "vite build",
    "bundle:sim-sql-wasm": "bun run scripts/bundle-sim-sql-wasm.ts",
    "deploy": "bun run scripts/deploy.ts",
    "predev": "bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client-sqlite-web build:web-workers && cd ../.. && bun run i18n:compile",
    "dev": "bun run scripts/dev.ts",
    "kill": "bun run scripts/kill-dev.ts",
    "kill-dev": "bun run scripts/kill-dev.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "setup": "bun run bundle:sim-sql-wasm && bun run --filter @pkgs/sql-client-sqlite-web build:web-workers",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/console-nav src/playground/playground-snapshot-prune.test.ts"
  },
  "dependencies": {
    "@apps/client": "workspace:*",
    "@apps/room-server": "workspace:*",
    "@apps/server": "workspace:*",
    "@libs/auth": "workspace:*",
    "@libs/chess": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/games": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/runtime": "workspace:*",
    "@libs/secrets": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assert-crash-browser": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/browser": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/entity-store": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/llm": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/minio-server": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/object-store-opfs": "workspace:*",
    "@pkgs/observability": "workspace:*",
    "@pkgs/polyfill": "workspace:*",
    "@pkgs/postgres-embedded": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secure-storage": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/sim-console": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/tts": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/uuid": "workspace:*",
