    "@lingui/conf": "catalog:",
    "@pkgs/os": "workspace:*",
    "@pkgs/vite-workspace-resolver": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
