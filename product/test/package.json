{
  "name": "@product/test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "seed:sim-db": "bun run --filter @product/sim seed:sim-db",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 bunx jest --config ./jest.config.cjs --runInBand",
    "test:debug-handles": "NODE_OPTIONS=--max-old-space-size=8192 bunx jest --config ./jest.config.cjs --runInBand --detectOpenHandles",
