  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "seed:sim-db": "bun run --filter @product/sim seed:sim-db",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 bun test --preload ./bun-babel-plugin.ts --preload ./bun-preload.ts --timeout 90000 tests",
