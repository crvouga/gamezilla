{
  "name": "@gamezilla/aws",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p ./tsconfig.json",
    "cdk": "cdk",
    "setup": "bun run ./src/bin/setup-cli.ts",
    "deploy": "bun run ./src/bin/deployment-pipeline-cli.ts cdk-deploy && bun run ./src/bin/deployment-pipeline-cli.ts deploy-apps",
    "deploy:postchecks": "bun run ./src/bin/deployment-pipeline-cli.ts post-deploy",
    "deploy:prechecks": "bun run ./src/bin/deployment-pipeline-cli.ts preflight",
    "deploy:summary": "bun run ./src/bin/deployment-pipeline-cli.ts write-summary",
    "unprovision": "bun run ./src/bin/deployment-pipeline-cli.ts cdk-destroy",
    "watch": "tsc -w",
    "lint": "eslint .",
    "tc": "tsc --noEmit -p ./tsconfig.json",
    "test": "echo 'TODO: test'",
    "diagram": "cdk synth --quiet && bunx tsx src/bin/diagram.ts",
    "diagram:install": "brew install graphviz",
    "diagram:cdk-dia": "cdk synth --quiet && bun x cdk-dia",
    "diagram:cdk-dia:html": "cdk synth --quiet && bun x cdk-dia --rendering cytoscape-html",
    "diagram:cdk-dia:html:preview": "bun run diagram:cdk-dia:html && bun x serve diagram"
  },
  "dependencies": {
    "@gamezilla/shared": "workspace:*",
    "aws-cdk-lib": "^2.247.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1018.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1023.0",
    "@aws-sdk/client-ec2": "^3.1024.0",
    "@aws-sdk/client-ecs": "^3.1023.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1024.0",
    "@aws-sdk/client-sts": "^3.1018.0",
    "@types/node": "^20.17.0",
    "aws-cdk": "^2.1116.0",
    "cdk-dia": "^0.12.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
