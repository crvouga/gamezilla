digraph Architecture {
  graph [
    rankdir = "TB"
    fontname = "Helvetica"
    fontsize = 14
    bgcolor = "white"
    pad = 0.4
    nodesep = 0.6
    ranksep = 1.0
    splines = "line"
    compound = true
    newrank = true
  ];

  node [
    shape = "box"
    style = "filled,rounded"
    fontname = "Helvetica"
    fontsize = 11
    fillcolor = "#ffffff"
    color = "#cccccc"
    penwidth = 1.5
    width = 2.6
    height = 0.8
  ];

  edge [
    color = "#555555"
    penwidth = 1.5
    arrowsize = 0.7
    fontname = "Helvetica"
    fontsize = 9
  ];

  subgraph "cluster_static" {
    label = "Static Sites";
    labeljust = "l";
    fontsize = 13;
    fontcolor = "#1565c0";
    style = "filled,rounded";
    fillcolor = "#e3f2fd";
    color = "#1565c040";
    penwidth = 1.5;
    margin = 16;

    "WebApp" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2"><FONT FACE="Helvetica" POINT-SIZE="11">Web App</FONT></TD></TR><TR><TD><IMG SRC="icons/s3.svg"/></TD><TD><IMG SRC="icons/cloudfront.svg"/></TD></TR><TR><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">S3</FONT></TD><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">CloudFront</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_network" {
    label = "VPC";
    labeljust = "l";
    fontsize = 13;
    fontcolor = "#6a1b9a";
    style = "filled,rounded";
    fillcolor = "#f3e5f5";
    color = "#6a1b9a40";
    penwidth = 2;
    margin = 20;

    subgraph "cluster_compute" {
      label = "Compute";
      labeljust = "l";
      fontsize = 13;
      fontcolor = "#e65100";
      style = "filled,rounded";
      fillcolor = "#fff3e0";
      color = "#e6510040";
      penwidth = 1.5;
      margin = 16;

      "ReqRes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><FONT FACE="Helvetica" POINT-SIZE="11">Req-Res Server</FONT></TD></TR><TR><TD><IMG SRC="icons/fargate.svg"/></TD><TD><IMG SRC="icons/elb.svg"/></TD><TD><IMG SRC="icons/cloudfront.svg"/></TD></TR><TR><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">Fargate</FONT></TD><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">ALB</FONT></TD><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">CloudFront</FONT></TD></TR></TABLE>>];
      "Emqx" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2"><FONT FACE="Helvetica" POINT-SIZE="11">Pub/Sub Broker</FONT></TD></TR><TR><TD><IMG SRC="icons/fargate.svg"/></TD><TD><IMG SRC="icons/elb.svg"/></TD></TR><TR><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">Fargate</FONT></TD><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">NLB</FONT></TD></TR></TABLE>>];
      "Worker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT FACE="Helvetica" POINT-SIZE="11">Worker</FONT></TD></TR><TR><TD><IMG SRC="icons/fargate.svg"/></TD></TR><TR><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">Fargate</FONT></TD></TR></TABLE>>];
    }

    subgraph "cluster_data" {
      label = "Data";
      labeljust = "l";
      fontsize = 13;
      fontcolor = "#2e7d32";
      style = "filled,rounded";
      fillcolor = "#e8f5e9";
      color = "#2e7d3240";
      penwidth = 1.5;
      margin = 16;

      "Database" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT FACE="Helvetica" POINT-SIZE="11">Aurora PostgreSQL</FONT></TD></TR><TR><TD><IMG SRC="icons/aurora.svg"/></TD></TR><TR><TD><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#666666">Aurora</FONT></TD></TR></TABLE>>];
    }

  }

  ReqRes -> Database;
  ReqRes -> Emqx [constraint=false];
  WebApp -> Emqx;
  WebApp -> ReqRes;
  Worker -> Database;
  Worker -> Emqx [constraint=false];
}
