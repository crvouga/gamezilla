{
  "name": "@gamezilla/chess",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@gamezilla/assert": "workspace:*",
    "@gamezilla/assistant": "workspace:*",
    "@gamezilla/attribute": "workspace:*",
    "@gamezilla/auth": "workspace:*",
    "@gamezilla/logger": "workspace:*",
    "@gamezilla/message": "workspace:*",
    "@gamezilla/patch-db": "workspace:*",
    "@gamezilla/room": "workspace:*",
    "@gamezilla/secret-store": "workspace:*",
    "@gamezilla/spaces": "workspace:*",
    "@gamezilla/sql-client": "workspace:*",
    "@gamezilla/ui": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@shopify/react-native-skia": "catalog:",
    "chess.js": "catalog:",
    "csv-parse": "catalog:",
    "expo-audio": "catalog:",
    "expo-haptics": "catalog:",
    "fzstd": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
