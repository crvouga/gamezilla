{
  "name": "@gamezilla/api",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun -e \"process.exit(0)\"",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "dev": "bun run --filter @gamezilla/client-config dev:refresh & wrangler dev --port 8788 --inspector-port 9231",
    "kill": "lsof -ti :8788 | xargs kill -9 2>/dev/null || true",
    "lint": "eslint src --max-warnings 0",
    "preview": "wrangler dev --port 8788",
    "setup": "bun run scripts/setup-dev-vars.ts && bun run scripts/setup-better-auth-secret.ts",
    "stripe:check": "bun run --filter @gamezilla/stripe check",
    "stripe:sync": "bun run --filter @gamezilla/stripe sync",
    "tc": "tsc --noEmit -p ../../tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@gamezilla/app": "workspace:*",
    "@gamezilla/auth": "workspace:*",
    "@gamezilla/chess": "workspace:*",
    "@gamezilla/client-config": "workspace:*",
    "@gamezilla/llm": "workspace:*",
    "@gamezilla/lib": "workspace:*",
    "@gamezilla/patch-db": "workspace:*",
    "@gamezilla/profile": "workspace:*",
    "@gamezilla/room": "workspace:*",
    "@gamezilla/spaces": "workspace:*",
    "@gamezilla/stripe": "workspace:*",
    "@gamezilla/tts": "workspace:*",
    "hono": "catalog:",
    "pg": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
