{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@gamezilla/api/*": ["../../apps/api/src/*"],
      "@gamezilla/auth/*": ["../../libs/auth/src/*"],
      "@gamezilla/client/*": ["../../apps/client/src/*"],
      "@gamezilla/lib/*": ["../../libs/lib/src/*"],
      "@gamezilla/spaces/*": ["../../libs/spaces/src/*"],
      "@gamezilla/client-config/*": ["../../libs/client-config/src/*"]
    }
  },
  "include": ["../../libs/lib/src/ts-reset.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
