language js

or {
  `from '@pkgs/auth-better-auth'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth only in the adapter or allowlisted composition roots.", severity="error")
  },
  `from "@pkgs/auth-better-auth"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth only in the adapter or allowlisted composition roots.", severity="error")
  },
  `from '@pkgs/auth-better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth only in the adapter or allowlisted composition roots.", severity="error")
  },
  `from "@pkgs/auth-better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth only in the adapter or allowlisted composition roots.", severity="error")
  }
}
