language js

or {
  `from 'better-auth'` as $imp where {
    register_diagnostic(span=$imp, message="better-auth SDK only inside pkgs/auth-better-auth.", severity="error")
  },
  `from "better-auth"` as $imp where {
    register_diagnostic(span=$imp, message="better-auth SDK only inside pkgs/auth-better-auth.", severity="error")
  },
  `from 'better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="better-auth SDK only inside pkgs/auth-better-auth.", severity="error")
  },
  `from "better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="better-auth SDK only inside pkgs/auth-better-auth.", severity="error")
  },
  `from '@better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="@better-auth/* only inside pkgs/auth-better-auth.", severity="error")
  },
  `from "@better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="@better-auth/* only inside pkgs/auth-better-auth.", severity="error")
  }
}
