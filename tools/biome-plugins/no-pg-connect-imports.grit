language js

or {
  `from '@pkgs/sql-client/postgres/connect'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/sql-client/postgres/connect is wall-only — use ensure-schema / injected OpenRequestDb outside allowlisted openers.", severity="error")
  },
  `from "@pkgs/sql-client/postgres/connect"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/sql-client/postgres/connect is wall-only — use ensure-schema / injected OpenRequestDb outside allowlisted openers.", severity="error")
  },
  `from '@pkgs/sql-client/postgres/ping'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/sql-client/postgres/ping is wall-only.", severity="error")
  },
  `from "@pkgs/sql-client/postgres/ping"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/sql-client/postgres/ping is wall-only.", severity="error")
  }
}
