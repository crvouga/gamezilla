language js

or {
  `Date.now()` as $call where {
    register_diagnostic(span=$call, message="Inject Clock — do not call Date.now outside @io-wall-ok entry roots.", severity="error")
  },
  `Date.now` as $id where {
    register_diagnostic(span=$id, message="Inject Clock — do not use Date.now outside @io-wall-ok entry roots.", severity="error")
  },
  `performance.now()` as $call where {
    register_diagnostic(span=$call, message="Inject Clock — do not call performance.now outside @io-wall-ok entry roots.", severity="error")
  },
  `performance.now` as $id where {
    register_diagnostic(span=$id, message="Inject Clock — do not use performance.now outside @io-wall-ok entry roots.", severity="error")
  },
  `new Date()` as $call where {
    register_diagnostic(span=$call, message="Inject Clock — do not use new Date() outside @io-wall-ok entry roots.", severity="error")
  },
  `setTimeout($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call setTimeout outside @io-wall-ok entry roots.", severity="error")
  },
  `setInterval($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call setInterval outside @io-wall-ok entry roots.", severity="error")
  },
  `clearTimeout($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call clearTimeout outside @io-wall-ok entry roots.", severity="error")
  },
  `clearInterval($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call clearInterval outside @io-wall-ok entry roots.", severity="error")
  },
  `globalThis.setTimeout($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call globalThis.setTimeout outside @io-wall-ok entry roots.", severity="error")
  },
  `globalThis.setInterval($args)` as $call where {
    register_diagnostic(span=$call, message="Inject Timers — do not call globalThis.setInterval outside @io-wall-ok entry roots.", severity="error")
  },
  `fetch($args)` as $call where {
    register_diagnostic(span=$call, message="Inject HTTP client — do not call bare fetch outside @io-wall-ok entry roots.", severity="error")
  },
  `globalThis.fetch` as $id where {
    register_diagnostic(span=$id, message="Inject HTTP client — do not use globalThis.fetch outside @io-wall-ok entry roots.", severity="error")
  },
  `crypto.randomUUID()` as $call where {
    register_diagnostic(span=$call, message="Inject createId — do not call crypto.randomUUID outside @io-wall-ok entry roots.", severity="error")
  },
  `crypto.randomUUID` as $id where {
    register_diagnostic(span=$id, message="Inject createId — do not use crypto.randomUUID outside @io-wall-ok entry roots.", severity="error")
  },
  `Math.random()` as $call where {
    register_diagnostic(span=$call, message="Inject random — do not call Math.random outside @io-wall-ok entry roots.", severity="error")
  },
  `Math.random` as $id where {
    register_diagnostic(span=$id, message="Inject random — do not use Math.random outside @io-wall-ok entry roots.", severity="error")
  },
  `crypto.getRandomValues($args)` as $call where {
    register_diagnostic(span=$call, message="Inject random — do not call crypto.getRandomValues outside @io-wall-ok entry roots.", severity="error")
  },
  `randomUUID($args)` as $call where {
    register_diagnostic(span=$call, message="Inject createId — do not call randomUUID outside @io-wall-ok entry roots.", severity="error")
  },
  `randomBytes($args)` as $call where {
    register_diagnostic(span=$call, message="Inject random — do not call randomBytes outside @io-wall-ok entry roots.", severity="error")
  }
}
