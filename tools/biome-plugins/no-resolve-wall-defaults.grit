language js

or {
  `resolveNow` as $id where {
    register_diagnostic(span=$id, message="resolveNow is removed — inject Clock via constructor or useClock.", severity="error")
  },
  `resolveTimers` as $id where {
    register_diagnostic(span=$id, message="resolveTimers is removed — inject Timers via constructor or useTimers.", severity="error")
  },
  `resolveCreateId` as $id where {
    register_diagnostic(span=$id, message="resolveCreateId is removed — inject createId via constructor or useCreateId.", severity="error")
  },
  `resolveRandom` as $id where {
    register_diagnostic(span=$id, message="resolveRandom is removed — inject random via constructor.", severity="error")
  },
  `resolveClock` as $id where {
    register_diagnostic(span=$id, message="resolveClock is removed — inject Clock via constructor or useClock.", severity="error")
  },
  `cryptoCreateId` as $id where {
    register_diagnostic(span=$id, message="cryptoCreateId is removed — use crypto.randomUUID only at @io-wall-ok roots.", severity="error")
  },
  `mathRandom` as $id where {
    register_diagnostic(span=$id, message="mathRandom is removed — use Math.random only at @io-wall-ok roots.", severity="error")
  }
}
