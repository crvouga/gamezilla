language js

or {
  `run.apply(settle)` as $x where {
    register_diagnostic(span=$x, message="settle is not an action — use untilObserved(run, quiet, passTime).", severity="error")
  },
  `run.apply(converge)` as $x where {
    register_diagnostic(span=$x, message="converge is not an action — use expectConverged(run) or revive + untilObserved(converged).", severity="error")
  },
  `run.apply(assertConverged)` as $x where {
    register_diagnostic(span=$x, message="assertConverged is not an action — use expectConverged(run) or revive + untilObserved(converged).", severity="error")
  },
  `run.apply(waitUntilMatched)` as $x where {
    register_diagnostic(span=$x, message="waitUntilMatched is not an action — use untilObserved(run, matched(...), passTime).", severity="error")
  },
  `run.apply(waitNeverMatched)` as $x where {
    register_diagnostic(span=$x, message="waitNeverMatched is not an action — use neverObserved(run, matched(...), passTime).", severity="error")
  },
  `run.apply(uiWait)` as $x where {
    register_diagnostic(span=$x, message="uiWait is not an action — wait via untilObserved on UI observations + passTime.", severity="error")
  },
  `name: 'settle'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named settle — use quiet observation + untilObserved.", severity="error")
  },
  `name: 'converge'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named converge — use revive stimulus + converged observation.", severity="error")
  },
  `name: 'assertConverged'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named assertConverged — use converged observation.", severity="error")
  },
  `name: 'waitUntilMatched'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named waitUntilMatched — use matched observation + untilObserved.", severity="error")
  },
  `name: 'waitNeverMatched'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named waitNeverMatched — use matched observation + neverObserved.", severity="error")
  },
  `name: 'uiWait'` as $x where {
    register_diagnostic(span=$x, message="Do not defineAction named uiWait — use UI observations + untilObserved.", severity="error")
  }
}
