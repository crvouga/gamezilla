    "@libs/permissions-shared-ts": "workspace:*",
    "@libs/spaces-harness-ts": "workspace:*",
    "@libs/test-ids-shared-ts": "workspace:*",
    "@pkgs/device-shared-ts": "workspace:*",
    "@pkgs/gherkin-shared-ts": "workspace:*",
    "@pkgs/matchmaking-sql-shared-ts": "workspace:*",
    "@pkgs/sounds-shared-ts": "workspace:*",
