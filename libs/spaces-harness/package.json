{
  "name": "@libs/spaces-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@libs/billing-shared": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/spaces-client": "workspace:*",
    "@libs/spaces-server": "workspace:*",
    "@libs/spaces-shared": "workspace:*",
    "@libs/sub-shared": "workspace:*",
    "@libs/test-ids-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/message-shared": "workspace:*",
    "@pkgs/outbox-shared": "workspace:*",
    "@pkgs/room-adapter-memory-shared": "workspace:*",
    "@pkgs/room-root-server": "workspace:*",
    "@pkgs/room-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/db-schema-root-shared": "workspace:*",
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/sql-client-root-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-root-server": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness"
}
