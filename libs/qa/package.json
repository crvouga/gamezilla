{
  "name": "@libs/qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api": "bun test ./src/api/",
    "browser": "bun --bun x playwright test --config src/playwright/playwright.config.ts",
    "browser:headed": "bun --bun x playwright test --config src/playwright/playwright.config.ts --headed",
    "browser:ui": "bun --bun x playwright test --config src/playwright/playwright.config.ts --ui",
    "install:browsers": "bun --bun x playwright install --with-deps chromium",
    "lint": "eslint src --max-warnings 0",
    "native": "bun run native:bundle && bun run native:launch",
    "native:bundle": "bun test ./src/native/",
    "native:launch": "bun --bun x playwright test --config src/playwright/playwright.native.config.ts",
    "qa": "bun run api && bun run browser",
    "report": "bun --bun x playwright show-report playwright-report",
    "tc": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "@libs/client-config": "workspace:*",
    "@libs/infra": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql-client": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
