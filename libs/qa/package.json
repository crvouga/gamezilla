{
  "name": "@libs/qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api": "bun test ./src/api/",
    "browser": "bun --bun x playwright test --config src/browser/playwright.config.ts",
    "browser:headed": "bun --bun x playwright test --config src/browser/playwright.config.ts --headed",
    "browser:ui": "bun --bun x playwright test --config src/browser/playwright.config.ts --ui",
    "install:browsers": "bun --bun x playwright install --with-deps chromium",
    "lint": "eslint src --max-warnings 0",
    "qa": "bun run api && bun run browser",
    "tc": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "@libs/client-config": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/secret-store": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
