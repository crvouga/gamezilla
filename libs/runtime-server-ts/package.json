{
  "name": "@libs/runtime-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "db:wipe:dev": "bun run scripts/wipe-dev-db.ts",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "migrate": "bun run scripts/migrate-cli.ts --wait",
    "schema:snapshot": "bun run scripts/schema-snapshot.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='**/*.contract.test.ts' tests",
    "test:contract": "bun test --timeout 30000 tests/mockingbird-reconcile.contract.test.ts",
    "verify:schema-evolution": "bun run scripts/verify-schema-evolution.ts"
  },
  "dependencies": {
    "@libs/account-privacy-server-ts": "workspace:*",
    "@libs/auth-server-ts": "workspace:*",
    "@libs/billing-server-ts": "workspace:*",
    "@libs/chess-root-server-ts": "workspace:*",
    "@libs/db-server-ts": "workspace:*",
    "@libs/db-shared-ts": "workspace:*",
    "@libs/friends-server-ts": "workspace:*",
    "@libs/friends-shared-ts": "workspace:*",
    "@libs/game-catalog-shared-ts": "workspace:*",
    "@libs/game-puzzle-shared-ts": "workspace:*",
    "@libs/game-session-server-ts": "workspace:*",
    "@libs/infra-shared-ts": "workspace:*",
    "@libs/notifications-server-ts": "workspace:*",
    "@libs/runtime-shared-ts": "workspace:*",
    "@libs/spaces-server-ts": "workspace:*",
    "@libs/sub-shared-ts": "workspace:*",
    "@libs/synthetic-population-server-ts": "workspace:*",
    "@pkgs/assert-root-shared-ts": "workspace:*",
    "@pkgs/auth-inhouse-server-ts": "workspace:*",
    "@pkgs/auth-root-shared-ts": "workspace:*",
    "@pkgs/billing-root-shared-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/db-indexes-postgres-shared-ts": "workspace:*",
    "@pkgs/db-indexes-root-shared-ts": "workspace:*",
    "@pkgs/db-schema-postgres-shared-ts": "workspace:*",
    "@pkgs/entity-store-shared-ts": "workspace:*",
    "@pkgs/kv-postgres-shared-ts": "workspace:*",
    "@pkgs/logger-shared-ts": "workspace:*",
    "@pkgs/matchmaking-sql-shared-ts": "workspace:*",
    "@pkgs/object-store-node-fs-server-ts": "workspace:*",
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/outbox-shared-ts": "workspace:*",
    "@pkgs/postgres-sqlite-compat-shared-ts": "workspace:*",
    "@pkgs/room-root-shared-ts": "workspace:*",
    "@pkgs/secret-store-shared-ts": "workspace:*",
    "@pkgs/secrets-config-server-ts": "workspace:*",
    "@pkgs/sql-client-postgres-server-ts": "workspace:*",
    "@pkgs/sql-client-postgres-shared-ts": "workspace:*",
    "@pkgs/sql-client-root-shared-ts": "workspace:*",
    "@pkgs/sql-root-shared-ts": "workspace:*",
    "@pkgs/sync-engine-shared-ts": "workspace:*",
    "@pkgs/uuid-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/database-url-policy-shared-ts": "workspace:*",
