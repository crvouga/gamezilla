{
  "name": "@libs/search",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json"
  },
  "dependencies": {
    "@libs/feature": "workspace:*",
    "@libs/sim-harness": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@libs/user-search": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
