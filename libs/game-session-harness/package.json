    "@libs/game-matchmaking-harness": "workspace:*",
    "@libs/game-menu-client": "workspace:*",
    "@libs/game-puzzle-client": "workspace:*",
    "@libs/game-puzzle-shared": "workspace:*",
    "@libs/game-session-client": "workspace:*",
    "@libs/game-session-server": "workspace:*",
    "@libs/game-session-shared": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/notifications-harness": "workspace:*",
    "@libs/profile-harness": "workspace:*",
    "@libs/search-harness": "workspace:*",
