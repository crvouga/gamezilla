{
  "name": "@libs/chess-shared-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "verify:board-contract": "bun run ../tools/scripts/verify-board-contract.ts"
  },
  "dependencies": {
    "@libs/chess-root-shared": "workspace:*",
    "@libs/permissions-client": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/spaces-client": "workspace:*",
    "@lingui/solid": "catalog:",
    "@pkgs/chess-board-root-client": "workspace:*",
    "@pkgs/sounds-client": "workspace:*",
    "@pkgs/ui-root-client": "workspace:*",
    "@pkgs/ui-root-shared": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "game": "chess"
}
