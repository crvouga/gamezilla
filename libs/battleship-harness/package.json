{
  "name": "@libs/battleship-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepare:spec": "bun run --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client/register ../../libs/harness/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload --preload @libs/harness/preload tests",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/10",
    "test:spec:1": "bun run ../../libs/harness/scripts/test-spec.ts --part 1/10",
    "test:spec:2": "bun run ../../libs/harness/scripts/test-spec.ts --part 2/10",
    "test:spec:3": "bun run ../../libs/harness/scripts/test-spec.ts --part 3/10",
    "test:spec:4": "bun run ../../libs/harness/scripts/test-spec.ts --part 4/10",
    "test:spec:5": "bun run ../../libs/harness/scripts/test-spec.ts --part 5/10",
    "test:spec:6": "bun run ../../libs/harness/scripts/test-spec.ts --part 6/10",
    "test:spec:7": "bun run ../../libs/harness/scripts/test-spec.ts --part 7/10",
    "test:spec:8": "bun run ../../libs/harness/scripts/test-spec.ts --part 8/10",
    "test:spec:9": "bun run ../../libs/harness/scripts/test-spec.ts --part 9/10",
    "verify:models": "bun run ../../libs/tools/scripts/verify-models.ts"
  },
  "dependencies": {
    "@libs/battleship-client": "workspace:*",
    "@libs/battleship-shared": "workspace:*",
    "@libs/game-session-harness": "workspace:*",
    "@libs/harness": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "game": "battleship",
  "specDomains": [
    "battleship"
  ],
  "specParts": 10
}
