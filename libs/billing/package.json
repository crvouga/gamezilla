    "@libs/infra": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/billing-mock": "workspace:*",
    "@pkgs/billing-mock-provider": "workspace:*",
    "@pkgs/billing-providers": "workspace:*",
