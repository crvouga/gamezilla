{
  "name": "@libs/billing",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx"
    ]
  },
  "scripts": {
    "billing:sync": "bun run scripts/sync-billing-offer.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "bun run ../../libs/sim-harness/scripts/test-e2e.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@libs/auth": "workspace:*",
    "@libs/client-app": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@libs/sim-harness": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/billing-mock": "workspace:*",
    "@pkgs/billing-mock-provider": "workspace:*",
    "@pkgs/billing-providers": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lingui/core": "catalog:",
    "@pkgs/billing-paddle": "workspace:*",
    "@pkgs/billing-stripe": "workspace:*",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
