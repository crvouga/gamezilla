{
  "name": "@libs/billing",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./steps/*": "./tests/steps/*.ts"
  },
  "scripts": {
    "billing:sync": "bun run scripts/sync-billing-offer.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --path-ignore-patterns='tests/harness/**'",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/3",
    "test:spec:1": "bun run ../../libs/harness/scripts/test-spec.ts --part 1/3",
    "test:spec:2": "bun run ../../libs/harness/scripts/test-spec.ts --part 2/3"
  },
