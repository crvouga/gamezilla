{
  "name": "@libs/billing",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ]
  },
  "scripts": {
    "billing:check": "bun run scripts/check-billing-offer.ts",
    "billing:sync": "bun run scripts/sync-billing-offer.ts",
    "build:mock-billing": "bun run scripts/build-mock-billing.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@libs/auth": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@pkgs/billing": "workspace:*",
    "@pkgs/billing-stripe": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/static-file-server": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
