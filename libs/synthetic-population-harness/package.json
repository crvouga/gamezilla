{
  "name": "@libs/synthetic-population-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "prepare:spec": "bun run --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client/register ../../libs/harness/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/1"
  },
  "dependencies": {
    "@libs/app-config-shared": "workspace:*",
    "@libs/game-catalog-shared": "workspace:*",
    "@libs/game-matchmaking-harness": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/profile-harness": "workspace:*",
    "@libs/spaces-harness": "workspace:*",
    "@libs/sub-shared": "workspace:*",
    "@libs/synthetic-population-client": "workspace:*",
    "@libs/synthetic-population-server": "workspace:*",
    "@libs/synthetic-population-shared": "workspace:*",
    "@libs/test-ids-shared": "workspace:*",
    "@pkgs/dmn-shared": "workspace:*",
    "@pkgs/permissions-shared": "workspace:*",
    "@pkgs/quint-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-server": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@libs/game-session-harness": "workspace:*",
    "@libs/games-harness": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "specDomains": [
    "synthetic-population"
  ],
  "specParts": 1
}
