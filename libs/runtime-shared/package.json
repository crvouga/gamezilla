{
  "name": "@libs/runtime-shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@libs/account-privacy-shared": "workspace:*",
    "@libs/app-config-shared": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/billing-shared": "workspace:*",
    "@libs/chess-feature-shared": "workspace:*",
    "@libs/feature-shared": "workspace:*",
    "@libs/friends-shared": "workspace:*",
    "@libs/notifications-shared": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/profile-shared": "workspace:*",
    "@libs/spaces-shared": "workspace:*",
    "@pkgs/db-indexes-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "isomorphic"
}
