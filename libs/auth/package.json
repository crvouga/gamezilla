    "@gamezilla/patch-db": "workspace:*",
    "@gamezilla/secret-store": "workspace:*",
    "@gamezilla/secure-storage": "workspace:*",
    "@gamezilla/sql-client": "workspace:*",
    "@gamezilla/ui": "workspace:*",
    "@gamezilla/uuid": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "better-auth": "catalog:",
    "expo-constants": "catalog:",
    "expo-device": "catalog:",
