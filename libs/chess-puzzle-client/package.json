{
  "name": "@libs/chess-puzzle-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests",
    "verify:board-contract": "bun run ../tools/scripts/verify-board-contract.ts"
  },
  "dependencies": {
    "@libs/auth-client": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/chess-puzzle-shared": "workspace:*",
    "@libs/chess-root-shared": "workspace:*",
    "@libs/game-puzzle-client": "workspace:*",
    "@libs/game-puzzle-shared": "workspace:*",
    "@libs/permissions-client": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/sub-client": "workspace:*",
    "@libs/test-ids-shared": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/chess-board-root-client": "workspace:*",
    "@pkgs/chess-rules-shared": "workspace:*",
    "@pkgs/http-client-client": "workspace:*",
    "@pkgs/sounds-client": "workspace:*",
    "@pkgs/sounds-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-client": "workspace:*",
    "@pkgs/ui-root-client": "workspace:*",
    "@pkgs/uuid-client": "workspace:*",
    "fzstd": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "game": "chess"
}
