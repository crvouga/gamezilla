{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "src": {
      "dependsOn": [
        "@libs/game-matchmaking-shared-ts#src",
        "@libs/game-puzzle-shared-ts#src",
        "@libs/permissions-shared-ts#src",
        "@libs/spaces-shared-ts#src",
        "@libs/sub-shared-ts#src",
        "@pkgs/attribute-shared-ts#src",
        "@pkgs/clock-shared-ts#src",
        "@pkgs/message-shared-ts#src",
        "@pkgs/observability-root-shared-ts#src",
        "@pkgs/room-root-shared-ts#src",
        "@pkgs/sql-root-shared-ts#src",
        "@pkgs/sync-engine-shared-ts#src",
        "@pkgs/turn-game-shared-ts#src",
        "@pkgs/ui-testing-root-shared-ts#src",
        "@pkgs/uuid-shared-ts#src"
      ]
    },
    "test": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/turbo-platform-key.json",
        "$TURBO_ROOT$/libs/games-shared-ts/package.json",
        "$TURBO_ROOT$/libs/games-shared-ts/src/game-plugins.ts"
      ],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    }
  }
}
