{
  "name": "@libs/secrets",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts"
    ],
    "./shared/*": [
      "./src/shared/*.ts"
    ]
  },
  "scripts": {
    "check": "bun run src/bin/check-secrets.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "provision": "bun run src/scripts/provision-secrets.ts",
    "seed:auth-secret": "bun run src/scripts/seed-auth-secret.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@libs/db": "workspace:*",
    "@libs/object-store": "workspace:*",
    "@libs/pubsub": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async": "workspace:*",
    "@pkgs/billing-stripe": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/database-url-policy": "workspace:*",
    "@pkgs/emqx-server": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/object-store-s3": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "picocolors": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
