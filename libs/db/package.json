{
  "name": "@libs/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts"
    ],
    "./shared/*": [
      "./src/shared/*.ts"
    ],
    "./server/*": [
      "./src/server/*.ts"
    ],
    "./scripts/*": [
      "./src/scripts/*.ts"
    ]
  },
  "scripts": {
    "health": "bun test --timeout 60000 ./health/*.health.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json"
  },
  "dependencies": {
    "@pkgs/clock": "workspace:*",
    "@pkgs/database-url-policy": "workspace:*",
    "@pkgs/distributed-lock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv-postgres": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "pg": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
