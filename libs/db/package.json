{
  "name": "@libs/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/inbox": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
