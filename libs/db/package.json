{
  "name": "@libs/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts"
    ],
    "./shared/*": [
      "./src/shared/*.ts"
    ],
    "./server/*": [
      "./src/server/*.ts"
    ],
    "./bin/*": [
      "./src/bin/*.ts"
    ]
  },
  "scripts": {
    "check": "bun run src/bin/check-migrate-policy.ts",
    "db:wipe:dev": "bun run src/scripts/wipe-dev-db.ts",
    "migrate": "bun run src/bin/migrate-cli.ts --wait",
    "provision": "bun run src/scripts/provision-postgres.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@libs/runtime": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/database-url-policy": "workspace:*",
    "@pkgs/distributed-lock": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "pg": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
