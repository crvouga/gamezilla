{
  "name": "@libs/observability-server-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests",
    "configure:slo": "bun run scripts/slo-generate.ts",
    "generate:slo": "bun run scripts/slo-generate.ts"
  },
  "dependencies": {
    "@libs/product-identity-shared-ts": "workspace:*",
    "@pkgs/http-client-shared-ts": "workspace:*",
    "@pkgs/observability-root-shared-ts": "workspace:*",
    "@libs/observability-shared-ts": "workspace:*",
    "@pkgs/openslo-shared-ts": "workspace:*",
    "@pkgs/os-shared-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "@pkgs/gherkin-shared-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "fast-check": "catalog:"
  },
  "category": "server",
  "language": "typescript"
}
