{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "src": {
      "dependsOn": [
        "@libs/observability-shared-ts#src",
        "@libs/product-identity-shared-ts#src",
        "@pkgs/feedback-server-ts#src",
        "@pkgs/http-client-shared-ts#src",
        "@pkgs/observability-root-shared-ts#src",
        "@pkgs/openslo-shared-ts#src"
      ]
    },
    "configure:slo": {
      "cache": false,
      "dependsOn": ["@libs/tools-harness-ts#configure:identity"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/specs/**",
        "$TURBO_ROOT$/apps/product-ts/package.json",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/**",
        "$TURBO_ROOT$/docs/SLO_COVERAGE.md",
        "$TURBO_ROOT$/docs/SLO_RUNBOOK.md"
      ]
    },
    "generate:slo": {
      "dependsOn": ["@libs/tools-harness-ts#generate:identity"],
      "inputs": [
        "src/**",
        "scripts/slo-generate.ts",
        "$TURBO_ROOT$/specs/**/*.openslo.yaml",
        "$TURBO_ROOT$/libs/product-identity/product-identity.json",
        "$TURBO_ROOT$/pkgs/openslo-shared-ts/src/**",
        "package.json"
      ],
      "outputs": [
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/modules/observability-views/alert-rules.generated.json",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/modules/observability-views/grafana-slos.generated.json",
        "slo-alert-policies.openslo.yaml"
      ]
    }
  }
}
