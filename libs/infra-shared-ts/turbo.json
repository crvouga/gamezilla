{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "src": {
      "dependsOn": [
        "@libs/product-identity-shared-ts#src",
        "@pkgs/clock-shared-ts#src",
        "@pkgs/http-client-shared-ts#src"
      ],
      "inputs": [
        "$TURBO_EXTENDS$",
        "!tofu/modules/repository/required-checks/**"
      ]
    },
    "test": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/.github/workflows/**"
      ],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "retire:workers": {
      "cache": false,
      "dependsOn": [
        "@apps/admin-api-ts#health",
        "@apps/product-ts#health:release"
      ]
    },
    "generate:infra-map": {
      "inputs": [
        "src/**",
        "scripts/render-infra-map.ts",
        "tofu/**",
        "policy/**",
        "package.json"
      ],
      "outputs": [".cache/infra-map.html"],
      "dependsOn": ["@libs/tools-harness-ts#generate:identity"]
    }
  }
}
