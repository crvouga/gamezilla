{
  "uid": "business-engineering-${environment}",
  "title": "Engineering \u2014 ${environment}",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "observability",
    "business",
    "${environment}"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{job=\"${namespace}-server\",deployment_environment_name=\"${environment}\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP failure fraction (people's requests)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{job=\"${namespace}-server\",app_http_route_group=~\"sync|session|room|billing|media|app\",app_http_status_class=\"5xx\",deployment_environment_name=\"${environment}\"}[5m])) or vector(0)) / sum(rate(http_server_requests_total{job=\"${namespace}-server\",app_http_route_group=~\"sync|session|room|billing|media|app\",deployment_environment_name=\"${environment}\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "HTTP latency p95 (requests people wait on)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_uid}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_seconds_bucket{job=\"${namespace}-server\",app_http_route_group=~\"sync|session|room|billing|app\",deployment_environment_name=\"${environment}\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Correlated server errors",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs_uid}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"${namespace}-server\",deployment_environment_name=\"${environment}\"} | severity_text=\"ERROR\"",
          "datasource": {
            "type": "loki",
            "uid": "${logs_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
