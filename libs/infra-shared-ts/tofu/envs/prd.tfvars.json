{
  "env": "prd",
  "display_name": "Production",
  "suffix": "production",
  "worker": {
    "name": "{namespace}-prod",
    "puzzle_manager_account_ids": [],
    "transfer_rooms_from": "{namespace}-room-production",
    "retire": [
      "{namespace}-api-production",
      "{namespace}-client-production",
      "{namespace}-room-production"
    ]
  },
  "protection": "production",
  "cloudflare": {
    "account_id": "2698e76355a8c8d1ee21e15fa9fd44f7",
    "zone_name": "{domain}"
  },
  "hosts": {
    "apex": "{domain}",
    "web": "www.{domain}",
    "api": "api.{domain}",
    "broker": "emqx.{domain}"
  },
  "billing": {
    "provider": "stripe"
  },
  "secrets": {
    "regenerate": []
  },
  "imports": {
    "foundation": {
      "r2_bucket": "2698e76355a8c8d1ee21e15fa9fd44f7/{namespace}-production/default",
      "broker_dns": "d8dfc0697e9f709bb5fdd9fede051258/62894430f6090bf1f72d73e43ba991ef",
      "secrets": [
        "API_URL",
        "VITE_API_URL",
        "AUTH_SECRET",
        "EMQX_JWT_SECRET",
        "EMQX_WSS_URL",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "DATABASE_URL"
      ]
    },
    "edge": {
      "custom_domains": {
        "api": "2698e76355a8c8d1ee21e15fa9fd44f7/4eb0cbba061fdb3b07024d9fdda17d185434a9c3",
        "apex": "2698e76355a8c8d1ee21e15fa9fd44f7/06efbfbc37de8ae418aa7354ab6d5a7e5620062b",
        "web": "2698e76355a8c8d1ee21e15fa9fd44f7/ac39490026dbd658268bb9ee1ed346a81bff7833"
      }
    }
  },
  "population": {
    "replicas": 1,
    "capacity": 1,
    "vcpus": 1,
    "memory_gb": 2,
    "region": "us-west2"
  },
  "synthetic_monitoring": {
    "every_seconds": 60
  }
}
