{
  "env": "dev",
  "display_name": "Development",
  "suffix": "development",
  "worker": {
    "name": "{namespace}-dev",
    "puzzle_manager_account_ids": [],
    "transfer_rooms_from": "{namespace}-room-development",
    "room_namespace_resolution": {
      "source_id": "ab56d7be4eac481e81df42eac8c99aac",
      "target_id": "76e8864ea97c4d329171afb8778fb729"
    },
    "retire": [
      "{namespace}-api-development",
      "{namespace}-client-development",
      "{namespace}-room-development"
    ]
  },
  "protection": "standard",
  "cloudflare": {
    "account_id": "2698e76355a8c8d1ee21e15fa9fd44f7",
    "zone_name": "{domain}"
  },
  "hosts": {
    "apex": "dev.{domain}",
    "web": "www-dev.{domain}",
    "api": "api-dev.{domain}",
    "broker": "emqx-dev.{domain}"
  },
  "billing": {
    "provider": "stripe"
  },
  "secrets": {
    "regenerate": ["EMQX_JWT_SECRET"]
  },
  "population": {
    "replicas": 1,
    "capacity": 1,
    "vcpus": 1,
    "memory_gb": 2,
    "region": "us-west2"
  },
  "synthetic_monitoring": {
    "every_seconds": 3600
  }
}
