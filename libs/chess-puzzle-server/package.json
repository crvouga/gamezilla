{
  "name": "@libs/chess-puzzle-server",
  "version": "0.0.0",
  "private": true,
  "category": "server",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "export:puzzles-load": "bun run scripts/export-chess-puzzles-load.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests",
    "validate:puzzles": "bun run scripts/validate-chess-puzzles.ts"
  },
  "dependencies": {
    "@libs/chess-puzzle-shared": "workspace:*",
    "@libs/infra-shared": "workspace:*",
    "@pkgs/assert-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/database-url-policy-server": "workspace:*",
    "@pkgs/db-migrate-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
    "@pkgs/object-store-node-fs-server": "workspace:*",
    "@pkgs/object-store-shared": "workspace:*",
    "@pkgs/secret-store-shared": "workspace:*",
    "@pkgs/secrets-config-server": "workspace:*",
    "@pkgs/sql-client-postgres-server": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "chess.js": "catalog:",
    "csv-parse": "catalog:",
    "fzstd": "catalog:"
  },
  "devDependencies": {
    "@libs/chess-feature-shared": "workspace:*",
    "@pkgs/chess-rules-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
