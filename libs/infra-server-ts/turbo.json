{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "src": {
      "dependsOn": [
        "@libs/infra-shared-ts#src",
        "@libs/product-brand-shared-ts#src",
        "@libs/product-identity-shared-ts#src",
        "@pkgs/clock-shared-ts#src",
        "@pkgs/fs-server-ts#src",
        "@pkgs/object-store-node-fs-server-ts#src",
        "@pkgs/secret-provider-server-ts#src"
      ]
    },
    "apply:foundation": {
      "cache": false,
      "dependsOn": ["@libs/tools-harness-ts#install:cli"]
    },
    "apply:edge": {
      "cache": false,
      "dependsOn": ["@apps/product-ts#deploy", "@apps/admin-api-ts#deploy"]
    },
    "test": {
      "dependsOn": ["^src"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/apps/admin-api-ts/wrangler.toml",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/**",
        "$TURBO_ROOT$/libs/infra-shared-ts/policy/**",
        "$TURBO_ROOT$/.github/workflows/**"
      ],
      "env": ["HARNESS_FIDELITY", "PBT_NUM_RUNS", "PBT_RANDOM", "FC_SEED"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "plan:alerting": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "apply:alerting": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "drift:alerting": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "unlock:foundation": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "unlock:repository-policy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "plan:repository-policy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "apply:repository-policy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "drift:repository-policy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "verify:repository-policy": {
      "inputs": [
        "scripts/verify-repository-policy.ts",
        "src/tofu-layout.ts",
        "$TURBO_ROOT$/libs/infra-shared-ts/policy/**",
        "$TURBO_ROOT$/libs/infra-shared-ts/tofu/modules/repository/**",
        "$TURBO_ROOT$/mise.toml"
      ],
      "outputs": []
    },
    "apply:bootstrap": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "apply:fleet": {
      "dependsOn": ["@apps/auth-relay-ts#deploy", "@apps/storybook-ts#deploy"],
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
