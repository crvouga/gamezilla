{
  "name": "@libs/chess",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx"
    ]
  },
  "scripts": {
    "export:puzzles-load": "bun run scripts/export-chess-puzzles-load.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --preload @libs/sim-harness/preload --timeout 90000 --parallel tests/e2e",
    "validate:puzzles": "bun run scripts/validate-chess-puzzles.ts"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/billing": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/sim-harness": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assistant": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/chess-board": "workspace:*",
    "@pkgs/chess-board-core": "workspace:*",
    "@pkgs/chess-rules": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/collab": "workspace:*",
    "@pkgs/database-url-policy": "workspace:*",
    "@pkgs/db-migrate": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/device": "workspace:*",
    "@pkgs/glicko2": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/object-store-node-fs": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/room-sim": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@pkgs/sim": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-postgres": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/ui-testing": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "chess.js": "catalog:",
    "csv-parse": "catalog:",
    "fzstd": "catalog:",
    "pg": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libs/friends": "workspace:*",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
