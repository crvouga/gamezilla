{
  "name": "@libs/chess",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./e2e/*": [
      "./src/e2e/*.ts",
      "./src/e2e/**/*.ts"
    ]
  },
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0 --ignore-pattern 'src/e2e/**'",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/e2e/**'"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/infra": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assistant": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/chess-board": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/patch-db": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "chess.js": "catalog:",
    "csv-parse": "catalog:",
    "fzstd": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
