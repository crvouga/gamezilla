{
  "name": "@libs/chess",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ]
  },
  "scripts": {
    "export:puzzles-load": "bun run scripts/export-chess-puzzles-load.ts",
    "lint": "bunx biome check --error-on-warnings .",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test tests/puzzle-session && vitest run"
  },
