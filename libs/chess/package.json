{
  "name": "@libs/chess",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "refresh:puzzle-sync-pool": "bun run scripts/refresh-chess-puzzle-sync-pool.ts",
    "seed:puzzles": "bun run scripts/seed-chess-puzzles.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/db": "workspace:*",
    "@libs/infra": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/assistant": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/chess-board": "workspace:*",
    "@pkgs/collab": "workspace:*",
    "@pkgs/i18n": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/rules": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/sync-engine-powersync": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "chess.js": "catalog:",
    "csv-parse": "catalog:",
    "expo-audio": "catalog:",
    "fzstd": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
