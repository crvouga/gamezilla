{
  "name": "@libs/chess-matchmaking-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload --preload @libs/harness/preload tests"
  },
  "dependencies": {
    "@libs/app-root-server": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/chess-matchmaking-shared": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/profile-shared": "workspace:*",
    "@libs/spaces-harness": "workspace:*",
    "@libs/spaces-shared": "workspace:*",
    "@pkgs/chess-board-core-shared": "workspace:*",
    "@pkgs/keyword-shared": "workspace:*",
    "@pkgs/matchmaking-sql-shared": "workspace:*",
    "@pkgs/sql-client-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-server": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness"
}
