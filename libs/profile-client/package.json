{
  "name": "@libs/profile-client",
  "version": "0.0.0",
  "private": true,
  "category": "client",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@libs/app-client": "workspace:*",
    "@libs/auth-client": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/feature-client": "workspace:*",
    "@libs/profile-shared": "workspace:*",
    "@libs/test-ids-shared": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/clock-client": "workspace:*",
    "@pkgs/secure-storage-client": "workspace:*",
    "@pkgs/solid-context-client": "workspace:*",
    "@pkgs/sync-engine-client": "workspace:*",
    "@pkgs/ui-client": "workspace:*",
    "@pkgs/ui-shared": "workspace:*",
    "@pkgs/uuid-client": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/a11y-shared": "workspace:*",
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
