{
  "name": "@libs/notifications",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public": "./src/public/index.ts",
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@libs/feature": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
