    "@libs/moderation-shared-ts": "workspace:*",
    "@libs/profile-shared-ts": "workspace:*",
    "@libs/sub-client-ts": "workspace:*",
    "@libs/test-ids-shared-ts": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/clock-client-ts": "workspace:*",
    "@pkgs/i18n-shared-ts": "workspace:*",
    "@pkgs/secure-storage-root-client-ts": "workspace:*",
    "@pkgs/solid-context-client-ts": "workspace:*",
    "@pkgs/sync-engine-client-ts": "workspace:*",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "@pkgs/ui-root-shared-ts": "workspace:*",
    "@pkgs/uuid-client-ts": "workspace:*",
    "@pkgs/uuid-shared-ts": "workspace:*",
    "solid-js": "catalog:"
