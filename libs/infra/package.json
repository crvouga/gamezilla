{
  "name": "@libs/infra",
  "private": true,
  "exports": {
    "./namespace-bindings": "./src/namespace-bindings.ts",
    "./project-config": "./src/project-config.ts",
    "./shared/database-url-policy": "./src/shared/database-url-policy.ts",
    "./shared/database-url-policy-tooling": "./src/shared/database-url-policy-tooling.ts",
    "./cli/lib/cli-io": "./src/cli/lib/cli-io.ts",
    "./cli/secrets/secrets": "./src/cli/secrets/secrets.ts"
  },
  "scripts": {
    "infra": "SECRETS_ENV=prd bun run ../../tools/scripts/secrets-run.ts -- bun run libs/infra/src/bin/cli.ts",
    "pipeline-report": "bun run ./src/bin/pipeline-report.ts",
    "railway:gql:check": "gql.tada check --tsconfig ./tsconfig.tc.json",
    "railway:gql:generate": "gql.tada generate-output --tsconfig ./tsconfig.tc.json",
    "railway:gql:schema": "gql.tada generate-schema https://backboard.railway.com/graphql/v2 --output ./src/cli/lib/railway-graphql/schema.graphql",
    "tc": "gql.tada check --tsconfig ./tsconfig.tc.json && tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test src/shared/database-url-policy.test.ts src/cli/lib/build-llm-fix-prompt.test.ts src/cli/lib/eas-mobile.test.ts src/cli/lib/github-job-output-codec.test.ts src/cli/deps/pg-dump.test.ts src/cli/lib/railway-graphql/list-projects.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/async": "workspace:*",
    "@pkgs/billing-stripe": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/distributed-lock": "workspace:*",
    "@pkgs/git": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/secret-provider": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/secrets-config": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "gql.tada": "catalog:",
    "graphql": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
