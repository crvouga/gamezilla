{
  "name": "@gamezilla/infra",
  "private": true,
  "scripts": {
    "infra": "DOPPLER_PROJECT=gamezilla DOPPLER_CONFIG=prod bun run ./src/bin/cli.ts",
    "lint": "eslint src --max-warnings 0",
    "pipeline-report": "bun run ./src/bin/pipeline-report.ts",
    "tc": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "@gamezilla/api": "workspace:*",
    "@gamezilla/assert": "workspace:*",
    "@gamezilla/async": "workspace:*",
    "@gamezilla/git": "workspace:*",
    "@gamezilla/distributed-lock": "workspace:*",
    "@gamezilla/doppler": "workspace:*",
    "@gamezilla/keyword": "workspace:*",
    "@gamezilla/kv": "workspace:*",
    "@gamezilla/logger": "workspace:*",
    "@gamezilla/sql-client": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
