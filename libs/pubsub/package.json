{
  "name": "@libs/pubsub",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts"
    ],
    "./shared/*": [
      "./src/shared/*.ts"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test"
  },
  "dependencies": {
    "@libs/client-config": "workspace:*",
    "@libs/feature": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/pubsub-emqx": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
