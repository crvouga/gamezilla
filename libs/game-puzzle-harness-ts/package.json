{
  "name": "@libs/game-puzzle-harness-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "prepare:spec": "bun run --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client-ts/register ../../libs/harness-ts/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload tests",
    "test:spec": "bun run ../../libs/harness-ts/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 0/4",
    "test:spec:1": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 1/4",
    "test:spec:2": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 2/4",
    "test:spec:3": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 3/4",
    "verify:models": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts"
  },
  "dependencies": {
    "@libs/auth-client-ts": "workspace:*",
    "@libs/auth-shared-ts": "workspace:*",
    "@libs/billing-shared-ts": "workspace:*",
    "@libs/game-puzzle-client-ts": "workspace:*",
    "@libs/game-puzzle-shared-ts": "workspace:*",
    "@libs/permissions-client-ts": "workspace:*",
    "@libs/permissions-harness-ts": "workspace:*",
    "@libs/permissions-shared-ts": "workspace:*",
    "@libs/spaces-client-ts": "workspace:*",
    "@libs/test-ids-shared-ts": "workspace:*",
    "@pkgs/auth-root-shared-ts": "workspace:*",
    "@pkgs/clock-client-ts": "workspace:*",
    "@pkgs/db-schema-root-shared-ts": "workspace:*",
    "@pkgs/dmn-shared-ts": "workspace:*",
    "@pkgs/gherkin-shared-ts": "workspace:*",
    "@pkgs/harness-root-shared-ts": "workspace:*",
    "@pkgs/logger-client-ts": "workspace:*",
    "@pkgs/logger-shared-ts": "workspace:*",
    "@pkgs/permissions-shared-ts": "workspace:*",
    "@pkgs/quint-shared-ts": "workspace:*",
    "@pkgs/secure-storage-root-client-ts": "workspace:*",
    "@pkgs/secure-storage-root-shared-ts": "workspace:*",
    "@pkgs/sql-client-root-shared-ts": "workspace:*",
    "@pkgs/sql-root-shared-ts": "workspace:*",
    "@pkgs/sync-engine-client-ts": "workspace:*",
    "@pkgs/sync-engine-harness-ts": "workspace:*",
    "@pkgs/sync-engine-shared-ts": "workspace:*",
    "@pkgs/turn-game-shared-ts": "workspace:*",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "@pkgs/ui-testing-root-shared-ts": "workspace:*",
    "@pkgs/uuid-client-ts": "workspace:*",
    "@solidjs/router": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "language": "typescript",
  "specDomains": [
    "puzzles"
  ],
  "specParts": 4
}
