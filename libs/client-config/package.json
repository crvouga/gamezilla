{
  "name": "@libs/client-config",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client/*": [
      "./src/client/*.ts",
      "./src/client/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ]
  },
  "scripts": {
    "dev:refresh": "bun run scripts/dev-refresh-client-config.ts",
    "lint": "eslint src --max-warnings 0",
    "tc": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@pkgs/async": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@libs/auth": "workspace:*",
    "@pkgs/equal": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/patch-db": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
