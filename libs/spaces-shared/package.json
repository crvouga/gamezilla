    "@pkgs/message-shared": "workspace:*",
    "@pkgs/observability-root-shared": "workspace:*",
    "@pkgs/outbox-shared": "workspace:*",
    "@pkgs/pubsub-root-shared": "workspace:*",
    "@pkgs/room-root-shared": "workspace:*",
    "@pkgs/sql-client-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/turn-game-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "solid-js": "catalog:",
