{
  "name": "@libs/integration-test",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "install:browsers": "bun --bun x playwright install --with-deps chromium",
    "kill-preview-ports": "bun run scripts/kill-preview-ports.ts",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test:e2e": "bun test ./e2e/targets --timeout 240000",
    "test:e2e:headed": "HEADED=1 bun test ./e2e/targets --timeout 240000",
    "wait-for-api-health": "bun run scripts/wait-for-api-health.ts",
    "wait-for-browser-e2e-stack": "bun run scripts/wait-for-browser-e2e-stack.ts"
  },
  "dependencies": {
    "@libs/infra": "workspace:*",
    "@pkgs/assert": "workspace:*",
    "@pkgs/io": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/os": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/ui-testing": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
