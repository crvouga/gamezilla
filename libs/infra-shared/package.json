{
  "name": "@libs/infra-shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "generate:infra-map": "bun run scripts/render-infra-map.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "retire:workers": "bun run scripts/retire-workers.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/http-client-shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkgs/property-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "category": "isomorphic",
  "language": "typescript"
}
