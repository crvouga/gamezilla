{
  "name": "@libs/account-privacy",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./steps/*": "./tests/steps/*.ts"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/outbox": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@solidjs/router": "catalog:",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
