{
  "name": "@libs/runtime",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*.tsx"
    ],
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./server/*": [
      "./src/server/*.ts",
      "./src/server/*.tsx"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./steps/*": "./tests/steps/*.ts"
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "check:schema-evolution": "bun run scripts/check-schema-evolution.ts",
    "db:wipe:dev": "bun run scripts/wipe-dev-db.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "migrate": "bun run scripts/migrate-cli.ts --wait",
    "schema:snapshot": "bun run scripts/schema-snapshot.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --path-ignore-patterns='tests/harness/**'",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/15",
    "test:spec:1": "bun run ../../libs/harness/scripts/test-spec.ts --part 1/15",
    "test:spec:2": "bun run ../../libs/harness/scripts/test-spec.ts --part 2/15",
    "test:spec:3": "bun run ../../libs/harness/scripts/test-spec.ts --part 3/15",
    "test:spec:4": "bun run ../../libs/harness/scripts/test-spec.ts --part 4/15",
