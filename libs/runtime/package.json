    "test:spec:6": "bun run ../../libs/harness/scripts/test-spec.ts --part 6/15",
    "test:spec:7": "bun run ../../libs/harness/scripts/test-spec.ts --part 7/15",
    "test:spec:8": "bun run ../../libs/harness/scripts/test-spec.ts --part 8/15",
    "test:spec:9": "bun run ../../libs/harness/scripts/test-spec.ts --part 9/15",
    "test:spec:10": "bun run ../../libs/harness/scripts/test-spec.ts --part 10/15",
    "test:spec:11": "bun run ../../libs/harness/scripts/test-spec.ts --part 11/15",
    "test:spec:12": "bun run ../../libs/harness/scripts/test-spec.ts --part 12/15",
    "test:spec:13": "bun run ../../libs/harness/scripts/test-spec.ts --part 13/15",
    "test:spec:14": "bun run ../../libs/harness/scripts/test-spec.ts --part 14/15"
  },
