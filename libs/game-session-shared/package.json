{
  "name": "@libs/game-session-shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@libs/game-matchmaking-shared": "workspace:*",
    "@libs/game-puzzle-shared": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@libs/spaces-shared": "workspace:*",
    "@libs/sub-shared": "workspace:*",
    "@pkgs/attribute-shared": "workspace:*",
    "@pkgs/message-shared": "workspace:*",
    "@pkgs/room-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/turn-game-shared": "workspace:*",
    "@pkgs/ui-testing-root-shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "isomorphic",
  "gameApi": [
    "turn-game-definition"
  ]
}
