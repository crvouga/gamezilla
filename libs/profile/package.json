{
  "name": "@libs/profile",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./steps/*": "./tests/steps/*.ts"
  },
  "scripts": {
    "check:models": "bun run ../../libs/tools/scripts/check-models.ts",
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload --path-ignore-patterns='tests/harness/**'",
    "test:spec": "bun run ../../libs/harness/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness/scripts/test-spec.ts --part 0/2",
    "test:spec:1": "bun run ../../libs/harness/scripts/test-spec.ts --part 1/2"
  },
  "dependencies": {
    "@dicebear/collection": "catalog:",
    "@dicebear/core": "catalog:",
    "@libs/auth": "workspace:*",
    "@libs/client-app": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/dmn": "workspace:*",
    "@pkgs/permissions": "workspace:*",
    "@pkgs/secure-storage": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@pkgs/word-filter": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "unique-names-generator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libs/account-privacy": "workspace:*",
    "@libs/billing": "workspace:*",
    "@pkgs/a11y": "workspace:*",
    "@pkgs/alloy": "workspace:*",
    "@pkgs/auth-inhouse": "workspace:*",
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@pkgs/quint": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "specDomains": [
    "profile"
  ],
  "specParts": 2
}
