    "@pkgs/a11y-shared": "workspace:*",
    "@pkgs/chess-board-core-shared": "workspace:*",
    "@pkgs/chess-rules-shared": "workspace:*",
    "@pkgs/harness-root-shared": "workspace:*",
    "@pkgs/logger-shared": "workspace:*",
