{
  "name": "@libs/client-app",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shell/*": [
      "./src/shell/*.ts",
      "./src/shell/*.tsx",
      "./src/shell/*/index.ts"
    ],
    "./routes/*": [
      "./src/routes/*.ts",
      "./src/routes/*.tsx",
      "./src/routes/*/index.ts"
    ],
    "./chrome/*": [
      "./src/chrome/*.ts",
      "./src/chrome/*.tsx",
      "./src/chrome/*/index.ts"
    ],
    "./screens/*": [
      "./src/screens/*.ts",
      "./src/screens/*.tsx",
      "./src/screens/*/index.ts"
    ],
    "./config/*": [
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "./device/*": [
      "./src/device/*.ts",
      "./src/device/*.tsx",
      "./src/device/*/index.ts"
    ],
    "./i18n/*": [
      "./src/i18n/*.ts",
      "./src/i18n/*.tsx",
      "./src/i18n/*/index.ts"
    ],
    "./sync/*": [
      "./src/sync/*.ts",
      "./src/sync/*.tsx",
      "./src/sync/*/index.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/client-config": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/auth": "workspace:*",
    "@pkgs/auth-inhouse": "workspace:*",
    "@pkgs/browser": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/device": "workspace:*",
    "@pkgs/git": "workspace:*",
