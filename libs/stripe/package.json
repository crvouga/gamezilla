{
  "name": "@gamezilla/stripe",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "check": "bun run scripts/check-catalog.ts",
    "lint": "eslint . --max-warnings 0",
    "sync": "bun run scripts/sync.ts",
    "tc": "tsc --noEmit -p ./tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@gamezilla/attribute": "workspace:*",
    "@gamezilla/auth": "workspace:*",
    "@gamezilla/logger": "workspace:*",
    "@gamezilla/patch-db": "workspace:*",
    "@gamezilla/secret-store": "workspace:*",
    "@gamezilla/sql-client": "workspace:*",
    "@hono/zod-validator": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:"
  }
}
