{
  "name": "@libs/chess-shared-client-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "verify:board-contract": "bun run ../tools-harness-ts/scripts/verify-board-contract.ts"
  },
  "dependencies": {
    "@libs/chess-root-shared-ts": "workspace:*",
    "@libs/permissions-client-ts": "workspace:*",
    "@libs/permissions-shared-ts": "workspace:*",
    "@libs/spaces-client-ts": "workspace:*",
    "@lingui/solid": "catalog:",
    "@pkgs/ui-root-client-ts": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "client",
  "game": "chess",
  "language": "typescript"
}
