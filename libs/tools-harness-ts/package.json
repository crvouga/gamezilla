{
  "name": "@libs/tools-harness-ts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ci:agent-commands": "bun run scripts/sync-agent-commands.ts --check",
    "ci:audit": "bun run scripts/ci-audit.ts",
    "ci:conformance": "bun run scripts/verify-conformance.ts",
    "ci:goals": "bun run scripts/verify-goals.ts",
    "ci:i18n": "bun run scripts/ci-i18n.ts",
    "ci:package-names": "bun run scripts/verify-package-names.ts",
    "ci:spec-ownership": "bun run scripts/verify-spec-ownership.ts",
    "ci:specs": "bun run scripts/verify-specs.ts",
    "ci:statecharts": "bun run scripts/statechart-cli.ts verify",
    "ci:syncpack": "cd ../.. && syncpack lint --dependency-types prod,dev",
    "ci:workspace-lifecycle": "bun run scripts/sync-workspace-lifecycle.ts --check",
    "install:cli": "mise install",
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test scripts/*.test.ts",
    "verify:actionlint": "bun run scripts/verify-actionlint.ts",
    "verify:root-lint": "bun run scripts/lint-package.ts --root",
    "verify:secrets": "bun run scripts/verify-secrets.ts",
    "generate:ui-quality-sources": "bun run scripts/sync-ui-quality-sources.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@actions/artifact": "catalog:",
    "@crvouga/atlas": "catalog:",
    "@libs/harness-ts": "workspace:*",
    "@libs/secrets-server-ts": "workspace:*",
    "@libs/secrets-shared-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/conformance-server-ts": "workspace:*",
    "@pkgs/conformance-shared-ts": "workspace:*",
    "@pkgs/dmn-shared-ts": "workspace:*",
    "@pkgs/gherkin-shared-ts": "workspace:*",
    "@pkgs/observability-root-shared-ts": "workspace:*",
    "@pkgs/openslo-shared-ts": "workspace:*",
    "@pkgs/os-server-ts": "workspace:*",
    "@pkgs/os-shared-ts": "workspace:*",
    "@pkgs/property-shared-ts": "workspace:*",
    "@pkgs/quint-server-ts": "workspace:*",
    "@pkgs/quint-shared-ts": "workspace:*",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:",
    "@pkgs/object-store-node-fs-server-ts": "workspace:*",
    "@pkgs/object-store-root-shared-ts": "workspace:*"
  },
  "category": "harness",
  "language": "typescript"
}
