language js

// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: includes "always",
  $body <: contains bubble `always($id, $args)` as $call where {
    not $id <: r"^\"[^\"]+\"$",
    register_diagnostic(span=$id, message="Invariant id must be a string literal.", severity="error")
  }
}
