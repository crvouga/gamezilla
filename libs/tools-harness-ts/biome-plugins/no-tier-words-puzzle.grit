language js

// §22.11 inside the puzzle sub: not even bare tier words as identifiers.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: or {
    includes "tier",
    includes "plan",
    includes "free",
    includes "guest",
    includes "premium",
    includes "pro",
    includes "plus"
  },
  $body <: contains bubble or {
    JsIdentifierBinding() as $n,
    JsReferenceIdentifier() as $n,
    JsName() as $n,
    JsLiteralMemberName() as $n
  } where {
    $n <: or {
      "tier",
      "plan",
      "free",
      "guest",
      "premium",
      "pro",
      "plus"
    },
    register_diagnostic(span=$n, message="Tier word used as an identifier in the puzzle sub (§22.11). Name the thing by what it does; gate through usePermissions().", severity="error")
  }
}
