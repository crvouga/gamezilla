language js

// Infrastructure is declared in libs/infra-shared-ts/tofu and changed only by OpenTofu.
// A TypeScript call to a vendor's resource-admin API — creating buckets,
// DNS records, API tokens, Railway projects, Grafana stacks — is a second,
// imperative source of truth that can drift from (or destroy) what the
// OpenTofu state says exists. Read-only health probes use other endpoints.
// Perf: a whole-file substring test gates the tree walk.
file($body) where {
  $body <: or {
    includes "/r2/buckets",
    includes "/dns_records",
    includes "/tokens",
    includes "backboard.railway",
    includes "grafana.com/api"
  },
  $body <: contains bubble or {
    JsStringLiteralExpression() as $node,
    JsTemplateExpression() as $node
  } where {
    $node <: r"(?s).*(?:/r2/buckets|/dns_records|/accounts/[^/`'\x22]*/tokens|backboard\.railway\.(?:app|com)|grafana\.com/api).*",
    register_diagnostic(span=$node, message="Infrastructure is OpenTofu's (libs/infra-shared-ts/tofu): declare the resource there instead of calling a vendor admin API from TypeScript.", severity="error")
  }
}
