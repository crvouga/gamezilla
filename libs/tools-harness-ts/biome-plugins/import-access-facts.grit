language js

// Sign-in state is access input, and the permission system is its only
// reader: `@libs/auth-client-ts/access-facts` is imported by `libs/permissions`
// alone. Everything else asks `useCan` / `usePermissions` what the caller may
// do and never learns whether they are signed in.
// Matches every static import / export-from source, dynamic import() and
// require() specifier.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain this token, so files without it are skipped for ~free.
file($body) where {
  $body <: includes "access-facts",
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"]@libs/auth-client-ts/access-facts['\"]$",
    register_diagnostic(span=$src, message="Only @libs/permissions reads sign-in state. Gate with useCan / usePermissions / requireInMutation from the @libs/permissions-* packages instead.", severity="error")
  }
}
