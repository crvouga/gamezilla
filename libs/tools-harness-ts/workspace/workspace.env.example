# Optional shell exports; never copied or sourced automatically.
# Run `source libs/tools-harness-ts/workspace/workspace.env.example` to apply.
# Omit VITE_PORT to choose a free workspace-specific port.
# export VITE_PORT=5600
export TURBO_UI=stream
# The full local stack uses simulated Postgres, S3, MQTT, OAuth and billing.
# Do not set DATABASE_URL or production provider credentials for local startup.
# Verification credentials are provisioned explicitly; see DEVELOPMENT_ENVIRONMENTS.md.

# Storybook stays loopback-only unless LAN access is requested.
# export STORYBOOK_HOST=0.0.0.0
# export STORYBOOK_PORT=5602
# export STORYBOOK_ALLOWED_HOSTS=studio.local
# export STORYBOOK_ORIGIN=https://preview.example.test
