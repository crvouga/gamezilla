{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_EXTENDS$"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/libs/*/package.json",
        "$TURBO_ROOT$/pkgs/*/package.json",
        "$TURBO_ROOT$/apps/*/turbo.json",
        "$TURBO_ROOT$/libs/*/turbo.json",
        "$TURBO_ROOT$/pkgs/*/turbo.json",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/oxlint.config.mts",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/CI_REQUIREMENTS.md",
        "$TURBO_ROOT$/specs/**",
        "$TURBO_ROOT$/pkgs/equal-shared-ts/**",
        "$TURBO_ROOT$/pkgs/assert-root-shared-ts/**",
        "$TURBO_ROOT$/apps/product-ts/scripts/ui-quality/sources.json",
        "$TURBO_ROOT$/turbo-platform-key.json",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/tests/steps/**",
        "$TURBO_ROOT$/apps/*/tests/quint/**",
        "$TURBO_ROOT$/apps/*/tests/dmn/**",
        "$TURBO_ROOT$/apps/*/tests/alloy/**",
        "$TURBO_ROOT$/apps/*/tests/openslo/**",
        "$TURBO_ROOT$/libs/*/src/**",
        "$TURBO_ROOT$/libs/*/tests/steps/**",
        "$TURBO_ROOT$/libs/*/tests/quint/**",
        "$TURBO_ROOT$/libs/*/tests/dmn/**",
        "$TURBO_ROOT$/libs/*/tests/alloy/**",
        "$TURBO_ROOT$/libs/*/tests/openslo/**",
        "$TURBO_ROOT$/pkgs/*/src/**",
        "$TURBO_ROOT$/pkgs/*/tests/steps/**",
        "$TURBO_ROOT$/pkgs/*/tests/quint/**",
        "$TURBO_ROOT$/pkgs/*/tests/dmn/**",
        "$TURBO_ROOT$/pkgs/*/tests/alloy/**",
        "$TURBO_ROOT$/pkgs/*/tests/openslo/**"
      ]
    },
    "src": {
      "inputs": ["$TURBO_EXTENDS$", "!scripts/verify-task-costs.json"]
    },
    "tc": {
      "inputs": ["$TURBO_EXTENDS$", "!scripts/verify-task-costs.json"]
    }
  }
}
