{
  "name": "@libs/chess-puzzle-harness-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload --preload @libs/harness-ts/preload tests"
  },
  "dependencies": {
    "@libs/chess-puzzle-server-ts": "workspace:*",
    "@libs/chess-puzzle-shared-ts": "workspace:*",
    "@libs/chess-sub-shared-ts": "workspace:*",
    "@libs/game-puzzle-shared-ts": "workspace:*",
    "@libs/game-session-harness-ts": "workspace:*",
    "@libs/harness-ts": "workspace:*",
    "@libs/spaces-shared-ts": "workspace:*",
    "@libs/test-ids-shared-ts": "workspace:*",
    "@pkgs/a11y-shared-ts": "workspace:*",
    "@pkgs/chess-board-core-shared-ts": "workspace:*",
    "@pkgs/chess-rules-shared-ts": "workspace:*",
    "@pkgs/harness-root-shared-ts": "workspace:*",
    "@pkgs/logger-shared-ts": "workspace:*",
    "@pkgs/message-shared-ts": "workspace:*",
    "@pkgs/object-store-node-fs-server-ts": "workspace:*",
    "@pkgs/object-store-root-shared-ts": "workspace:*",
    "@pkgs/room-root-harness-ts": "workspace:*",
    "@pkgs/room-root-shared-ts": "workspace:*",
    "@pkgs/sounds-shared-ts": "workspace:*",
    "@pkgs/sql-client-root-shared-ts": "workspace:*",
    "@pkgs/sql-root-shared-ts": "workspace:*",
    "@pkgs/ui-testing-root-shared-ts": "workspace:*",
    "@pkgs/uuid-shared-ts": "workspace:*",
    "chess.js": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/clock-shared-ts": "workspace:*",
    "@pkgs/http-client-shared-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "game": "chess",
  "language": "typescript"
}
