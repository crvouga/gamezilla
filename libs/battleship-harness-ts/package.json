{
  "name": "@libs/battleship-harness-ts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools-harness-ts/scripts/lint-package.ts",
    "prepare:spec": "bun run --tsconfig-override=../../tsconfig.json --conditions=browser --conditions=development --preload=@pkgs/bun-test-solid-client-ts/register ../../libs/harness-ts/scripts/prepare-spec.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --tsconfig-override ../../tsconfig.json --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client-ts/preload --preload @libs/harness-ts/preload tests",
    "test:spec": "bun run ../../libs/harness-ts/scripts/test-spec.ts",
    "test:spec:0": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 0/10",
    "test:spec:1": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 1/10",
    "test:spec:2": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 2/10",
    "test:spec:3": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 3/10",
    "test:spec:4": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 4/10",
    "test:spec:5": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 5/10",
    "test:spec:6": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 6/10",
    "test:spec:7": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 7/10",
    "test:spec:8": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 8/10",
    "test:spec:9": "bun run ../../libs/harness-ts/scripts/test-spec.ts --part 9/10",
    "verify:models:0": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 0/2",
    "verify:models:1:0": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 0/8",
    "verify:models:1:1": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 1/8",
    "verify:models:1:2": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 2/8",
    "verify:models:1:3": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 3/8",
    "verify:models:1:4": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 4/8",
    "verify:models:1:5": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 5/8",
    "verify:models:1:6": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 6/8",
    "verify:models:1:7": "bun run ../../libs/tools-harness-ts/scripts/verify-models.ts --part 1/2 --phase 7/8"
  },
  "dependencies": {
    "@libs/battleship-client-ts": "workspace:*",
    "@libs/battleship-shared-ts": "workspace:*",
    "@libs/game-session-harness-ts": "workspace:*",
    "@libs/harness-ts": "workspace:*"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client-ts": "workspace:*",
    "@pkgs/quint-shared-ts": "workspace:*",
    "@pkgs/turn-game-shared-ts": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness",
  "game": "battleship",
  "language": "typescript",
  "modelParts": 2,
  "phaseParts": {
    "1": 8
  },
  "specDomains": [
    "battleship"
  ],
  "specParts": 10
