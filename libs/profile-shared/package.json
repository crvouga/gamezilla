{
  "name": "@libs/profile-shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@dicebear/collection": "catalog:",
    "@dicebear/core": "catalog:",
    "@libs/auth-shared": "workspace:*",
    "@libs/feature-shared": "workspace:*",
    "@libs/moderation-shared": "workspace:*",
    "@pkgs/attribute-shared": "workspace:*",
    "@pkgs/db-schema-root-shared": "workspace:*",
    "@pkgs/sql-client-root-shared": "workspace:*",
    "@pkgs/sql-root-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "unique-names-generator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/db-schema-sqlite-shared": "workspace:*",
    "@pkgs/property-shared": "workspace:*",
    "@pkgs/sql-client-sqlite-root-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "category": "isomorphic"
}
