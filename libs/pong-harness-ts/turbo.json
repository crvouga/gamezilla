{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "verify:models": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/specs/pong/*.qnt"]
    },
    "test:spec:0": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/specs/pong/**"]
    },
    "src": {
      "dependsOn": [
        "@libs/game-matchmaking-harness-ts#src",
        "@libs/game-session-harness-ts#src",
        "@libs/game-session-shared-ts#src",
        "@libs/harness-ts#src",
        "@libs/pong-client-ts#src",
        "@libs/pong-shared-ts#src",
        "@libs/spaces-harness-ts#src",
        "@pkgs/harness-root-shared-ts#src",
        "@pkgs/room-root-harness-ts#src",
        "@pkgs/room-root-shared-ts#src",
        "@pkgs/ui-testing-root-shared-ts#src"
      ]
    }
  }
}
