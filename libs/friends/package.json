{
  "name": "@libs/friends",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./harness/*": [
      "./src/harness/*.ts",
      "./src/harness/*.tsx"
    ],
    "./steps/*": "./tests/steps/*.ts"
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "bun run ../../libs/harness/scripts/test-e2e.ts"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/search": "workspace:*",
    "@libs/server-app": "workspace:*",
    "@libs/harness": "workspace:*",
    "@libs/spaces": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@libs/user-search": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/http-client": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/outbox": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libs/billing": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@pkgs/quint": "workspace:*",
    "@pkgs/harness": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  },
  "specDomains": [
    "friends",
    "spaces"
  ]
}
