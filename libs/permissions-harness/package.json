{
  "name": "@libs/permissions-harness",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid-client/preload tests"
  },
  "dependencies": {
    "@libs/auth-client": "workspace:*",
    "@libs/auth-shared": "workspace:*",
    "@libs/permissions-client": "workspace:*",
    "@libs/permissions-shared": "workspace:*",
    "@pkgs/auth-shared": "workspace:*",
    "@pkgs/clock-client": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/dmn-shared": "workspace:*",
    "@pkgs/secure-storage-client": "workspace:*",
    "@pkgs/secure-storage-shared": "workspace:*",
    "@pkgs/sql-shared": "workspace:*",
    "@pkgs/sync-engine-client": "workspace:*",
    "@pkgs/sync-engine-harness": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/uuid-client": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid-client": "workspace:*",
    "@pkgs/permissions-shared": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "category": "harness"
}
