{
  "name": "@libs/feature-shared",
  "version": "0.0.0",
  "private": true,
  "category": "isomorphic",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.d.ts"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@pkgs/assert-shared": "workspace:*",
    "@pkgs/clock-shared": "workspace:*",
    "@pkgs/db-schema-shared": "workspace:*",
    "@pkgs/message-shared": "workspace:*",
    "@pkgs/outbox-shared": "workspace:*",
    "@pkgs/pubsub-shared": "workspace:*",
    "@pkgs/room-shared": "workspace:*",
    "@pkgs/sql-client-shared": "workspace:*",
    "@pkgs/sync-engine-shared": "workspace:*",
    "@pkgs/uuid-shared": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
