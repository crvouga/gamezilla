{
  "name": "@libs/spaces",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ],
    "./sim/*": [
      "./src/sim/*.ts",
      "./src/sim/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bun run ../../libs/tools/scripts/lint-package.ts",
    "tc": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tc.tsbuildinfo -p ./tsconfig.tc.json",
    "test": "bun test --conditions=browser --conditions=development --preload @pkgs/bun-test-solid/preload"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/client-app": "workspace:*",
    "@libs/feature": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/sim-harness": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@libs/user-search": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/collab": "workspace:*",
    "@pkgs/collab-ui": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/pubsub": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/room-adapter-memory": "workspace:*",
    "@pkgs/room-adapter-web": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "@solidjs/router": "catalog:",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkgs/bun-test-solid": "workspace:*",
    "@pkgs/keyword": "workspace:*",
    "@pkgs/property": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
