{
  "name": "@libs/spaces",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./public/*": [
      "./src/public/*.ts",
      "./src/public/*.tsx"
    ],
    "./root/*": [
      "./src/root/*.ts",
      "./src/root/*.tsx"
    ]
  },
  "scripts": {
    "lint": "bunx biome check --error-on-warnings .",
    "tc": "tsc --noEmit -p ./tsconfig.tc.json",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns='**/*.test.tsx' && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@libs/auth": "workspace:*",
    "@libs/notifications": "workspace:*",
    "@libs/permissions": "workspace:*",
    "@libs/profile": "workspace:*",
    "@libs/test-ids": "workspace:*",
    "@libs/user-search": "workspace:*",
    "@lingui/core": "catalog:",
    "@lingui/solid": "catalog:",
    "@pkgs/assert": "workspace:*",
    "@pkgs/attribute": "workspace:*",
    "@pkgs/clock": "workspace:*",
    "@pkgs/collab": "workspace:*",
    "@pkgs/collab-ui": "workspace:*",
    "@pkgs/db-schema": "workspace:*",
    "@pkgs/db-schema-sqlite": "workspace:*",
    "@pkgs/i18n": "workspace:*",
    "@pkgs/kv": "workspace:*",
    "@pkgs/message": "workspace:*",
    "@pkgs/permissions": "workspace:*",
    "@pkgs/room": "workspace:*",
    "@pkgs/room-adapter-web": "workspace:*",
    "@pkgs/solid-context": "workspace:*",
    "@pkgs/sounds": "workspace:*",
    "@pkgs/sql": "workspace:*",
    "@pkgs/sql-client": "workspace:*",
    "@pkgs/sql-client-sqlite": "workspace:*",
    "@pkgs/sync-engine": "workspace:*",
    "@pkgs/ui": "workspace:*",
    "@pkgs/uuid": "workspace:*",
    "hono": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@pkgs/sim": "workspace:*",
    "@pkgs/vitest-solid": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
