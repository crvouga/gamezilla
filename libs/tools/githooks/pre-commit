#!/usr/bin/env bash
# Repo-wide lint + typecheck before a commit. Opt-in, because the repo's checks
# belong to the Check workflow (`.github/workflows/check.yml`, on every pull
# request; `bun check` is the same gate locally), and `--affected` spans every
# package whenever a global dependency (turbo.json, tsconfig.base.json) is in
# the working tree — a commit-blocking, multi-minute run with no CI signal
# gained. Turn it on per commit with `GIT_LINT_PRECOMMIT=1 git commit …`.
#
# `tools/githooks/pre-push` (the `main` guard) always runs — that one is not
# heavy and is what keeps direct pushes to `main` out of the repo.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Always on and cheap: a commit never mixes `features/**` (the spec writer's)
# with code (the implementer's). See specs/README.md (P1).
bun run libs/tools/scripts/check-spec-ownership.ts --staged

if [ "${GIT_LINT_PRECOMMIT:-}" != '1' ]; then
  exit 0
fi

echo "pre-commit: naming gate"
bun run libs/tools/scripts/check-naming.ts

echo "pre-commit: turbo run lint tc --affected"
bunx turbo run lint tc --affected
