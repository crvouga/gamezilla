language js

// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: or {
    includes "topicCheckpoints",
    includes "NudgePayload",
    includes "attachNudges",
    includes "declaredWrites",
    includes "affectedRows",
    includes "spaceListChannels",
    includes "spacePartyInvalidates",
    includes "_topic_applied",
    includes "_sync_topic_checkpoint"
  },
  $body <: contains bubble or {
    `topicCheckpoints` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: topicCheckpoints. See pkgs/sync-engine-server/README.md.", severity="error")
    },
    `NudgePayload` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: NudgePayload.", severity="error")
    },
    `attachNudges` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: attachNudges.", severity="error")
    },
    `declaredWrites` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: declaredWrites.", severity="error")
    },
    `affectedRows` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: affectedRows.", severity="error")
    },
    `spaceListChannels` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: spaceListChannels.", severity="error")
    },
    `spacePartyInvalidates` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: spacePartyInvalidates.", severity="error")
    },
    `_topic_applied` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: _topic_applied.", severity="error")
    },
    `_sync_topic_checkpoint` as $id where {
      register_diagnostic(span=$id, message="Retired sync terminology: _sync_topic_checkpoint.", severity="error")
    }
  }
}
