language js

// Shared game/domain logic may not import networking or wall Io construction (README.md).
// Matches every static import / export-from source, dynamic import() and
// require() specifier. Ported from dependency-cruiser, which had silently
// cruised 0 modules per package.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  not $body <: includes "@io-wall-ok",
  $body <: or {
    includes "@pkgs/http-client",
    includes "@pkgs/pubsub-shared",
    includes "/wall"
  },
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"](?:@pkgs/(?:http-client|pubsub|pubsub-emqx)-[a-z]+(?:/[^'\"]*)?|[^'\"]*/wall-io|[^'\"]*/wall)['\"]$",
    not $src <: r".*@pkgs/http-client-shared/types['\"]$",
    not $src <: r".*@pkgs/pubsub-shared/(?:interface|topic)['\"]$",
    register_diagnostic(span=$src, message="Shared game/domain logic must not import networking or wall Io construction. Inject Io ports from composition roots. See README.md.", severity="error")
  }
}
