language js

or {
  `from '@pkgs/pubsub-emqx'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/pubsub-emqx only from pkgs/pubsub-emqx or apps/*/src/sync composition roots.", severity="error")
  },
  `from "@pkgs/pubsub-emqx"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/pubsub-emqx only from pkgs/pubsub-emqx or apps/*/src/sync composition roots.", severity="error")
  },
  `from '@pkgs/pubsub-emqx/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/pubsub-emqx only from pkgs/pubsub-emqx or apps/*/src/sync composition roots.", severity="error")
  },
  `from "@pkgs/pubsub-emqx/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/pubsub-emqx only from pkgs/pubsub-emqx or apps/*/src/sync composition roots.", severity="error")
  }
}
