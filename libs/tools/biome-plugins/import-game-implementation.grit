language js

// Shared sessions and matchmaking receive rules and presentation via ports.
// Concrete game implementations and their catalog belong to composition roots.
file($body) where {
  $body <: or {
    includes "chess",
    includes "connect-four",
    includes "game-catalog"
  },
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"](?:@libs/(?:chess(?:-[a-z-]+)?|connect-four(?:-[a-z-]+)?|game-catalog(?:-[a-z-]+)?)|@pkgs/chess(?:-[a-z-]+)?|chess[.]js)(?:/[^'\"]*)?['\"]$",
    register_diagnostic(span=$src, message="Shared game components receive rules and presentation through ports. Concrete game adapters and catalogs belong to composition roots.", severity="error")
  }
}
