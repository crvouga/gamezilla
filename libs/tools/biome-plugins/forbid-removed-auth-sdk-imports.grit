language js

or {
  `from 'better-auth'` as $imp where {
    register_diagnostic(span=$imp, message="better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from "better-auth"` as $imp where {
    register_diagnostic(span=$imp, message="better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from 'better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from "better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from '@better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="@better-auth/* is removed; use @pkgs/auth.", severity="error")
  },
  `from "@better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="@better-auth/* is removed; use @pkgs/auth.", severity="error")
  },
  `from '@pkgs/auth-better-auth'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from "@pkgs/auth-better-auth"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from '@pkgs/auth-better-auth/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth is removed; use @pkgs/auth.", severity="error")
  },
  `from "@pkgs/auth-better-auth/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="@pkgs/auth-better-auth is removed; use @pkgs/auth.", severity="error")
  }
}
