language js

or {
  `from 'node:fs'` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store (injected ObjectStore) — node:fs only in wall FS adapters.", severity="error")
  },
  `from "node:fs"` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store (injected ObjectStore) — node:fs only in wall FS adapters.", severity="error")
  },
  `from 'node:fs/promises'` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — node:fs/promises only in wall FS adapters.", severity="error")
  },
  `from "node:fs/promises"` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — node:fs/promises only in wall FS adapters.", severity="error")
  },
  `from 'fs'` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — fs only in wall FS adapters.", severity="error")
  },
  `from "fs"` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — fs only in wall FS adapters.", severity="error")
  },
  `from 'fs/promises'` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — fs/promises only in wall FS adapters.", severity="error")
  },
  `from "fs/promises"` as $imp where {
    register_diagnostic(span=$imp, message="Use @pkgs/object-store — fs/promises only in wall FS adapters.", severity="error")
  },
  `Bun.file` as $id where {
    register_diagnostic(span=$id, message="Use @pkgs/object-store — Bun.file only at @io-wall-ok entry roots.", severity="error")
  },
  `Bun.write` as $id where {
    register_diagnostic(span=$id, message="Use @pkgs/object-store — Bun.write only at @io-wall-ok entry roots.", severity="error")
  },
  `Bun.Glob` as $id where {
    register_diagnostic(span=$id, message="Use @pkgs/object-store — Bun.Glob only at @io-wall-ok entry roots.", severity="error")
  },
  `new Glob($args)` as $call where {
    register_diagnostic(span=$call, message="Use @pkgs/object-store — new Glob only at @io-wall-ok entry roots.", severity="error")
  }
}
