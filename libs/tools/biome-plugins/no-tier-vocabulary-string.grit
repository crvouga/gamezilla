language js

// §22.11: `plan:*` role ids are policy data, never literals in sub code.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: includes "plan:",
  $body <: contains bubble JsStringLiteralExpression() as $s where {
    $s <: r"^['\"]plan:.*",
    register_diagnostic(span=$s, message="Plan role literal outside the policy package (§22.11). Roles are assigned by policy predicates, never named in code.", severity="error")
  }
}
