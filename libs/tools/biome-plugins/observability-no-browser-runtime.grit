language js

file($body) where {
  $body <: includes "@pkgs/observability-root-client/browser",
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"]@pkgs/observability-root-client/browser['\"]$",
    register_diagnostic(span=$src, message="The browser observability runtime is restricted to the browser composition root.", severity="error")
  }
}
