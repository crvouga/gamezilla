language js

// Only pkgs/harness/** may import @pkgs/harness/internals.
// Matches every static import / export-from source, dynamic import() and
// require() specifier. Ported from dependency-cruiser, which had silently
// cruised 0 modules per package.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: includes "@pkgs/harness/internals",
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"]@pkgs/harness/internals(?:/[^'\"]*)?['\"]$",
    register_diagnostic(span=$src, message="Only pkgs/harness/** may import @pkgs/harness/internals.", severity="error")
  }
}
