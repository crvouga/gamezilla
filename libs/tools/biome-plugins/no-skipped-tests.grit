language js

// goal:the-bar:4 — a green check means every test ran, and ran the same way
// on every machine. Wired to test files only (`biome.json` plugin
// `includes`), so it runs in each package's `lint`.
or {
  `$call($args)` where {
    $call <: or {
      `test.skip`,
      `it.skip`,
      `describe.skip`,
      `test.todo`,
      `it.todo`,
      `describe.todo`,
      `test.if`,
      `it.if`,
      `describe.if`,
      `$_.skipIf`,
      `$_.todoIf`
    },
    register_diagnostic(span=$call, message="Skipped tests are banned — a green check must mean every test ran. Delete the test, fix it, or fail loudly when its dependency is missing.", severity="error")
  },
  `$call($args)` where {
    $call <: or {
      `test.only`,
      `it.only`,
      `describe.only`
    },
    register_diagnostic(span=$call, message="Focused tests are banned — `.only` silently drops every sibling test, and bun rejects it only when CI is set, so a laptop and CI would disagree.", severity="error")
  },
  `$call($args)` where {
    $call <: or {
      `test.failing`,
      `it.failing`
    },
    register_diagnostic(span=$call, message="Expected-failure tests are banned — a known bug is fixed and guarded by a passing regression test (libs/tools/goal/known-bugs.json), never parked as `.failing`.", severity="error")
  },
  `process.exit(0)` as $exit where {
    register_diagnostic(span=$exit, message="A test file must not exit 0 — that reports a pass for tests that never ran. Throw instead.", severity="error")
  }
}
