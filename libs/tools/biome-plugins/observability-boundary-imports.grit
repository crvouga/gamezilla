language js

// Manual recording is deliberately confined to boundary files
// (README.md). The plugin include allowlist in
// biome.json names those files; every other production source file is checked.
file($body) where {
  $body <: includes "@pkgs/observability-",
  $body <: contains bubble or {
    JsModuleSource() as $src,
    JsImportCallExpression() as $call where { $call <: `import($src)` },
    JsCallExpression() as $call where { $call <: `require($src)` }
  } where {
    $src <: r"^['\"]@pkgs/observability-(?:client|server|shared)/[^'\"]+['\"]$",
    register_diagnostic(span=$src, message="Manual observability imports are confined to the ADR boundary-file inventory; instrument a shared boundary instead of feature code.", severity="error")
  }
}
