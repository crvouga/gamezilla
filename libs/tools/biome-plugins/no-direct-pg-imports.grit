language js

or {
  `from 'pg'` as $imp where {
    register_diagnostic(span=$imp, message="Do not import pg — only pkgs/sql-client/src/postgres/connect.ts and ping.ts may. Types: @pkgs/sql-client/postgres/pg-types.", severity="error")
  },
  `from "pg"` as $imp where {
    register_diagnostic(span=$imp, message="Do not import pg — only pkgs/sql-client/src/postgres/connect.ts and ping.ts may. Types: @pkgs/sql-client/postgres/pg-types.", severity="error")
  },
  `import 'pg'` as $imp where {
    register_diagnostic(span=$imp, message="Do not import pg — only pkgs/sql-client/src/postgres/connect.ts and ping.ts may.", severity="error")
  },
  `import "pg"` as $imp where {
    register_diagnostic(span=$imp, message="Do not import pg — only pkgs/sql-client/src/postgres/connect.ts and ping.ts may.", severity="error")
  },
  `require('pg')` as $imp where {
    register_diagnostic(span=$imp, message="Do not require pg — only wall TCP openers may.", severity="error")
  },
  `require("pg")` as $imp where {
    register_diagnostic(span=$imp, message="Do not require pg — only wall TCP openers may.", severity="error")
  },
  `import('pg')` as $imp where {
    register_diagnostic(span=$imp, message="Do not dynamic-import pg — only wall TCP openers may.", severity="error")
  },
  `import("pg")` as $imp where {
    register_diagnostic(span=$imp, message="Do not dynamic-import pg — only wall TCP openers may.", severity="error")
  }
}
