language js

// Perf: a whole-file substring test gates the tree walk (every match contains
// one of these tokens), and each snippet is tried only against its own node
// kind instead of against every node in the file.
file($body) where {
  $body <: or {
    includes "Date",
    includes "performance",
    includes "setTimeout",
    includes "setInterval",
    includes "clearTimeout",
    includes "clearInterval",
    includes "fetch",
    includes "random",
    includes "getRandomValues"
  },
  $body <: contains bubble or {
    JsCallExpression() as $node where {
      $node <: or {
        `Date.now()` where {
          register_diagnostic(span=$node, message="Inject Clock — do not call Date.now outside @io-wall-ok entry roots.", severity="error")
        },
        `performance.now()` where {
          register_diagnostic(span=$node, message="Inject Clock — do not call performance.now outside @io-wall-ok entry roots.", severity="error")
        },
        `setTimeout($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call setTimeout outside @io-wall-ok entry roots.", severity="error")
        },
        `setInterval($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call setInterval outside @io-wall-ok entry roots.", severity="error")
        },
        `clearTimeout($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call clearTimeout outside @io-wall-ok entry roots.", severity="error")
        },
        `clearInterval($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call clearInterval outside @io-wall-ok entry roots.", severity="error")
        },
        `globalThis.setTimeout($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call globalThis.setTimeout outside @io-wall-ok entry roots.", severity="error")
        },
        `globalThis.setInterval($args)` where {
          register_diagnostic(span=$node, message="Inject Timers — do not call globalThis.setInterval outside @io-wall-ok entry roots.", severity="error")
        },
        `fetch($args)` where {
          register_diagnostic(span=$node, message="Inject HTTP client — do not call bare fetch outside @io-wall-ok entry roots.", severity="error")
        },
        `crypto.randomUUID()` where {
          register_diagnostic(span=$node, message="Inject createId — do not call crypto.randomUUID outside @io-wall-ok entry roots.", severity="error")
        },
        `Math.random()` where {
          register_diagnostic(span=$node, message="Inject random — do not call Math.random outside @io-wall-ok entry roots.", severity="error")
        },
        `crypto.getRandomValues($args)` where {
          register_diagnostic(span=$node, message="Inject random — do not call crypto.getRandomValues outside @io-wall-ok entry roots.", severity="error")
        },
        `randomUUID($args)` where {
          register_diagnostic(span=$node, message="Inject createId — do not call randomUUID outside @io-wall-ok entry roots.", severity="error")
        },
        `randomBytes($args)` where {
          register_diagnostic(span=$node, message="Inject random — do not call randomBytes outside @io-wall-ok entry roots.", severity="error")
        }
      }
    },
    or {
      JsStaticMemberExpression(),
      TsQualifiedName()
    } as $node where {
      $node <: or {
        `Date.now` where {
          register_diagnostic(span=$node, message="Inject Clock — do not use Date.now outside @io-wall-ok entry roots.", severity="error")
        },
        `performance.now` where {
          register_diagnostic(span=$node, message="Inject Clock — do not use performance.now outside @io-wall-ok entry roots.", severity="error")
        },
        `globalThis.fetch` where {
          register_diagnostic(span=$node, message="Inject HTTP client — do not use globalThis.fetch outside @io-wall-ok entry roots.", severity="error")
        },
        `crypto.randomUUID` where {
          register_diagnostic(span=$node, message="Inject createId — do not use crypto.randomUUID outside @io-wall-ok entry roots.", severity="error")
        },
        `Math.random` where {
          register_diagnostic(span=$node, message="Inject random — do not use Math.random outside @io-wall-ok entry roots.", severity="error")
        }
      }
    },
    JsNewExpression() as $node where {
      $node <: or {
        `new Date()` where {
          register_diagnostic(span=$node, message="Inject Clock — do not use new Date() outside @io-wall-ok entry roots.", severity="error")
        }
      }
    }
  }
}
