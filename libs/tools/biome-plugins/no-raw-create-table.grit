language js

// Ban authored CREATE TABLE string/template literals.
// Only matches leaf string/template nodes (quote-delimited source text).
$node where {
  or {
    $node <: r"(?s)^\".*CREATE TABLE.*\"$",
    $node <: r"(?s)^'.*CREATE TABLE.*'$",
    $node <: r"(?s)^`.*CREATE TABLE.*`$"
  },
  register_diagnostic(span=$node, message="Do not author CREATE TABLE by hand — use defineTable + applySqliteSchema/applyPostgresSchema (or SchemaDatabaseMigration). Only @pkgs/db-schema-postgres / @pkgs/db-schema-sqlite emit.ts may emit CREATE TABLE.", severity="error")
}
