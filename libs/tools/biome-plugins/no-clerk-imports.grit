language js

or {
  `from '@clerk/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @clerk/* imports.", severity="error")
  },
  `from "@clerk/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @clerk/* imports.", severity="error")
  },
  `from '@pkgs/auth-clerk'` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @pkgs/auth-clerk.", severity="error")
  },
  `from "@pkgs/auth-clerk"` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @pkgs/auth-clerk.", severity="error")
  },
  `from '@pkgs/auth-clerk/$rest'` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @pkgs/auth-clerk.", severity="error")
  },
  `from "@pkgs/auth-clerk/$rest"` as $imp where {
    register_diagnostic(span=$imp, message="Clerk is purged — remove @pkgs/auth-clerk.", severity="error")
  }
}
