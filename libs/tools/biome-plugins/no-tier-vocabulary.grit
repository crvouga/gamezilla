language js

// §22.11: product tiers exist only as policy data. Outside the policy package
// (`libs/permissions`, `pkgs/permissions`) and billing, no identifier may name a
// tier / plan verification and no string literal may name a `plan:` role.
// Perf: a whole-file substring test gates the tree walk. Every match must
// contain one of these tokens, so files without them are skipped for ~free.
file($body) where {
  $body <: or {
    includes "isPremium",
    includes "isPro",
    includes "isPaid",
    includes "isGuest",
    includes "isFree",
    includes "isPlus",
    includes "subscriptionLevel",
    includes "entitled",
    includes "premium",
    includes "PlanRole",
    includes "planGuest",
    includes "planFree",
    includes "planPaid"
  },
  $body <: contains bubble or {
    JsIdentifierBinding() as $n,
    JsReferenceIdentifier() as $n,
    JsName() as $n,
    JsLiteralMemberName() as $n
  } where {
    $n <: or {
      "isPremium",
      "isPro",
      "isPaid",
      "isGuest",
      "isFree",
      "isPlus",
      "subscriptionLevel",
      "entitled",
      "premium",
      "usePlanRole",
      "PlanRole",
      "planGuest",
      "planFree",
      "planPaid",
      "resolvePlanRole"
    },
    register_diagnostic(span=$n, message="Tier vocabulary outside the policy package (§22.11). Gate with usePermissions().can/consume and a catalogued ACTION; tiers live only in policy config.", severity="error")
  }
}
