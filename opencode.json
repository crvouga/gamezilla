{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "mise",
        "exec",
        "--",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "enabled": true
    },
    "storybook": {
      "type": "remote",
      "url": "http://127.0.0.1:6006/mcp",
      "enabled": true
    }
  }
}
