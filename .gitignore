# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
**/dist/
web-build/

# Native
.kotlin/
# Xcode and SwiftPM per-user state (docs/POLYGLOT.md); build output lives in
# each package's `.cache/`.
xcuserdata/
IDEWorkspaceChecks.plist
.swiftpm/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.cache
data

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files: never commit one (secrets come from Infisical)
.env
.env.*
!.env.example

# Turbo
.turbo/
/out


# Jest transform cache (pinned under package `.cache/jest`, not OS /tmp)
**/.jest-cache/
product/test/.cache/
pkgs/ui-testing/.cache/
pkgs/simulation/.cache/

# Package dependency graph HTML (bun run deps:graph)
tmp/package-deps-graph.html

# Lichess puzzle CSV cache (seed:puzzles)
libs/chess/.cache/
# Legacy Lichess cache location (kept ignored so old checkouts that still
# have files under apps/api/.cache don't dirty the tree).
apps/api/.cache/
apps/emqx/.cache/
apps/emqx/data/
apps/postgres/data/

# Legacy local PostgreSQL cluster paths (kept ignored so old checkouts don't dirty the tree)
pkgs/postgres/.postgres/

# typescript
*.tsbuildinfo


app-example

# generated native folders
/ios
/android
apps/client-ts/ios/
apps/client-ts/android/

.cursor/debug*.log

# Local deploy / script logs
*.log

# DuckDB inspect UI local database
.local/

# Local preview-stack log from verify:api
.verify-*

# Local observability span export (opt-in dev debugging)
.observability/

# infra cost report
.cost-report.md

/.turbo/
/turbo/
.wrangler/

# actionlint binary (downloaded by CI / local check)
/actionlint
# Turborepo
.turbo
# Platform cache key written by libs/tools-harness-ts/scripts/turbo-ci-run.ts (Turbo's hash has
# no OS notion; the scoped test:contract leaves hash this file).
turbo-platform-key.json
turbo-host-key.json


# Verify artifacts (reports, traces, videos)
/check/
**/atlas-runs/
**/test-results/
**/blob-report/
/.data/
**/.data/

# OpenTofu: the bootstrap stack's first-run local backend (libs/infra-server-ts/scripts/bootstrap-backend.ts)
libs/infra-shared-ts/tofu/stacks/*/*_override.tf
# Provider binaries from a local `tofu init`. Lock files stay committed;
# lint keeps its own cache under libs/infra/.cache/tofu.
**/.terraform/

# Per-package Biome scan scope (libs/tools-harness-ts/scripts/biome-scope.ts)
/.biome-scope.*.json
# Per-package tsgolint project (libs/tools-harness-ts/scripts/lint-package.ts)
/apps/*/jsconfig.json
/libs/*/jsconfig.json
/pkgs/*/jsconfig.json

# Per-machine orchestrator overrides (committed hooks live in libs/tools-harness-ts/workspace)
/.superset/config.local.json

# Repository-local feedback reports
/.feedback/

# `/overnight` run records (baseline, findings, evidence, report)
/.overnight/

# Worktrees made by worktree-isolated subagents
/.claude/worktrees/
# Per-person agent settings (permissions, local paths)
/.claude/settings.local.json

# Existing reports retained after the feedback rename.
.bugs/

# Generated by `bun run generate` (root postinstall), never committed, so
# concurrent worktrees cannot conflict on them.
STEPS_CATALOG.md
pkgs/ui-root-client-ts/src/tokens.css
pkgs/ui-root-client-ts/src/tokens.json
pkgs/ui-root-shared-ts/src/token-names.ts
pkgs/sounds-shared-ts/src/sound-id.ts
pkgs/sounds-shared-ts/src/sound-urls.ts
pkgs/sounds-shared-ts/src/sound-volumes.ts
libs/app-root-shared-ts/locales/*/messages.ts
apps/product-ts/scripts/ui-quality/sources.json

# Graphify: the knowledge graph, and the project skill the pinned release
# writes (`bun run graphify:install`)
graphify-out/
/.agents/skills/graphify/
/.claude/skills/graphify

# Serena: per-machine state; `.serena/project.yml` is the committed project
.serena/cache/
.serena/logs/
.serena/memories/
.serena/project.local.yml
