# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
**/dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Turbo
.turbo/
/out

# Lichess puzzle CSV cache (seed:puzzles)
packages/chess/.cache/
# Legacy Lichess cache location (predates @gamezilla/chess colocation).
# Kept ignored so old checkouts (and the pre-colocation `packages/api` cache
# dir, which can hold a >100 MB CSV that GitHub will reject) don't dirty
# the tree or sneak back into a commit.
packages/api/.cache/

# Local PostgreSQL cluster + lifecycle artifacts (packages/pg)
packages/pg/.postgres/
# Legacy PGlite data dir (kept ignored so old checkouts don't dirty the tree)
packages/pg/.pglite/

# typescript
*.tsbuildinfo

# PatchDB app build output (opt-in)
.sim-recordings/

app-example

# generated native folders
/ios
/android

.cursor/debug*.log

# infra cost report
.cost-report.md

/.turbo/
/turbo/
.wrangler/

# actionlint binary (downloaded by CI / local check)
/actionlint