# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
**/dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.cache
data

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Turbo
.turbo/
/out


# Jest transform cache (pinned under package `.cache/jest`, not OS /tmp)
**/.jest-cache/
product/test/.cache/
pkgs/ui-testing/.cache/
pkgs/simulation/.cache/

# Package dependency graph HTML (bun run deps:graph)
tmp/package-deps-graph.html

# Lichess puzzle CSV cache (seed:puzzles)
libs/chess/.cache/
# Legacy Lichess cache location (kept ignored so old checkouts that still
# have files under apps/api/.cache don't dirty the tree).
apps/api/.cache/
apps/emqx/.cache/
apps/emqx/data/
apps/postgres/data/

# Legacy local PostgreSQL cluster paths (kept ignored so old checkouts don't dirty the tree)
pkgs/postgres/.postgres/

# typescript
*.tsbuildinfo


app-example

# generated native folders
/ios
/android
apps/client/ios/
apps/client/android/

.cursor/debug*.log

# Local deploy / script logs
*.log

# DuckDB inspect UI local database
.local/

# Local preview-stack log from check:api
.check-*

# Local observability span export (opt-in dev debugging)
.observability/

# infra cost report
.cost-report.md

/.turbo/
/turbo/
.wrangler/

# actionlint binary (downloaded by CI / local check)
/actionlint
# Turborepo
.turbo
# Platform cache key written by libs/tools/scripts/turbo-ci-run.ts (Turbo's hash has
# no OS notion; the scoped test:contract leaves hash this file).
turbo-platform-key.json


# Check artifacts (reports, traces, videos)
/check/
**/test-results/
**/blob-report/
# Aggregated spec report over every package (bun run test:report)
/harness-report/

/.data/
**/.data/

# OpenTofu: the bootstrap stack's first-run local backend (libs/infra/scripts/bootstrap-backend.ts)
libs/infra/tofu/stacks/*/*_override.tf

# Per-package Biome scan scope (libs/tools/scripts/biome-scope.ts)
/.biome-scope.*.json
# Per-package tsgolint project (libs/tools/scripts/lint-package.ts)
/apps/*/jsconfig.json
/libs/*/jsconfig.json
/pkgs/*/jsconfig.json

# Per-machine orchestrator overrides (committed hooks live in libs/tools/workspace)
/.superset/config.local.json
