{
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "-C",
        "${workspaceFolder}",
        "exec",
        "--",
        "serena",
        "start-mcp-server",
        "--context",
        "vscode",
        "--project",
        "${workspaceFolder}",
        "--open-web-dashboard",
        "false"
      ]
    },
    "storybook": {
      "type": "http",
      "url": "http://127.0.0.1:6006/mcp"
    }
  }
}
