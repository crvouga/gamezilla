{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "cSpell.words": [
    "apprunner",
    "bunx",
    "certificatemanager",
    "Consolas",
    "credentialless",
    "Emscripten",
    "esac",
    "fontobject",
    "Fraunces",
    "gamezilla",
    "gamezillaapp",
    "Gsap",
    "healthcheck",
    "impls",
    "Lichess",
    "mobileprovision",
    "Neue",
    "paperplane",
    "patchdb",
    "pglite",
    "pipefail",
    "playhead",
    "Pressable",
    "RAILPACK",
    "Replayable",
    "SAVEPOINT",
    "schemaname",
    "Segoe",
    "sokoban",
    "Squarespace",
    "sslmode",
    "tablename",
    "TIMESTAMPTZ",
    "topo",
    "Tweens",
    "uncatchable",
    "unsub",
    "unsubs",
    "Unsync",
    "Unvalidated",
    "WHATWG",
    "worklets",
    "xyflow"
  ]
}
