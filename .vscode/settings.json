{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "cSpell.words": [
    "apprunner",
    "bunx",
    "certificatemanager",
    "Consolas",
    "credentialless",
    "elasticloadbalancingv",
    "elbv",
    "emqx",
    "Emscripten",
    "esac",
    "fontobject",
    "Fraunces",
    "postgres",
    "gamezilla",
    "gamezillaapp",
    "Gsap",
    "healthcheck",
    "impls",
    "Lichess",
    "localpass",
    "mobileprovision",
    "MQTT",
    "Neue",
    "paperplane",
    "patchdb",
    "pgdata",
    "pglite",
    "pipefail",
    "playhead",
    "Postchecks",
    "Prechecks",
    "Prereqs",
    "Pressable",
    "RAILPACK",
    "Replayable",
    "SAVEPOINT",
    "schemaname",
    "Segoe",
    "sokoban",
    "Squarespace",
    "sslmode",
    "tablename",
    "TIMESTAMPTZ",
    "topo",
    "Turborepo",
    "Tweens",
    "uncatchable",
    "unsub",
    "unsubs",
    "Unsync",
    "Unvalidated",
    "WHATWG",
    "worklets",
    "xyflow"
  ],
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/deployment-pipeline.yml"
  ]
}
